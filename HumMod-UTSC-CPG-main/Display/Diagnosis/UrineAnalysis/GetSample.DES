<groupbox>
   <row> 2.0 </row>
   <col> 1.0 </col>
   <high> 12.5 </high>
   <wide> 35.0 </wide>
   <title> Washroom </title>

<structurename> UrineAnalysis </structurename>

<actionbutton>
   <row> 1.4 </row><col> 1.0 </col>
   <blockname> GetSpecimen </blockname>
   <label> Collect Specimen Now </label>
</actionbutton>

<showvalue>
   <row> 3.0 </row><col> 1.0 </col>
   <name> Timestamp </name>
   <format>
     <timestamp/>
     <fieldwidth> 16 </fieldwidth>
   </format>
   <label> Timestamp </label>
</showvalue>

<structurename> hCG </structurename>

 <actionbutton>
   <row> 5.4 </row><col> 1.0 </col>
   <blockname> TakeTest </blockname>
   <label> Take Pregnancy Test Now </label>
  </actionbutton>

<showvalue>
   <row> 7.0 </row><col> 1.0 </col>
   <name> Timestamp </name>
   <format>
     <timestamp/>
     <fieldwidth> 16 </fieldwidth>
   </format>
   <label> Timestamp </label>
</showvalue>
 
 <label>
    <row> 9.0 </row><col> 1.0 </col>
    <text> Pregnancy Test Result </text>
    <color> DARKBLUE </color>
  </label>
  
  <maplist><name> Result </name>
    <map><val> 1 </val><img> Positive(+) </img></map>
    <map><val> 2 </val><img> Inconclusive </img></map>
    <map><val> 3 </val><img> Negative(-) </img></map>
  </maplist>
  
  <showvalue>
     <row> 10.0 </row><col> 2.0 </col>
     <name> TestOutcome </name>
     <format><list> Result </list></format>
     <label> Test Result </label>
  </showvalue>

<infobutton>
    <row> 5.4 </row>
    <col> 30 </col>

  <line> Pregnancy Test Values of [hCG] </line>
  <line>  </line>
  <line> Positive: ≥ 25 mIU/mL </line>
  <line> Positive: 20-25 mIU/mL </line>
  <line> Negative: less than 20 mIU/mL </line>
</infobutton>

</groupbox>

End