<showgraph>
  <row> 22.5 </row><col> 35 </col>
  <high> 6 </high><wide> 50 </wide>
  <leftmargin> 20 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time (Min) </label>
    <scale><min> 0 </min><max> 480 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> Rectum.RectalVolume </name>
      <label> Rectal Volume (mL) </label>
      <linecolor> MAGENTA </linecolor>
    </yvar>
    <scale><min> 0 </min><max> 300 </max></scale>
  </yaxis>
</showgraph>

<!-- Defecation Reflex button -->

<groupbox>
  <row> 20.5 </row><col> 1.0 </col>
  <high> 9.0 </high><wide> 35.0 </wide> <title> Rectum </title>

  <showvalue>
    <row> 1.5 </row><col> 1.0 </col>
    <name> Rectum.RectalVolume </name>
    <format><decimal> 1 </decimal></format>
    <label> Volume (mL) </label>
  </showvalue>

  <showvalue>
    <row> 2.5 </row><col> 1.0 </col>
    <name> Rectum.RectalPressure </name>
    <format><decimal> 1 </decimal></format>
    <label> Pressure (mmHg) </label>
  </showvalue>

  <radiobuttons>
  <row> 4 </row><col> 1.0 </col>
  <name> Rectum.AutoDefecationSwitch </name>
  <listname> Common.Switch </listname>
  <label> Defecation by Volume </label>
</radiobuttons>

  <repeatlist>
    <name> DefecationVolumeList </name>
    <firstval> 50 </firstval>
    <repeat><reps> 20 </reps><stepsize> 10 </stepsize></repeat>
  </repeatlist>

  <slidebar>
    <row> 5.5 </row><col> 1.0 </col>
    <name> Rectum.AutoDefecationVolume </name>
    <listname> DefecationVolumeList </listname>
    <label> Trigger Volume (mL) </label>
  </slidebar>

   <showvalue>
    <row> 7.0 </row><col> 1.0 </col>
    <name> Rectum.TotalFecalVolume </name>
    <format><decimal> 1 </decimal></format>
    <label> Total Fecal Volume </label>
  </showvalue>

</groupbox>