<groupbox>
   <row> 2.0 </row>
   <col> 32.0 </col>
   <high> 9.0 </high>
   <wide> 30.0 </wide>
   <title> Water </title>

<structurename> DietIntakeH2O </structurename>

<maplist>
  <name> Fixed? </name>
  <map><val> 0 </val><img> Intake Controlled By Thirst </img></map>
  <map><val> 1 </val><img> Fixed Intake </img></map>
</maplist>

<radiobuttons>
  <row> 2 </row><col> 1.0 </col>
  <name> Fixed? </name>
  <listname> Fixed? </listname>
  <nolabel/>
  <layout> VERT </layout>
</radiobuttons>

<structurename> DietGoalH2O </structurename>

<repeatlist>
  <name> Rate(L/Day) </name>
  <repeat><reps> 100 </reps><stepsize>  0.1 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 4.5 </row><col> 1.0 </col>
  <name> Rate(L/Day) </name>
  <listname> Rate(L/Day) </listname>
  <label> L/day </label>
</slidebar>

<repeatlist>
  <name> DegC </name>
  <firstval> 0 </firstval>
  <repeat><reps> 100 </reps><stepsize> 1 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 7.0 </row><col> 1.0 </col>
  <name> DegC </name>
  <listname> DegC </listname>
  <label> Temp (C) </label>
</slidebar>

</groupbox>

End
