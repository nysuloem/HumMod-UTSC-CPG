<groupbox>
   <row> 2.0 </row>
   <col> 1.0 </col>
   <high> 9.0 </high>
   <wide> 30.0 </wide>
   <title> Nutrients</title>

<structurename> DietIntakeNutrition </structurename>

<maplist>
  <name> Fixed? </name>
  <map><val> 0 </val><img> Intake Controlled By Appetite </img></map>
  <map><val> 1 </val><img> Intake Controlled By Goal </img></map>
  <map><val> 2 </val><img> Fasting </img></map>
</maplist>

<radiobuttons>
  <row> 2.0 </row><col> 1.0 </col>
  <name> Fixed? </name>
  <listname> Fixed? </listname>
  <nolabel/>
  <layout> VERT </layout>
</radiobuttons>

<structurename> DietGoalNutrition </structurename>

<repeatlist>
  <name> DegC </name>
  <firstval> 0 </firstval>
  <repeat><reps> 100 </reps><stepsize> 1.0 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 7.0 </row><col> 1.0 </col>
  <name> DegC </name>
  <listname> DegC </listname>
  <label> Temp (C) </label>
</slidebar>

</groupbox>


