HumMod / PostureEnergy

Created : 2012-02-02
Revised : 2012-02-02
Author : Tom Coleman
Copyright : 2012-2012
By : University of Mississippi Medical Center

<structure><name> PostureEnergy </name>

<variables>

<var><name> Cals </name><val> 0 </val></var>
<var><name> MenstrualPostureFlowEffect </name></var>

<parm><name> Lying </name><val> 10 </val></parm>
<parm><name> Sitting </name><val> 250 </val></parm>
<parm><name> Standing </name><val> 500 </val></parm>
<parm><name> Tilting </name><val> 10 </val></parm>

<var><name> LyingM </name><val> .75 </val></var>
<var><name> SittingM </name><val> .85 </val></var>
<var><name> StandingM </name><val> 1 </val></var>
<var><name> TiltingM </name><val> .75 </val></var>

</variables>

<definitions>

<block><name> Calc </name>

<testcase>

<case><test> Status.Posture EQ PostureControl.LYING </test>

<def>
  <name> Cals </name>
  <val> Lying * Gravity.Gz </val>
</def>

<def>
  <name> MenstrualPostureFlowEffect </name>
  <val> LyingM * Gravity.Gz </val>
</def>

</case>

<case><test> Status.Posture EQ PostureControl.SITTING </test>

<def>
  <name> Cals </name>
  <val> Sitting * Gravity.Gz </val>
</def>

<def>
  <name> MenstrualPostureFlowEffect </name>
  <val> SittingM * Gravity.Gz </val>
</def>

</case>

<case><test> Status.Posture EQ PostureControl.STANDING </test>

<def>
  <name> Cals </name>
  <val> Standing * Gravity.Gz </val>
</def>

<def>
  <name> MenstrualPostureFlowEffect </name>
  <val> StandingM * Gravity.Gz </val>
</def>

</case>

<case><test> Status.Posture EQ PostureControl.TILTING </test>

<def>
  <name> Cals </name>
  <val> Tilting * Gravity.Gz </val>
</def>

<def>
  <name> MenstrualPostureFlowEffect </name>
  <val> TiltingM * Gravity.Gz </val>  <!-- Also depends on tilt angle, still to be added-->
</def>

</case>

</testcase>

</block>

</definitions>
</structure>

End