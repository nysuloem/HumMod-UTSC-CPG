HumMod / DietHunger-Ghrelin

Created : 2012-02-13
Revised : 2012-02-13
Author : Tom Coleman
Copyright : 2012-2012
By : University of Mississippi Medical Center

<structure><name> DietHunger-Ghrelin </name>

<variables>

<var><name> Effect </name></var>
<var><name> [Ghrelin] </name></var>

</variables>

<functions>

<curve>
  <name> Effect </name>
  <point><x>   0 </x><y> 0.0 </y><slope> 0 </slope></point>
  <point><x> 275 </x><y> 1.1 </y><slope> 0 </slope></point>
  <point><x> 600 </x><y> 1.2 </y><slope> 0 </slope></point>
</curve>

<!-- Ghrelin concentrations are pg/mL -->

<curve>
  <name> StomachVolume-Ghrelin </name>
  <point><x> 0 </x><y> 600 </y><slope> 0 </slope></point>
  <point><x> 400 </x><y> 275 </y><slope> 0 </slope></point>
  <point><x> 1000 </x><y> 150 </y><slope> 0 </slope></point>
  <point><x> 2000 </x><y> 0 </y><slope> 0 </slope></point>
</curve>

</functions>

<definitions>

<block><name> Dervs </name>

  <def><name> [Ghrelin] </name>
    <val> StomachVolume-Ghrelin [ Stomach.StomachVolume ] </val>
  </def>

  <def><name> Effect </name>
    <val> Effect [ [Ghrelin] ] </val>
  </def>

</block>

</definitions>

</structure>

End