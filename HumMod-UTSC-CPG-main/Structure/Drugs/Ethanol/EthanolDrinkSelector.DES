Schema : DES V1.0


<structure><name> EthanolDrinkSelector </name>

<variables>

<!-- No variables declared  here -->

</variables>

<definitions>

<block><name> DrinkSelect </name>

<onjustchanged><name> EthanolGILumen.DrinkType </name>

  <if><test> EthanolGILumen.DrinkType EQ 1 </test>
    <true>
      <def><name> EthanolSingleDose.%Alc </name><val> 5 </val></def>
      <def><name> EthanolDailyDose.PercentageofAlcohol </name><val> 5 </val></def>
    </true>
  </if>

  <if><test> EthanolGILumen.DrinkType EQ 2 </test>
    <true>
      <def><name> EthanolSingleDose.%Alc </name><val> 14 </val></def>
      <def><name> EthanolDailyDose.PercentageofAlcohol </name><val> 14 </val></def>
    </true>
  </if>

  <if><test> EthanolGILumen.DrinkType EQ 3 </test>
    <true>
      <def><name> EthanolSingleDose.%Alc </name><val> 40 </val></def>
      <def><name> EthanolDailyDose.PercentageofAlcohol </name><val> 40 </val></def>
    </true>
  </if>

</onjustchanged>

</block>

</definitions>

</structure>

End