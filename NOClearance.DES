<structure><name> NOClearance </name>

<variables>

<var><name> RenalDegradation </name></var>

<parm><name> K </name><val> 0.18 </val></parm>

</variables>

<definitions>
<block><name> Dervs </name>
<call> GlomerulusFiltrate.Calc </call>

<def>
  <name> RenalDegradation </name>
  <val> K * NOPool.[NO--] * GlomerulusFiltrate.GFR </val>
</def>


</block>

</definitions>
</structure>


End