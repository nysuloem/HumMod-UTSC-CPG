HumMod / A2Pool

Created : 21-Oct-04
Last Modified : 2011-11-09
Author : Tom Coleman
Copyright : 2006-2011
By : University Of Mississippi Medical Center

<structure><name> A2Pool </name>

<variables>

<var><name> [A2(pG/mL)] </name></var>
<var><name> [Lisinopril(nG/mL)] </name></var>
<var><name> LisinoprilEffect </name></var>
<var><name> Log10Conc </name></var>
<var><name> [A2(pMol/L)] </name></var>
<var><name> FormationRate </name></var>
<var><name> EndogenousRate </name></var>
<var><name> CEActivity </name></var>

<parm><name> Block(%) </name><val> 0.0 </val></parm>
<var><name> CEBase </name></var>
<parm><name> CEBaseTarget </name><val> 30.0 </val></parm>

<constant><name> A2CONC </name><val> 0.3333 </val></constant>
<constant><name> PG_TO_PMOL </name><val> 0.956 </val></constant>

<parm><name> Clamp </name><val> FALSE </val></parm>
<parm><name> Level </name><val> 0.0 </val></parm>

</variables>

<definitions>

<block><name> CalcConc </name>

 <def><name> [Lisinopril(nG/mL)] </name><val> LisinoprilPool.[Lisinopril] </val></def>

  <if><test> [Lisinopril(nG/mL)] GT 0 </test>
  <true>
    <def><name> LisinoprilEffect </name><val> ( 1 - ( 0.3 * ( LOG10 [Lisinopril(nG/mL)] ) ) ) MAX 0.05 </val></def>
  </true>
  <false>
    <def><name> LisinoprilEffect </name><val> 1 </val></def>
  </false>
  </if>

<def><name> CEBase </name><val> CEBaseTarget </val></def>
<def>
  <name> CEActivity </name>
  <val> CEBase * ( 1.0 - ( Block(%) / 100.0 ) ) </val>
</def>

<def>
  <name> EndogenousRate </name>
 <val> ReninPool.[PRA] * CEActivity * LisinoprilEffect </val>
</def>

<def>
  <name> FormationRate </name>
  <val> EndogenousRate + A2Pump.Rate </val>
</def>

<conditional>
  <name> [A2(pG/mL)] </name>
  <test> Clamp </test>
  <true> Level </true>
  <false> A2CONC * FormationRate MAX 0.8 </false>
</conditional>

<def>
  <name> [A2(pMol/L)] </name>
  <val> PG_TO_PMOL * [A2(pG/mL)] </val>
</def>

<conditional>
  <name> Log10Conc </name>
  <test> [A2(pG/mL)] GT 1.0 </test>
  <true> LOG10 ( [A2(pG/mL)] ) </true>
  <false> 0.0 </false>
</conditional>

<def>
  <name> DietThirst.Rate(L/Day) </name>
  <val> ( 1 - OsmBody.OsmoreceptorDamage ) * DietThirst.OsmoticThirst [ OsmBody.Osmoreceptors(mOsm/L) ] * DietThirst.VolumeThirst [ A2Pool.[A2(pG/mL)] ] </val>
</def>

<def>
  <name> DietThirst.ThirstRating </name>
  <val> DietThirst.ThirstRating [ DietThirst.Rate(L/Day) ] </val>
</def>

<conditional>
  <name> DietThirst.Rate(L/Day) </name>
  <test> DietIntakeH2O.Fixed? </test>
  <true> DietGoalH2O.Rate(L/Day)  </true>
  <false> DietThirst.Rate(L/Day) </false>
</conditional>

<def><name> DietIntakeH2O.Rate(mL/Min) </name><val> 1000.0 * DietThirst.Rate(L/Day) * DietFeeding.Fraction </val></def>

</block>

</definitions>

</structure>

End