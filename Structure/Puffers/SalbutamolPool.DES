HumMod / NOPool

<structure><name> SalbutamolPool </name>

<variables>

  <var><name> [Salbutamol] </name></var>

  <var><name> K </name><val> 0.009 </val></var>

  <var><name> Gain </name></var>
  <var><name> Loss </name></var>

  <var><name> Diffusion </name></var>


</variables>

<equations>

  <diffeq>
    <name> Mass </name>
    <integralname> Mass </integralname>
    <initialval> 0 </initialval>
    <dervname> Change </dervname>
    <errorlim> 1 </errorlim>
  </diffeq>

</equations>

<definitions>

<block><name> CalcConc </name>

  <def><name> [Salbutamol] </name><val> Mass * 1000 / ECFV.Vol </val></def>
  

</block>

<block><name> Dervs </name>

  <def>
    <name> Gain </name>
    <val>
        SalbutamolInhaler.Loss
    </val>
  </def>

  <def><name> Loss </name><val>  K * Mass </val></def>
  
  <def><name> Change </name><val> Gain - Loss </val></def>

</block>

</definitions>

</structure>

End
