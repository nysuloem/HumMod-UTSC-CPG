HumMod / NOPool

<structure><name> VentolinPool </name>

<variables>

  <var><name> [Ventolin] </name></var>

  <var><name> K </name><val> 0.9 </val></var>

  <var><name> Gain </name></var>
  <var><name> Loss </name></var>

  <var><name> Diffusion </name></var>


</variables>

<equations>

  <diffeq>
    <name> Mass </name>
    <integralname> Mass </integralname>
    <initialval> 0 </initialval>
    <dervname> Change </dervname>
    <errorlim> 1 </errorlim>
  </diffeq>

</equations>

<definitions>


<block><name> CalcDiffusion </name>

  <!--<def><name> Diffusion </name><val> Mass / 1.5 </val></def>--> <!-- NO diffuses relatively quickly -->

</block>

<block><name> CalcConc </name>

  <def><name> [Ventolin] </name><val> Mass / ECFV.Vol </val></def>
  

</block>

<block><name> Dervs </name>

  <call> NODrugPool.Dervs </call> 

  <def>
    <name> Gain </name>
    <val>
        NOPump.Rate
        + VascularEndothelium.NOProduction
    </val>
  </def>

  <def><name> Loss </name><val>  K * NOPool.[NO--] <!--* GlomerulusFiltrate.GFR--> </val></def>
  
  <def><name> Change </name><val> Gain - Loss </val></def>

</block>

</definitions>

</structure>

End
