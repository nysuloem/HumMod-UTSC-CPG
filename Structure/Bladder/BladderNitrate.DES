HumMod / BladderKetoacid

Created : 16-Mar-08
Revised : 2013-02-04
Author : Tom Coleman
Copyright : 2008-2013
By : University of Mississippi Medical Center

<structure><name> BladderNitrate </name>
<variables>

<var><name> [Nitrate] </name></var>
<var><name> [Nitrate(mMol/L)] </name></var>

<constant><name> InitialConc </name><val> 0.7667 </val></constant> 

<!-- in mmol/L, Jack L. Radomski, Christine Palmiri, William Lee Hearn,
Concentrations of nitrate in normal human urine and the effect of nitrate ingestion,
Toxicology and Applied Pharmacology,
Volume 45, Issue 1,
1978,
Pages 63-68,
ISSN 0041-008X,
https://doi.org/10.1016/0041-008X(78)90028-5. -->

<var><name> InitialMass </name></var>

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <dervname> Change </dervname>
</diffeq>

</equations>

<definitions>

<block><name> Init </name>

  <def><name> InitialMass </name><val> InitialConc * BladderVolume.InitialVolume </val></def>
  <def><name> Mass </name><val> InitialMass </val></def>

</block>

<block><name> Dervs </name>

  <def><name> Change </name><val> NOKidney.NitrateLevel </val></def>

</block>

<block><name> Conc </name>

  <def><name> [Nitrate] </name><val> Mass / BladderVolume.Mass </val></def>
  <def><name> [Nitrate(mMol/L)] </name><val> 1000 * [Nitrate] </val></def>

</block>

<block><name> Void </name>

  <def><name> Mass </name><val> Mass - ( BladderVolume.VolumeVoid * [Nitrate] ) </val></def>

</block>

</definitions>
</structure>

End
