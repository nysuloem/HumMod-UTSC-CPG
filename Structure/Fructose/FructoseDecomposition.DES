HumMod / FructoseDecomposition

<structure><name> FructoseDecomposition </name>

    <variables>
    
        <var><name> Rate </name></var>
        <parm><name> K </name><val> 0.0007 </val></parm>
        <param><name> Fructosekinase_Activity </name><val> 1.0 </val></param>

    </variables>

    <definitions>
    
        <block><name> Dervs </name>
        
            <def><name> Rate </name><val> K * Fructokinase_Activity * FructosePool.Mass </val></def>
        
        </block>

    </definitions>
</structure>

End
    