<structure> <name> Sexual </name>
<variables> 

    <var><name> SexOdds </name><val> 0.0 </val></var>

      <whitenoise>
        <name> Chance </name>
        <lowerlim> 0.0 </lowerlim>
        <upperlim> 1.0 </upperlim>
      </whitenoise>
<constant><name> NoChance </name><val> FALSE </val></constant>
</variables>    

<definitions> 
    <block><name> Dervs </name>
    <conditional> 
<name> SexOdds </name>
<test> SexualActivity.IsSexuallyActive </test>
        <true> Chance </true>
        <false> NoChance </false>
    </conditional>
     
    
    </block>

</definitions>




    </structure>
    End 