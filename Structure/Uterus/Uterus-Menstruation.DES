Schema : DES V1.0

<structure><name> Menstruation </name>

<variables>

<var><name> Bloodloss </name></var>
<var><name> Rate </name></var>


</variables>


<definitions>

<block><name> Dervs </name>

<conditional>
    <name> EndometriumDeg </name>
    <test> ( Estradiol.[Conc(nMol/L)] LT 0.1 ) AND ( Progesterone.[Conc(nMol/L)] LT 1 ) </test>
    <true> Endometrium.Functionalis </true>
    <false> 0.0 </false>
</conditional>



<conditional> 
<name> Rate </name> 
<test> ( Estradiol.[Conc(nMol/L)] LT 0.1 ) AND ( Progesterone.[Conc(nMol/L)] LT 1 )  </test>
<true> ( Estradiol.[Conc(nMol/L)] + Progesterone.[Conc(nMol/L)] ) * 0.0125 * EndometriumDeg  </true>
<false> 0.0 </false>
</conditional>




<!--  
<def><name> Rate </name><val> ( Estradiol.[Conc(nMol/L)] LT 0.1 ) AND ( Progesterone.[Conc(nMol/L)] LT 1 ) * 0.0005 * Endometrium.Thickness  </val> </def>

--> 

<def><name> Bloodloss </name><val> Sex.IsFemale * Rate </val></def>


</block>
</definitions>




</structure>

End