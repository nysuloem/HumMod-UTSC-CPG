Schema : DES V1.0

<structure><name> Uterus-Menstruation </name>
<!-- This structure determines the RATE at which blood flows into the uterus lumen from the sprial arteries -->

<variables>

    <var><name> Rate </name><val> 0 </val></var>
    <timervar><name> Duration </name></timervar>
    <var><name> DurationDays </name></var>
    <var><name> Change </name></var>

</variables>

<equations>

<!-- This diffeq is the total volume of blood in the uterus -->

    <diffeq>
        <name> UterusBloodLeakedVol </name>
        <integralname> UterusBloodLeakedVol </integralname>
        <initialval> 0 </initialval>
        <dervname> BloodLoss </dervname>
    </diffeq>

</equations>

<definitions>

<block><name> Dervs </name>

    <def>
        <name> Rate </name> 
        <val> ( Estradiol.[Conc(nMol/L)] LT 0.1 ) AND ( Progesterone.[Conc(nMol/L)] LT 1 ) * 0.001 * Uterus-Flow.BloodFlow </val>
    </def>

    <def>
        <name> BloodLoss </name>
        <val> Sex.IsFemale * Rate </val>
    </def>

    <def>
        <name> Change </name>
        <val> BloodLoss - Uterus-Lumen.MenstrualBloodLoss </val>
    </def>

    <testcase>

    <case>
        <test> ( Estradiol.[Conc(nMol/L)] LT 0.1 ) AND ( Progesterone.[Conc(nMol/L)] LT 1 ) EQ 0 </test>
        <timer>
            <name> Duration </name>
            <state> OFF </state>
        </timer>
    </case>

    <case>
        <test> ( Estradiol.[Conc(nMol/L)] LT 0.1 ) AND ( Progesterone.[Conc(nMol/L)] LT 1 ) EQ 1 </test>
        <timer>
            <name> Duration </name>
            <state> UP </state>
        </timer>
    </case>

    </testcase>

    <def><name> DurationDays </name>
        <val> Duration / 1440 </val>
    </def>

</block>

<block><name> ResetMenstrualDuration </name>

    <def><name> Duration </name>
    <val> 0 </val>
    </def>

</block>

<block><name> ResetBloodLost </name>

    <def><name> Uterus-Lumen.MenstrualBloodExpulsed </name>
    <val> 0 </val>
    </def>

</block>

</definitions>

</structure>

End