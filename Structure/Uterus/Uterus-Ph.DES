HumMod / Uterus-Ph

Created : 31-Mar-05
Revised : 2012-07-16
Author : Tom Coleman
Copyright : 2006-2012
By : University Of Mississippi Medical Center

<structure><name> Uterus-Ph </name>

<variables>

<var><name> Ph </name></var>
<var><name> [SID] </name></var>
<var><name> [SID(mEq/L)] </name></var>

</variables>

<definitions>
<block><name> CalcSID </name>

<if> 
<test> Context-Sex.Index EQ 1 </test>
<true> 
<def>
  <name> [SID] </name>
  <val>
      KCell.[K+]
    + CellSID.OtherCations
    - CellSID.StrongAnions
    - Uterus-Lactate.[Lac-] </val>
</def>
 </true>
 <false> 
 <def>
  <name> [SID] </name>
  <val>
   0.001 </val>
</def>
 
  </false>

</if>


<!-- Note above that the conditional <if> element was used instead of <conditional> to facilitate two various definitions
for SID value, one of algebraic calculation, the other as 0.001 for male. Simply putting 0.0 or no <false> argument generates 
a parser error for Undefined value TY -->

<def>
  <name> [SID(mEq/L)] </name>
  <val> 1000.0 * [SID] </val>
</def>

</block>

<block><name> CalcPh </name>


<if> 
<test> Context-Sex.Index EQ 1 </test>
<true> <call> Uterus-Size.Init </call>
<copy>
  <from> Uterus-CO2.PCO2 </from>
  <to> PhCells.pCO2 </to>
</copy>

<copy>
  <from> [SID(mEq/L)] </from>
  <to> PhCells.SID </to>
</copy>
 </true>

</if>

<conditional> 
<name> Ph </name>
<test> Context-Sex.Index EQ 1 </test>
<true> PhCells.pH </true>
<false> 0.001 </false>
</conditional>  


<if> 
<test> Context-Sex.Index EQ 1 </test>
<true> <call> PhCells.Calc </call> 

<copy>
  <from> PhCells.pH </from>
  <to> Ph </to>
</copy>

 </true>

</if>




</block>
</definitions>
</structure>

End