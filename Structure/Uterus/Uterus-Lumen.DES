<structure><name> Uterus-Lumen </name>

<variables>

<var><name> BloodPool </name></var>
<var><name> BleedRate </name></var>
<var><name> UterusContraction </name></var>
<var><name> PGEStimulation </name></var>
<!-- These variables are for breaking down blood lost into components, Ideally we remove the uterine tissue from total volume lost -->
<var><name> HctComposition </name><val> 0 </val></var>
<var><name> H2OComposition </name><val> 0 </val></var>
<var><name> EndometriumComp </name><val> 0 </val></var>

<var><name> HctLoss</name><val> 0 </val></var>
<var><name> H2OLoss </name><val> 0 </val></var>

</variables>

<equations> 

<!-- Terry's Old Model
  <diffeq>
    <name> MenstrualBleeding </name>
    <integralname> MenstrualBleeding </integralname>
    <initialval> 0.0  </initialval>
    <dervname> Change </dervname>
    <errorlim> 1.0 </errorlim>
  </diffeq>

  <delay>
    <name> BloodExpulsion </name>
    <outputname> Expulsion </outputname>
    <initialval> 0.1 </initialval>
    <inputname> BleedRate </inputname>
    <rateconstname> ExpulsionRate </rateconstname>
    <dervname> ExpulsionDerv </dervname>
    <errorlim> 0.5 </errorlim>
  </delay>
-->

<diffeq>
  <name> MenstrualBloodExpulsed </name>
  <integralname> MenstrualBloodExpulsed </integralname>
  <initialval> 0 </initialval>
  <dervname> MenstrualBloodLoss </dervname>
</diffeq>

<diffeq>
  <name> UterusBloodPool </name>
  <integralname> UterusBloodPool </integralname>
  <initialval> 0 </initialval>
  <dervname> Change </dervname>
</diffeq>

<!-- New model based on Tom's Time Delay-->

</equations>

<definitions> 
<block><name> CalcComposition </name>


<!-- Volumes -->
  <def><name> EndometriumComp </name><val>  0.0125 * Endometrium.Thickness  </val></def>
  <def><name> H2OComposition </name><val> Uterus-Menstruation.UterusBloodLeakedVol - EndometriumComp * BloodVol.PVCrit  </val></def>
  <def><name> HctComposition </name><val> Uterus-Menstruation.UterusBloodLeakedVol - EndometriumComp * BloodVol.Hct(%)  </val></def>
<!-- Rates -->

<def><name> HctLoss</name><val> Uterus-Menstruation.Rate - EndometriumComp * BloodVol.Hct(%)  </val></def>
<def><name> H2OLoss </name><val> Uterus-Menstruation.Rate - EndometriumComp * BloodVol.PVCrit  </val></def>

</block>
<block><name> Dervs </name>

  <def><name> Change </name>
    <val> Uterus-Menstruation.UterusBloodLeakedVol - MenstrualBloodExpulsed </val>
  </def>

  <def><name> BleedRate </name>
    <val> PostureEnergy.MenstrualPostureFlowEffect  </val>
  </def>

  <def><name> PGEStimulation </name>
    <val> 1 </val> <!-- This could be multipled by aspirin effect in the future -->
  </def>

  <def><name> UterusContraction </name>
    <val> PGEStimulation </val>
    </def>

  <def><name> MenstrualBloodLoss </name>
    <val> BleedRate * UterusContraction *  Uterus-Menstruation.BloodLoss </val>
  </def>



</block>

<block><name> Init </name>

<def><name> BloodPool </name> <val> 0.0 </val></def>

</block>

<block><name> Parms </name>
<def><name> ExpulsionRate </name><val> Uterus-Menstruation.Rate - Expulsion  </val></def>

</block>

<!--
<block> <name> Dervs </name>
    <call> Init </call>
    
    <def><name> BleedRate </name><val> BloodPool </val></def>


<def><name> Gain </name><val> Uterus-Menstruation.Rate </val></def>
<def><name> Loss </name> <val> Expulsion </val></def>
<def><name> Change </name><val> Gain - Loss  </val></def>
<def><name> BloodPool </name> <val> Uterus-Menstruation.Volume - MenstrualBleeding </val></def>

</block>  
-->  
</definitions>
</structure>   

End 