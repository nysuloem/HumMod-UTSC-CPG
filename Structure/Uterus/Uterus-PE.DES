HumMod / Uterus-PE

<structure><name> Uterus-PE </name>

<variables>

<!-- for the family history switch. borrowed from insulin pump (diabetes) -->
<parm>
    <name> Switch </name>
    <val> FALSE </val>
</parm>
<var>
    <name> History </name>
</var>

<!-- RF = risk factor -->
<var>
    <name> RFOne </name>
</var>
<var>
    <name> RFTwo </name>
</var>
<var>
    <name> RFThree </name>
</var>
<var>
    <name> RFFour </name>
</var>
<var>
    <name> RFFive </name>
</var>
<var>
    <name> RFSix </name>
</var>
<var>
    <name> RFSeven </name>
</var>

<var><name> FlagHistory </name><val> 0 </val></var>
<var><name> FlagPregnant </name><val> 0 </val></var>
<var><name> Flag20Weeks </name><val> 0 </val></var>
<var><name> FlagObese </name><val> 0 </val></var>
<var><name> FlagAge </name><val> 0 </val></var>
<var><name> FlagShort </name><val> 0 </val></var>
<var><name> FlagDiabetes </name><val> 0 </val></var>
<var><name> FlagHighBMI </name><val> 0 </val></var>


<parm><name> Risk </name><val> 1 </val></parm>


<var><name> RiskOutcome </name><val> 3 </val></var>
<!-- <var><name> DiagOutcome </name><val> 3 </val></var> -->


</variables>

<definitions>

<block><name> RiskCalc  </name>

<!-- test for family history
<conditional>
    <name> History </name>
    <test> Switch </test>
    <true> 5.0 </true>
    <false> 1.0 </false>
  </conditional>

<if>
    <test> Pregnancy-Occurence.AnnouncePregnancy GE 0 </test>
    <true> 
    <def><name> RFOne </name><val> 1 </val></def>
    </true>
    <false>
    <def><name> RFOne </name><val> 0 </val></def>
    </false>
</if>


<if>
    <test> Pregnancy-Occurence.PregnancyWeek GT 20 </test>
    <true> 
    <def><name> RFTwo </name><val> 10 </val></def>
    </true>
    <false>
    <def><name> RFTwo </name><val> 1 </val></def>
    </false>
</if>


<if>
    <test> ( Context-Adiposity.Index EQ 1 ) OR ( Context-Adiposity.Index EQ 2 ) OR ( Context-Adiposity.Index EQ 3 ) </test>
    <true> 
        <def><name> RFThree </name><val> 2 </val></def>
        </true>
        <false>
        <def><name> RFThree </name><val> 1 </val></def>
        </false>
</if>

<if>
    <test> ( Context-Age.Index EQ 4 ) OR ( Context-Age.Index EQ 5 ) </test>
    <true> 
        <def><name> RFFour </name><val> 2 </val></def>
    </true>
    <false>
        <def><name> RFFour </name><val> 1 </val></def>
    </false>
</if>

<if>
    <test> Context-Height.Index EQ 0  </test>
    <true> 
        <def><name> RFFive </name><val> 2 </val></def>
    </true>
     <false>
        <def><name> RFFive </name><val> 1 </val></def>
     </false>
</if>

<if>
    <test> InsulinPump.Switch2 EQ TRUE </test>
    <true> 
        <def><name> RFSix </name><val> 2 </val></def>
    </true>
    <false>
        <def><name> RFSix </name><val> 1 </val></def>
    </false>
</if>

<if>
    <test> BMI.BMI GE 26  </test>
    <true> 
        <def><name> RFSeven </name><val> 2 </val></def>
    </true>
    <false>
        <def><name> RFSeven </name><val> 1 </val></def>
    </false>
</if> -->

    <!-- family history -->
    <if>
        <test> Switch EQ TRUE </test>
        <true>
            <def><name> FlagHistory </name><val> 1 </val></def>
            <def><name> History </name><val> 5.0 </val></def>
        </true>
        <false>
            <def><name> FlagHistory </name><val> 0 </val></def>
            <def><name> History </name><val> 0 </val></def>
        </false>
    </if>
    
    <!-- pregnant -->
    <if>
        <test> Pregnancy-Occurence.PregnancyWeek GT 0 </test>
        <true>
            <def><name> FlagPregnant </name><val> 1 </val></def>
            <def><name> RFOne </name><val> 1 </val></def>
        </true>
        <false>
            <def><name> FlagPregnant </name><val> 0 </val></def>
            <def><name> RFOne </name><val> 0 </val></def>
        </false>
    </if>
    
    <!-- 20+ weeks pregnant -->
    <if>
        <test> Pregnancy-Occurence.PregnancyWeek GE 20 </test>
        <true>
            <def><name> Flag20Weeks </name><val> 1 </val></def>
            <def><name> RFTwo </name><val> 1 </val></def>
        </true>
        <false>
            <def><name> Flag20Weeks </name><val> 0 </val></def>
            <def><name> RFTwo </name><val> 0 </val></def>
        </false>
    </if>
    
    <!-- obesity -->
    <if>
        <test> ( Context-Adiposity.Index EQ 0 ) OR ( Context-Adiposity.Index EQ 1 ) </test>
        <true>
            <def><name> FlagObese </name><val> 0 </val></def>
            <def><name> RFThree </name><val> 0 </val></def>
        </true>
        <false>
            <def><name> FlagObese </name><val> 1 </val></def>
            <def><name> RFThree </name><val> 2 </val></def>
        </false>
    </if>
    
    <!-- maternal age -->
    <if>
        <test> Context-Age.Age(Years) GE 35 </test>
        <true>
            <def><name> FlagAge </name><val> 1 </val></def>
            <def><name> RFFour </name><val> 2 </val></def>
        </true>
        <false>
            <def><name> FlagAge </name><val> 0 </val></def>
            <def><name> RFFour </name><val> 0 </val></def>
        </false>
    </if>
    
    <!-- short stature -->
    <if>
        <test> Context-Height.Index EQ 0 </test>
        <true>
            <def><name> FlagShort </name><val> 1 </val></def>
            <def><name> RFFive </name><val> 2 </val></def>
        </true>
        <false>
            <def><name> FlagShort </name><val> 0 </val></def>
            <def><name> RFFive </name><val> 0 </val></def>
        </false>
    </if>
    
    <!-- diabetes -->
    <if>
        <test> InsulinPump.Switch2 EQ TRUE </test>
        <true>
            <def><name> FlagDiabetes </name><val> 1 </val></def>
            <def><name> RFSix </name><val> 2 </val></def>
        </true>
        <false>
            <def><name> FlagDiabetes </name><val> 0 </val></def>
            <def><name> RFSix </name><val> 0 </val></def>
        </false>
    </if>
    
    
    <def><name> Risk </name>
        <val>
            ( History + RFThree + RFFour + RFFive + RFSix ) * RFTwo * RFOne
        </val>
    </def>
    

</block>

<block><name> RiskOutcomeCalc </name>
<testcase> 
    <case><test> Risk GE 9 </test>
      <def><name> RiskOutcome </name><val> 1 </val></def>
    </case>
    <case><test> Risk GE 9 </test>
      <def><name> RiskOutcome </name><val> 2 </val></def>
    </case>
    <case><test> Risk LT 5 </test>
      <def><name> RiskOutcome </name><val> 3 </val></def>
    </case>
  </testcase>
</block>

<!-- <block><name> Diagnosis </name></block>

<testcase> 
    <case><test> UrineAnalysis.Protein GE 3 AND SystemicArtys.SBP GE 160 OR SystemicArtys.DBP EQ 110  </test>
      <def><name> DiagOutcome </name><val> 1 </val></def>
    </case>
    <case><test> Risk GE 5 </test>
      <def><name> DiagOutcome </name><val> 2 </val></def>
    </case>
    <case><test> Risk LT 4 </test>
      <def><name> DiagOutcome </name><val> 3 </val></def>
    </case>
  </testcase> -->

</definitions>
</structure>

End

