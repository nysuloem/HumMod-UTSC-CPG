<!--NEW VERSION -->
<!-- ========================================================= -->
<!--  FETUS MODULE (STRUCTURE-ONLY)                            -->
<!--  This file does NOT compute gestational age.              -->
<!--                                                          -->
<!--  Gestational age is computed in Pregnancy-Occurence.DES   -->
<!--  Block: GestationWeeks                                   -->
<!--  Variable: Pregnancy-Occurence.PregnancyWeek              -->
<!--                                                          -->
<!--  This file references that value directly.                -->
<!-- ========================================================= -->


<!-- ========================================================= -->
<!--  FETAL GROWTH MODEL (DIFFEQ / MONOTONIC)                 -->
<!--                                                           -->
<!--  - Computes ideal logistic growth curve                  -->
<!--  - Modifies growth based on placental O2 delivery        -->
<!--  - Integrates fetal weight as a state variable           -->
<!--  - Weight can NEVER decrease (monotonic growth)          -->
<!-- ========================================================= -->

<structure>

  <name> FetalGrowth-Model </name>

   <variables>

    <var><name> FetalWeight </name><val> 0 </val></var>

    <var><name> FetalWeight_Ideal </name><val> 0 </val></var>
    <var><name> FetalWeight_Target </name><val> 0 </val></var>

    <parm><name> GrowthTau(min) </name><val> 10080 </val></parm>
    <parm><name> O2Diffused_Baseline </name><val> 22.75 </val></parm>

    <var><name> O2Ratio </name><val> 1 </val></var>
    <var><name> O2GrowthEffect </name><val> 1 </val></var>

    <var><name> ScalingFactor </name><val> 0 </val></var>
    <var><name> FetalMetabolicRate </name><val> 0 </val></var>
    <var><name> FetalVolume_O2 </name><val> 0 </val></var>

  </variables>


  <!-- ===================================================== -->
  <!-- DIFFERENTIAL EQUATION FOR FETAL WEIGHT                -->
  <!-- ===================================================== -->

    <equations>

    <diffeq>
      <name> FetalWeight_State </name>

      <integralname> FetalWeight_State </integralname>

      <initialval> 0 </initialval>

      <dervname> dWdt </dervname>

      <errorlim> 1 </errorlim>
    </diffeq>

  </equations>


  <definitions>

    <!-- ===================================================== -->
    <!-- STEP 1: Compute logistic ideal growth curve           -->
    <!-- ===================================================== -->

 <block>
  <name> SeedAtPregnancyStart </name>

  <onjustchanged>
    <name> Pregnancy-Occurence.Fertilization </name>

    <if><test> Pregnancy-Occurence.Fertilization </test>
      <true>
        <def>
          <name> FetalWeight_State </name>
          <val>
            3500 / ( 1 + EXP ( -0.3 * ( Pregnancy-Occurence.PregnancyWeek - 20 ) ) )
          </val>
        </def>
      </true>
    </if>

  </onjustchanged>

</block>


    <block>
      <name> GrowthTarget </name>

      <if><test> Pregnancy-Occurence.Fertilization EQ UNDEFINED </test>
        <true>
          <def>
            <name> FetalWeight_Ideal </name>
            <val>
              0
            </val>
          </def>
        </true>
        <false>
          <def><name> FetalWeight_Ideal </name><val> 3500 / ( 1 + EXP ( -0.3 * ( Pregnancy-Occurence.PregnancyWeek - 20 ) ) ) </val></def>
        </false>
      </if>

      <!-- Normalize current placental oxygen delivery, Baseline is clamped so it cannot be 0 -->
      <def>
        <name> O2Ratio </name>
        <val> Placenta-Exchange.O2Diffused / ( O2Diffused_Baseline MAX 0.01 ) </val>
      </def>

      <!-- Clamp oxygen effect for stability -->
      <!-- Minimum 0.5 (severe hypoxia) -->
      <!-- Maximum 1.2 (mild hyperoxia boost) -->
      <def>
        <name> O2GrowthEffect </name>
        <val> ( O2Ratio MAX 0.5 ) MIN 1.2 </val>
      </def>

      <!-- Final target weight -->
      <def>
        <name> FetalWeight_Target </name>
        <val> FetalWeight_Ideal * O2GrowthEffect </val>
      </def>

    </block>


    <!-- ===================================================== -->
    <!-- STEP 2: Integrate weight toward target                -->
    <!-- ===================================================== -->

    <block>
      <name> GrowthDerv </name>

      <!-- Monotonic growth law:
           (Target - State) / Tau
           MAX 0 prevents negative growth -->
      <if><test> Pregnancy-Occurence.Fertilization </test>
        <true>
          <def>
            <name> dWdt </name>
            <val>
              ( ( FetalWeight_Target - FetalWeight_State ) / GrowthTau(min) ) MAX 0
            </val>
          </def>
        </true>
        <false>
          <def><name> dWdt </name><val> 0 </val></def>
        </false>
      </if>

      <!-- Output state -->
      <if><test> Pregnancy-Occurence.Fertilization </test>
        <true>
          <def><name> FetalWeight </name><val> FetalWeight_State </val></def>
        </true>
        <false>
          <def><name> FetalWeight </name><val> 0 </val></def>
        </false>
      </if>

      <!-- Derived scaling variables -->
      <def><name> ScalingFactor </name><val> FetalWeight / 3500 </val></def>
      <def><name> FetalMetabolicRate </name><val> 8.0 * ScalingFactor </val></def>
      <def><name> FetalVolume_O2 </name><val> 20 * ScalingFactor </val></def>

    </block>

  </definitions>

</structure>


<!-- ========================================================= -->
<!--  PLACENTA EXCHANGE STRUCTURE                              -->
<!--  Uses gestational week from Pregnancy-Occurence.DES        -->
<!--  When not pregnant, flows and diffusion go to 0            -->
<!-- ========================================================= -->

 <!-- <structure>

  <name> Placenta-Exchange </name>

  <variables>

 Maternal uterine blood flow (mL/min)
    <var>
      <name> UterineFlow </name>
      <val> 0 </val>
    </var>

     Fetal umbilical blood flow (mL/min) 
    <var>
      <name> UmbilicalFlow </name>
      <val> 0 </val>
    </var>

     Oxygen transferred to fetus (mL O2/min)
    <var>
      <name> O2Diffused </name>
      <val> 0 </val>
    </var>

     Available maternal oxygen supply (mL O2/min or arbitrary cap)
    <var>
      <name> MaternalO2Supply </name>
      <val> 100 </val>
    </var>

  </variables>

  <definitions>

    <block>
      <name> Hemodynamics </name>

      
         If not pregnant: flows should be zero.
        If pregnant: uterine flow rises with gestational week.

        500 baseline + 20 per week is a placeholder relationship.
        You can later replace this with Uterus-Flow.DES or a literature curve.
        add (uterine flow to the urine in hummod itself, uterus-flow)
      

      <if><test> Pregnancy-Occurence.Fertilization </test>
        <true>

          <def>
            <name> UterineFlow </name>
            <val>
              500 + 20 * Pregnancy-Occurence.PregnancyWeek
            </val>
          </def>

           Umbilical flow is assumed to be a fraction of uterine flow 
          <def>
            <name> UmbilicalFlow </name>
            <val> 0.8 * UterineFlow </val>
          </def>

        </true>

        <false>
          <def><name> UterineFlow </name><val> 0 </val></def>
          <def><name> UmbilicalFlow </name><val> 0 </val></def>
        </false>
      </if>

    </block>

    <block>
      <name> O2Diffusion </name>

      
        Oxygen transfer is limited by:
          (1) maternal supply cap
          (2) flow-limited diffusion term

        UmbilicalFlow * 0.05 is a placeholder extraction/diffusion efficiency.

        MIN ( Supply , FlowTerm ) prevents extracting more O2 than available.
      

      <if><test> Pregnancy-Occurence.Fertilization </test>
        <true>
          <def>
            <name> O2Diffused </name>
            <val>
              MaternalO2Supply MIN ( UmbilicalFlow * 0.05 )
            </val>
          </def>
        </true>
        <false>
          <def><name> O2Diffused </name><val> 0 </val></def>
        </false>
      </if>

    </block>

  </definitions>

</structure> 
-->
<structure>

  <name> Placenta-Exchange </name>

  <variables>

    <var><name> UterineFlow </name><val> 0 </val></var>
    <var><name> UmbilicalFlow </name><val> 0 </val></var>
    <var><name> O2Diffused </name><val> 0 </val></var>
    <var><name> MaternalO2Supply </name><val> 0 </val></var>

    <!-- Modern literature-based constants -->
    <constant><name> UTERINE_FLOW_PER_KG </name><val> 200 </val></constant>
    <constant><name> UMBILICAL_FLOW_PER_KG </name><val> 130 </val></constant>
    <constant><name> FETAL_O2_UPTAKE_PER_KG </name><val> 6.5 </val></constant>
    <constant><name> PLACENTA_FRACTION </name><val> 0.35 </val></constant>
    <constant><name> O2_EXTRACT_PER_ML </name><val> 0.048 </val></constant>

  </variables>

  <definitions>

    <block>
      <name> Hemodynamics </name>

      <if><test> Pregnancy-Occurence.Fertilization </test>
        <true>

          <def>
            <name> UterineFlow </name>
            <val>
              UTERINE_FLOW_PER_KG * ( FetalGrowth-Model.FetalWeight_Ideal / 1000 )
            </val>
          </def>

          <def>
            <name> UmbilicalFlow </name>
            <val>
              UMBILICAL_FLOW_PER_KG * ( FetalGrowth-Model.FetalWeight_Ideal / 1000 )
            </val>
          </def>

        </true>
        <false>
          <def><name> UterineFlow </name><val> 0 </val></def>
          <def><name> UmbilicalFlow </name><val> 0 </val></def>
        </false>
      </if>

    </block>

    <block>
      <name> O2Diffusion </name>

      <if><test> Pregnancy-Occurence.Fertilization </test>
        <true>

          <!-- Total uterine O2 supply -->
          <def>
            <name> MaternalO2Supply </name>
            <val>
              ( FETAL_O2_UPTAKE_PER_KG * ( FetalGrowth-Model.FetalWeight_Ideal / 1000 ) )
              / ( 1 - PLACENTA_FRACTION )
            </val>
          </def>

          <!-- Fetal O2 delivery -->
          <def>
            <name> O2Diffused </name>
            <val>
              ( UmbilicalFlow * O2_EXTRACT_PER_ML )
              MIN
              ( MaternalO2Supply * ( 1 - PLACENTA_FRACTION ) ) * 10
              <!-- times by 100 to be visible on graph only (without its too small to be visible on graph)-->
            </val>
          </def>

        </true>
        <false>
          <def><name> MaternalO2Supply </name><val> 0 </val></def>
          <def><name> O2Diffused </name><val> 0 </val></def>
        </false>
      </if>

    </block>

  </definitions>

</structure>


<structure>

  <name> Fetus </name>

  <definitions>

    <block>
      <name> Dervs </name>

      <call> Placenta-Exchange.Hemodynamics </call>
      <call> Placenta-Exchange.O2Diffusion </call>
      <call> FetalGrowth-Model.SeedAtPregnancyStart </call>
      <call> FetalGrowth-Model.GrowthTarget </call>
      <call> FetalGrowth-Model.GrowthDerv </call>

    </block>

  </definitions>

</structure>