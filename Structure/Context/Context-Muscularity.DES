HumMod / Context-Muscularity

Created : 2012-03-10
Revised : 2012-06-28
Author : Tom Coleman
Copyright : 2012-2012
By : University of Mississippi Medical Center

<structure><name> Context-Muscularity </name>

<variables>

  <parm><name> Index </name><val> 1 </val></parm>
  <parm><name> MuscleComposition </name><val> 3 </val></parm>
  <parm><name> PlusMinus </name><val> 0 </val></parm>

  <constant><name> MALE_BELOWNORMAL    </name><val> 18.0 </val></constant>
  <constant><name> MALE_NORMAL         </name><val> 26.4 </val></constant>
  <constant><name> MALE_ABOVENORMAL    </name><val> 40.0 </val></constant>
  <constant><name> MALE_TRAINEDATHLETE </name><val> 58.0 </val></constant>

  <constant><name> FEMALE_BELOWNORMAL    </name><val> 12.0 </val></constant>
  <constant><name> FEMALE_NORMAL         </name><val> 16.8 </val></constant>
  <constant><name> FEMALE_ABOVENORMAL    </name><val> 23.0 </val></constant>
  <constant><name> FEMALE_TRAINEDATHLETE </name><val> 34.0 </val></constant>

  <var><name> NominalMass </name></var>
  <var><name> Mass </name></var>
  <var><name> Mass(kG) </name></var>
  <var><name> Efficiency(%) </name></var>

  <var><name> IsBelowNormal    </name></var>
  <var><name> IsNormal         </name></var>
  <var><name> IsAboveNormal    </name></var>
  <var><name> IsTrainedAthlete </name></var>

  <var><name> IsPower </name></var>
  <var><name> IsEndurance </name></var>
  <var><name> IsNeutral </name></var>

  <var><name> Stochasm </name></var>
  <var><name> MuscleMassAdjust </name></var>
  <var><name> AgeAdjustPower </name></var>
  <var><name> AgeAdjustEfficiency </name></var>
  <var><name> Power(W) </name></var>
  <var><name> TotalPower </name></var>

<normaldist>
  <name> Normal </name>
  <mean> 0 </mean>
  <stddev> 25 </stddev>
</normaldist>

<whitenoise>
  <name> Flat </name>
  <lowerlim> -5 </lowerlim>
  <upperlim> 5 </upperlim>
</whitenoise>

</variables>

<functions>

<curve><name> MuscleMassAdjustAge </name>
<point><x> 0 </x><y> 0.08 </y><slope> 0.025 </slope></point>
<point><x> 16 </x><y> 0.85 </y><slope>0.025</slope></point>
<point><x> 20 </x><y> 1.0 </y><slope> 0.025 </slope></point>
<point><x> 60 </x><y> 0.85 </y><slope>0.025</slope></point>
<point><x> 70 </x><y> 0.65 </y><slope> 0.025 </slope></point>
<point><x> 90 </x><y> 0.40 </y><slope>0.025</slope></point>
</curve>

<curve><name> AgeAdjustPower </name>
<point><x> 0 </x><y> 0.08 </y><slope> 0.040 </slope></point>
<point><x> 16 </x><y> 0.85 </y><slope> 0.025 </slope></point>
<point><x> 20 </x><y> 0.98 </y><slope> 0.005 </slope></point>
<point><x> 60 </x><y> 0.85 </y><slope> -0.010 </slope></point>
<point><x> 70 </x><y> 0.72 </y><slope> -0.014 </slope></point>
<point><x> 90 </x><y> 0.40 </y><slope> -0.014 </slope></point>
</curve>

<curve><name> AgeAdjustEfficiency </name>
<point><x> 0 </x><y> 0.65 </y><slope> 0.020 </slope></point>
<point><x> 16 </x><y> 0.95 </y><slope> 0.008 </slope></point>
<point><x> 20 </x><y> 1.00 </y><slope> 0.000 </slope></point>
<point><x> 60 </x><y> 0.95 </y><slope> -0.003 </slope></point>
<point><x> 70 </x><y> 0.90 </y><slope> -0.005 </slope></point>
<point><x> 90 </x><y> 0.80 </y><slope> -0.005 </slope></point>
</curve>

</functions>

<definitions>

<block><name> Parms </name>

<onjustchanged><name> Index </name>
<call> Context.Calc </call>
</onjustchanged>

<onjustchanged><name> MuscleComposition </name>
<call> Context.Calc </call>
</onjustchanged>

<onjustchanged><name> PlusMinus </name>
<call> Context.Calc </call>
</onjustchanged>

</block>

<block><name> Calc </name>

<def><name> IsBelowNormal    </name><val> FALSE </val></def>
<def><name> IsNormal         </name><val> FALSE </val></def>
<def><name> IsAboveNormal    </name><val> FALSE </val></def>
<def><name> IsTrainedAthlete </name><val> FALSE </val></def>

<def><name> IsPower </name><val> FALSE </val></def>
<def><name> IsEndurance </name><val> FALSE </val></def>
<def><name> IsNeutral </name><val> FALSE </val></def>

<if><test> Context-Sex.IsFemale </test>
  <true><call> CalcFemale </call></true> <!-- If  you do the female muscularity, then women die when they have to work-->
  <false><call> CalcMale </call></false>
</if>

<call> CalcStochasm </call>

<def><name>MuscleMassAdjust</name>
<val> MuscularityAdjustAge [ Context-Age.Age(Years) ] </val></def>

<def><name>MuscleEfficiencyAdjust</name>
<val> AgeAdjustEfficiency [ Context-Age.Age(Years) ] </val></def>

<def><name>MusclePowerAdjust</name>
<val> AgeAdjustPower [ Context-Age.Age(Years) ] </val></def>

<def>
  <name> Mass(kG) </name>
  <val>
     NominalMass
     * ( 1.0 + ( Stochasm / 100 ) )
     * MuscleAdjust
  </val>
</def>

<testcase>

<case><test> MuscleComposition EQ 1 </test>
  <def><name> Efficiency(%) </name><val> 30  * ( 1.0 + ( Stochasm / 100 ) ) * MuscleEfficiencyAdjust </val></def>
  <def><name> Power(W) </name><val> 300  * ( 1.0 + ( Stochasm / 100 ) ) * MusclePowerAdjust </val></def>
  <def><name> IsPower </name><val> TRUE </val></def>
</case>

<case><test> MuscleComposition EQ 2 </test>
  <def><name> Efficiency(%) </name><val> 70  * ( 1.0 + ( Stochasm / 100 ) ) * MuscleEfficiencyAdjust </val></def>
  <def><name> Power(W) </name><val> 25  * ( 1.0 + ( Stochasm / 100 ) ) * MusclePowerAdjust </val></def>
  <def><name> IsEndurance </name><val> TRUE </val></def>
</case>

<case><test> MuscleComposition EQ 3 </test>
  <def><name> Efficiency(%) </name><val> 50  * ( 1.0 + ( Stochasm / 100 ) ) * MuscleEfficiencyAdjust </val></def>
  <def><name> Power(W) </name><val> 125  * ( 1.0 + ( Stochasm / 100 ) ) * MusclePowerAdjust </val></def>
  <def><name> IsNeutral </name><val> TRUE </val></def>
</case>

</testcase>

<def>
  <name> Mass </name>
  <val> 1000 * Mass(kG) </val>
</def>

<def>
<name> TotalPower </name>
<val> Power(W) * Mass(kG) </val>
</def>

</block>

<block><name> CalcMale </name>

<testcase>

<case><test> Index EQ 0 </test>
<def><name> NominalMass </name><val> MALE_BELOWNORMAL </val></def>
<def><name> IsBelowNormal </name><val> TRUE </val></def>
</case>

<case><test> Index EQ 1 </test>
<def><name> NominalMass </name><val> MALE_NORMAL </val></def>
<def><name> IsNormal </name><val> TRUE </val></def>
</case>

<case><test> Index EQ 2 </test>
<def><name> NominalMass </name><val> MALE_ABOVENORMAL </val></def>
<def><name> IsAboveNormal </name><val> TRUE </val></def>
</case>

<case><test> Index EQ 3 </test>
<def><name> NominalMass </name><val> MALE_TRAINEDATHLETE </val></def>
<def><name> IsTrainedAthlete </name><val> TRUE </val></def>
</case>

</testcase>

</block>

<block><name> CalcFemale </name>

<testcase>

<case><test> Index EQ 0 </test>
<def><name> NominalMass </name><val> FEMALE_BELOWNORMAL </val></def>
<def><name> IsBelowNormal </name><val> TRUE </val></def>
</case>

<case><test> Index EQ 1 </test>
<def><name> NominalMass </name><val> FEMALE_NORMAL </val></def>
<def><name> IsNormal </name><val> TRUE </val></def>
</case>

<case><test> Index EQ 2 </test>
<def><name> NominalMass </name><val> FEMALE_ABOVENORMAL </val></def>
<def><name> IsAboveNormal </name><val> TRUE </val></def>
</case>

<case><test> Index EQ 3 </test>
<def><name> NominalMass </name><val> FEMALE_TRAINEDATHLETE </val></def>
<def><name> IsTrainedAthlete </name><val> TRUE </val></def>
</case>

</testcase>

</block>

<block><name> CalcStochasm </name>

<def>
  <name> Stochasm </name>
  <val> Flat </val>
</def>

</block>

</definitions>

</structure>

End