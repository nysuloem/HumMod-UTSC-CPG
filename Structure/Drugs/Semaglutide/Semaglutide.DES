HumMod / EpiSingleDose

Created : 05-Jun-06
Last Modified : 26-Jan-10
Author : Tom Coleman
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<structure><name> Semaglutide </name>

<variables>

<parm>
  <name> Dose </name>
  <val> 0.0 </val>
</parm>

<var>
  <name> TimeLastDose </name>
  <val> UNDEFINED </val>
</var>

<var>
  <name> TotalDoses </name>
  <val> 0.0 </val>
</var>

<var>
  <name> CumulativeDose </name>
  <val> 0.0 </val>
</var>

<var>
  <name> [FreeSemaglutide] </name>
  <val> 0.0 </val>
</var>

<var>
  <name> [BoundSemaglutide] </name>
  <val> 0.0 </val>
</var>

<var>
  <name> Sequestration </name>
</var>

<var>
  <name> Mobilization </name>
</var>

<var>
  <name> Degradation </name>
</var>

<var>
  <name> KOff </name>
  <val> 0.000845 </val>
</var>

<var>
  <name> KOn </name>
  <val> 300 </val>
</var>

<var>
  <name> KDeg </name>
  <val> 0.015 </val>
</var>

<var>
  <name> KSkin </name>
  <val> 0.000015 </val>
</var>

<var>
  <name> KSkinDegrade </name>
  <val> 0.00002 </val>
</var>

<var>
  <name> SkinToBlood </name>
</var>

<timervar><name> ResetDose </name><val> 0 </val><state> OFF </state></timervar>
<timervar><name> WeeklyAuto </name><val> 1 </val><state> OFF </state></timervar>

</variables>

<equations>

<diffeq>
  <name> FreeMass </name>
  <integralname> FreeMass </integralname><!-- ng -->
  <initialval> 0.0 </initialval>
  <dervname> FreeChange </dervname>
  <errorlim> 0.025 </errorlim>
</diffeq>

<diffeq>
  <name> BoundMass </name>
  <integralname> BoundMass </integralname><!-- ng -->
  <initialval> 0.0 </initialval>
  <dervname> BoundChange </dervname>
  <errorlim> 0.025 </errorlim>
</diffeq>

<diffeq>
  <name> SkinMass </name>
  <integralname> SkinMass </integralname><!-- ng -->
  <initialval> 0.0 </initialval>
  <dervname> SkinChange </dervname>
  <errorlim> 0.025 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> TakeAdultDoseNow </name>
<timer><name> ResetDose </name> <state> UP </state> </timer>
<timer><name> WeeklyAuto </name> <val> 10080 </val> <state> DOWN </state> </timer>

<def>
  <name> SkinMass </name>
  <val> SkinMass + ( Dose ) </val>
</def>

<def>
  <name> TimeLastDose </name>
  <val> System.X </val>
</def>

<def>
  <name> TotalDoses </name>
  <val> TotalDoses + 1.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> CumulativeDose + Dose </val>
</def>

</block>

<block><name> Wrapup </name> 
<if><test> ResetDose GE 1 </test>
<true><timer><name> ResetDose </name><val> 0 </val><state> OFF </state></timer>
<def><name> Dose </name><val> 0 </val></def></true></if>

<if><test> WeeklyAuto EQ 0 </test>
<true><def><name> Dose </name><val> 2 </val></def><call> TakeAdultDoseNow </call>
</true></if></block>

<block><name> Dervs </name>
<def>
  <name> Sequestration </name>
  <val> FreeMass * KOn * AlbuminPool.[Alb(mmol/mL)] </val>
</def>

<def>
  <name> Mobilization </name>
  <val>  KOff * BoundMass </val>
</def>

<def>
  <name> Degradation </name>
  <val>  FreeMass * KDeg </val>
</def>

<def><name> SkinToBlood </name><val>  Skin-Flow.BloodFlow * SkinMass * KSkin </val></def>
<def><name> SkinChange </name><val> - ( SkinToBlood + KSkinDegrade ) </val></def>
<def><name> FreeChange </name><val>  Mobilization + SkinToBlood - Sequestration - Degradation </val></def>
<def><name> [FreeSemaglutide] </name><val> FreeMass / ECFV.Vol * 243000000.1 </val></def>
<def><name> BoundChange </name><val> Sequestration - Mobilization </val></def>
<def><name> [BoundSemaglutide] </name><val> BoundMass / ECFV.Vol * 243000000.1 </val></def>

</block>


<block><name> Reset </name>

<def>
  <name> TimeLastDose </name>
  <val> UNDEFINED </val>
</def>

<def>
  <name> TotalDoses </name>
  <val> 0.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> 0.0 </val>
</def>

</block>



</definitions>
</structure>

End
