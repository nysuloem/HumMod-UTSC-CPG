HumMod / EpiSingleDose

Created : 05-Jun-06
Last Modified : 26-Jan-10
Author : Tom Coleman
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<structure><name> Semaglutide </name>

<variables>

<parm>
  <name> Dose </name>
  <val> 0.0 </val>
</parm>

<var>
  <name> TimeLastDose </name>
  <val> UNDEFINED </val>
</var>

<var>
  <name> TotalDoses </name>
  <val> 0.0 </val>
</var>

<var>
  <name> CumulativeDose </name>
  <val> 0.0 </val>
</var>

<var>
  <name> [Semaglutide] </name>
  <val> 0.0 </val>
</var>

<var>
  <name> Sequestration </name>
</var>

<var>
  <name> Mobilization </name>
</var>

<var>
  <name> Degradation </name>
</var>

<var>
  <name> KOff </name>
  <val> 2.0 </val>
</var>

<var>
  <name> KOn </name>
  <val> 200 </val>
</var>

<var>
  <name> KDeg </name>
  <val> 20 </val>
</var>

<timervar><name> ResetDose </name><val> 0 </val><state> OFF </state></timervar>

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname><!-- ng -->
  <initialval> 0.0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 0.025 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> TakeAdultDoseNow </name>
<timer><name> ResetDose </name> <state> UP </state> </timer>

<def>
  <name> Mass </name>
  <val> Mass + ( Dose ) </val>
</def>

<def>
  <name> TimeLastDose </name>
  <val> System.X </val>
</def>

<def>
  <name> TotalDoses </name>
  <val> TotalDoses + 1.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> CumulativeDose + Dose </val>
</def>

</block>

<block><name> Wrapup </name> 
<if><test> ResetDose GE 1 </test>
<true><timer><name> ResetDose </name><val> 0 </val><state> OFF </state></timer>
<def><name> Dose </name><val> 0 </val></def></true></if></block>

<block><name> Dervs </name>
<def>
  <name> Sequestration </name>
  <val> Mass * KOn * AlbuminPool.[Alb(mmol/mL)] </val>
</def>

<def>
  <name> Mobilization </name>
  <val>  KOff </val>
</def>

<def>
  <name> Degradation </name>
  <val>  Mass * KDeg </val>
</def>

<def><name> Change </name><val>  Mobilization - Sequestration - Degradation </val></def>
<def><name> [Semaglutide] </name><val> Mass / ECFV.Vol * 243 </val></def>
</block>


<block><name> Reset </name>

<def>
  <name> TimeLastDose </name>
  <val> UNDEFINED </val>
</def>

<def>
  <name> TotalDoses </name>
  <val> 0.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> 0.0 </val>
</def>

</block>



</definitions>
</structure>

End
