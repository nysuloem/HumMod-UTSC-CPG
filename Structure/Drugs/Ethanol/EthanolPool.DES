HumMod / Chlorothiazide

Created : 02-Feb-2025
Last Modified : ---
Author : Tiff and Faria
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<structure><name> EthanolPool </name>

<variables>

<var>
  <name> [Ethanol] </name>
</var>

<var>
  <name> Gain </name>
</var>

<var>
  <name> Loss </name>
</var>

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0.0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 1.0 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> CalcConc </name>

<def>
  <name> [Ethanol] </name>
  <val> Mass / ECFV.Vol(L) </val>
</def>

</block>

<block><name> Dervs </name>

<def>
  <name> Gain </name>
  <val> EthanolGILumen.Loss
  </val>
</def>

<!-- Below Lung loss was added with an estimated constant of 0.002 -->
<def>
  <name> Loss </name>
  <val> EthanolKidney.UrineLoss 
  +   EthanolLungs.LungsLoss
  +   EthanolLiver.Loss 
  </val>
</def>

<def>
  <name> Change </name>
  <val> Gain - Loss </val>
</def>

</block>

</definitions>
</structure>

End