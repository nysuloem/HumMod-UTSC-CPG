By : University Of Mississippi Medical Center
Schema : DES V1.0

<structure><name> EthanolPool </name>

<variables>

<var><name> [Ethanol] </name></var>
<var><name> Gain </name></var>
<var><name> Loss </name></var>
<var><name> R </name></var>
<var><name> BAC </name></var>

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0.0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 1.0 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> CalcConc </name>

<def><name> R </name>
<val> 0.68 </val> <!-- Should be 0.55 for females. Will change later -->
</def>

<def>
  <name> [Ethanol] </name>
  <val> ( Mass /  ECFV.Vol(L) ) / 10 </val>  <!-- Division by 10 converts ethanol into g/dL, which is the standard BAC unit -->
</def>

</block>

<block><name> Dervs </name>

<def>
  <name> Gain </name>
  <val> EthanolGILumen.Loss
  </val>
</def>

<!-- Below Lung loss was added with an estimated constant of 0.002 -->
<def>
  <name> Loss </name>
  <val> EthanolKidney.UrineLoss 
  +   EthanolLungs.LungsLoss
  +   EthanolLiver.Loss 
  </val>
</def>

<def>
  <name> Change </name>
  <val> Gain - Loss </val>
</def>

</block>

</definitions>

</structure>

End