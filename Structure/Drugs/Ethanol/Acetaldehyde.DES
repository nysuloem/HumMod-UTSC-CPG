HumMod / Acetaldehyde

Created : 02-Feb-2025
Last Modified : ---
Author : Tiff and Faria
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<!-- Acetaldehyde is the intermediate product formed when ethanol is metabolized in the liver before 
 being further converted to acetate. This tracks production from ethanol metabolism and removal 
 via conversion to acetate.-->

<structure><name> Acetaldehyde </name>

<variables>

<var>
  <name> [Acetaldehyde] </name> <!-- Total systemic concentration in (g/L) -->
</var>

<var><name> [BloodAcetaldehyde] </name></var> <!-- Peripheral/blood concentration driving skin flow -->

<var>
  <name> Gain </name> <!-- Rate at which acetaldehyde is produced (from ethanol metabolism in liver) -->
</var>

<var>
  <name> Loss </name> <!-- Rate at which acetaldehyde is removed (converted to acetate) -->
</var>

<var><name> ExchangeRate </name></var> 

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0.0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 1.0 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> CalcConc </name>

<def>
  <name> [Acetaldehyde] </name> 
  <val> Mass / ECFV.Vol(L) </val> <!-- Divides mass by extracellular fluid volume to get concentration -->
</def>

<!-- 
Acetaldehyde concentration - base off of acetate: Periferary value + liver conc.
Blood pool concentration have an impact on blood flow


</block>

<block><name> Dervs </name>

<def>
  <name> Gain </name>
  <val> EthanolLiver.GainAcetaldehyde <!-- Ethanol metabolism via alcohol dehydrogenase (ADH) producing acetaldehyde -->
  </val>
</def>

<def>
  <name> Loss </name>
  <val> EthanolLiver.LossAcetaldehyde <!-- Rate at which acetaldehyde is removed, aldehyde dehydrogenase (ALDH) converting acetaldehyde to acetate -->
  </val>
</def>

<def>
  <name> Change </name>
  <val> Gain - Loss </val>
</def>

</block>

<!-- Create blood Acealdehyde for prephriary. Blood acealdeyhde will be used in skin blood flow to effect conducatnce-->
<!-- how does Acetyaldence get metabolized/lost after flush?? -->

</definitions>
</structure>

End