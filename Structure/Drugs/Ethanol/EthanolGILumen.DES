Schema : DES V1.0

<structure><name> EthanolGILumen </name>

<variables>

<var><name> BIOAVAIL </name><val> 0.20 </val></var>
<var><name> PERM </name><val> 0.8 </val></var>

<var><name> [Ethanol] </name></var>
<var><name> Loss </name></var>

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0.0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 1.0 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> CalcConc </name>

<def>
  <name> [Ethanol] </name>
  <val> Mass / GILumenH2O.Mass(L) </val> 
  
  <!-- What is ethanol mass? Volume or mass? Concentration?? (1L of water) 1% = 10ml --> 
<!-- Density Ethanol = 0.789 __ Mass = D X V--> 

</def>

</block>

<block><name> Dervs </name>

<def>
  <name> Loss </name>
  <val> BIOAVAIL * PERM * Mass
  </val>
</def>

<def>
  <name> Change </name>
  <val> - Loss </val>
</def>

</block>

</definitions>
</structure>

End