HumMod / Ethanol

Created : 02-Feb-2025
Last Modified : ---
Author : Tiff and Faria
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<!-- Models absorption from the GI lumen into systemic circulation,
 with concentration tracking based on lumen water content -->

<structure><name> EthanolGILumen </name>

<variables>

<var><name> BIOAVAIL </name><val> 1 </val></var> <!-- Fraction of the ethanol dose that reaches systemic circulation-->
<var><name> PERM </name><val> 1 </val></var> <!-- Permeability factor for ethanol across the GI wall -->

<var><name> [Ethanol] </name></var>
<var><name> Loss </name></var> <!-- Amount of ethanol leaving the lumen per unit time -->

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0.0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 1.0 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> CalcConc </name>

<def>
  <name> [Ethanol] </name>
  <val> Mass / GILumenH2O.Mass(L) </val> <!-- Converts ethanol mass into a concentration using the lumen’s water mass (volume).-->
  
  <!-- What is ethanol mass? Volume or mass? Concentration?? (1L of water) 1% = 10ml --> 
<!-- Density Ethanol = 0.789 __ Mass = D X V--> 

</def>

</block>

<block><name> Dervs </name>

<def>
  <name> Loss </name>
  <val> BIOAVAIL * PERM * Mass <!-- Proportional loss from lumen depends on both bioavailability and permeability, and is scaled to the total ethanol mass present -->
  </val>
</def>

<def>
  <name> Change </name>
  <val> - Loss </val> 
</def>

</block>

</definitions>
</structure>

End