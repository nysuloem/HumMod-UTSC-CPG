HumMod / Ethanol

Created : 02-Feb-2025
Last Modified : ---
Author : Tiff and Faria
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0


<structure><name> EthanolSingleDose </name>

<variables>

<parm><name> Volume </name><val> 0 </val></parm>
<var><name> %Alc </name><val> 5.0 </val></var>
<var><name> TimeLastDose </name><val> UNDEFINED </val></var>
<var><name> TotalDrinks </name><val> 0.0 </val></var>
<var><name> CumulativeDose </name><val> 0.0 </val></var>
<var><name> Mass </name><val> 0 </val></var>
<timervar><name> ResetSingleDose </name><val> 0 </val><state> OFF </state></timervar>
<var><name> TotalConsumedMass </name><val> 0 </val></var>

</variables>

<definitions>

<block><name> TakeDoseNow </name>

<def>
  <name> Mass </name>
  <val> ( %Alc / 100 ) * ( Volume * EthanolDailyDose.Density_ETOH ) </val>
</def>

<timer><name> ResetSingleDose </name>
  <state> UP </state>
</timer>

<def>
  <name> TimeLastDose </name>
  <val> System.X </val>
</def>

<def>
  <name> TotalDrinks </name>
  <val> TotalDrinks + 1.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> CumulativeDose + Mass </val>
</def>

</block>

<block><name> Wrapup </name>
  <if><test> ResetSingleDose GE 1 </test>
    <true>
      <timer><name> ResetSingleDose </name>
        <val> 0 </val>
        <state> OFF </state>
      </timer>
      <def><name> Mass </name>
        <val> 0 </val>
      </def>
    </true>
  </if>
</block>

<block><name> Reset </name>

<def>
  <name> TimeLastDose </name>
  <val> UNDEFINED </val>
</def>

<def>
  <name> TotalDrinks </name>
  <val> 0.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> 0.0 </val>
</def>

</block>

</definitions>

</structure>

End