By : University Of Mississippi Medical Center
Schema : DES V1.0

<!-- Simulate a single ethanol ingestion event without timers, schedules, or repeated dosing -->

<structure><name> EthanolSingleDose </name>

<variables>

<parm><name> Volume </name><val> 500 </val></parm> <!-- volume of the drink (default 500 mL) -->
<parm><name> %Alc </name><val> 5.0 </val></parm> <!-- percent alcohol by volume (default 5.0%, typical beer) -->
<var><name> TimeLastDose </name><val> UNDEFINED </val></var>
<var><name> TotalDrinks </name><val> 0.0 </val></var>
<var><name> CumulativeDose </name><val> 0.0 </val></var>
<var><name> Mass </name></var>

<parm><name> Dummy </name><val> 0 </val></parm>

</variables>

<definitions>

<block><name> TakeDoseNow </name>

<def>
  <name> Mass </name>
  <val> ( %Alc / 100 ) * ( Volume * EthanolDailyDose.Density_ETOH ) </val> <!-- Calculate ethanol mass in grams --> 
  <!-- %Alc / 100 → converts % to fraction. 
   Volume (mL) × Density_ETOH (0.789 g/mL) is the grams of pure ethanol if it were 100% alcohol.
   Multiply by fraction alcohol to get grams of ethanol in the drink.-->
</def>

<def>
  <name> EthanolGILumen.Mass </name> 
  <val> EthanolGILumen.Mass + Mass </val> <!-- Add ethanol to the GI lumen -->
</def>

<def>
  <name> TimeLastDose </name>
  <val> System.X </val>
</def>

<def>
  <name> TotalDrinks </name>
  <val> TotalDrinks + 1.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> CumulativeDose + Mass </val>
</def>

</block>

<!--<block><name> Parms </name>

<onjustchanged><name> Dummy </name>
<def><name> EthanolGILumen.Mass </name><val> EthanolGILumen.Mass + (  Dose * Dummy )  </val></def>
<def><name> TotalDoses </name><val> TotalDoses + Dummy </val></def>
<def><name> CumulativeDose </name><val> CumulativeDose + ( Dummy * Dose ) </val></def>
<def><name> TimeLastDose </name><val> System.X </val></def>
<def><name> Dummy </name><val> 0 </val></def>
</onjustchanged>
</block>-->

<block><name> Reset </name>

<def>
  <name> TimeLastDose </name>
  <val> UNDEFINED </val>
</def>

<def>
  <name> TotalDrinks </name>
  <val> 0.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> 0.0 </val>
</def>

</block>

</definitions>
</structure>

End