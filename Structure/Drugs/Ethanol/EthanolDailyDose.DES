HumMod / Ethanol

Created : 02-Feb-2025
Last Modified : ---
Author : Tiffany and Faria
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<!-- Simulates oral ethanol dosing over time (daily, multiple times per day, or irregularly) -->

<structure><name> EthanolDailyDose </name>

<variables>

<parm><name> Dose </name><val> 0.0 </val></parm> <!-- Size of each drink (volume in mL) -->
<parm><name> TakeDaily </name><val> FALSE </val></parm>
<parm><name> TimesADay </name><val> 1.0 </val></parm>
<var><name> TimeLastDose </name><val> UNDEFINED </val></var>
<var><name> TimeNextDose </name><val> UNDEFINED </val></var>
<var><name> TotalDoses </name><val> 0.0 </val></var>
<var><name> CumulativeDose </name><val> 0.0 </val></var>
<var><name> LastCumulativeDose </name><val> 0.0 </val></var> <!-- Added -->
<constant><name> Density_ETOH </name><val> 0.789 </val></constant> <!-- 0.789 g/mL (ethanol density, used to convert volume to grams).-->
<var><name> Mass </name><val> 0 </val></var>
<var><name> DaysSober </name><val> 0 </val></var> <!-- Added -->

<timervar><name> Timer </name><val> 0.0 </val><state> OFF </state></timervar>
<var><name> Interval </name></var>
<constant><name> PREPTIME </name><val> 10.0 </val></constant>

<!--  Flag determining irregular dosing -->
<parm><name> IrregularQ </name><val> 0 </val></parm>
<var><name> PercentageofAlcohol </name> <val> 5.0 </val></var> <!-- % ethanol in the drink (default 0.07 = 7%, like beer)-->
<parm><name> NumberLeft </name><val> 0 </val></parm>
<parm><name> NumberGiven </name><val> 0 </val></parm>
<whitenoise><name> Likelihood </name></whitenoise>
<parm><name> PercentChance </name><val> 1 </val></parm>
<timervar><name> ResetDailyDose </name><val> 0 </val><state> OFF </state></timervar>
<timervar><name> SoberDayTimer </name><val> 0 </val><state> OFF </state></timervar> <!-- Added -->

</variables>

<definitions>

<block><name> Parms </name>

<onjustchanged><name> TakeDaily </name>

<if><test> TakeDaily GT 0 </test>
  <true>
    <timer>
      <name> Timer </name>
      <val> PREPTIME </val>
      <state> DOWN </state>
    </timer>

  <def>
    <name> TimeNextDose </name>
    <val> System.X + PREPTIME </val>
  </def>

  <def>
    <name> NumberLeft </name>
    <val> NumberLeft + NumberGiven </val>
  </def>

  </true>

  <false>

<timer>
  <name> Timer </name>
  <state> OFF </state>
</timer>

<def>
  <name> TimeNextDose </name>
  <val> UNDEFINED </val>
</def>

</false>

</if>

<timer>
   <name> SoberDayTimer </name>
   <val> 1440 </val>
   <state> DOWN </state>
</timer>

</onjustchanged>

</block>

<block><name> Wrapup </name>

<ontimedout><name> Timer </name>

<def>
  <name> Interval </name>
  <val> 1440.0 / TimesADay </val> <!-- Caculates interval (1440 minutes/day ÷ doses/day = minutes between doses) -->
</def>

<if>
  <test> ( Likelihood LE PercentChance ) OR ( TakeDaily EQ 1 ) OR ( TakeDaily EQ 2 ) OR ( EthanolBrain.Craving GT 0.5 ) </test>
  <true>
     <call> TakeFullDose </call>
  </true>
  <false>
   <timer>
    <name> Timer </name>
    <val> Interval </val>
  </timer>
</false>
</if>
<!--If craving GT the threshold (0.5), then craving will determine drink, allows patient to be internally driven -->
</ontimedout>

<ontimedout>
<name> SoberDayTimer </name>
<if>
<test> CumulativeDose LE LastCumulativeDose </test>
<true>
   <def>
      <name> DaysSober </name>
      <val> DaysSober + 1 </val>
   </def>
</true>
<false>
   <def>
      <name> DaysSober </name>
      <val> 0 </val>
   </def>
</false>
</if>
<def>
   <name> LastCumulativeDose </name>
   <val> CumulativeDose </val>
</def>
<timer>
   <name> SoberDayTimer </name>
   <val> 1440 </val>
   <state> DOWN </state>
</timer>
</ontimedout>

<if><test> ResetDailyDose GE 1 </test>
  <true> 
    <timer><name> ResetDailyDose </name>
      <val> 0 </val>
      <state> OFF </state>
    </timer>
    <def><name> Mass </name>
      <val> 0 </val>
    </def>
    </true>
  </if>
</block>

<block><name> TakeFullDose </name>

<timer>
  <name> Timer </name>
  <val> Interval </val>
</timer>

<def>
  <name> TimeLastDose </name>
  <val> System.X </val>
</def>

<def>
  <name> TimeNextDose </name>
  <val> System.X + Interval </val>
</def>

<!--
<def>
  <name> EthanolGILumen.Mass </name>
  <val> EthanolGILumen.Mass + ( Dose * Density_ETOH * ( PercentageofAlcohol / 100 ) ) </val> 
   Takes a drink amount (volume mL) and converts into grams of ethanol, 
   then adds to the ethanol already in the GI lumen.
</def>
--> 

<def>
  <name> Mass </name>
  <val> ( PercentageofAlcohol / 100 ) * ( Dose * EthanolDailyDose.Density_ETOH ) </val> <!-- Calculate ethanol mass in grams --> 
  <!-- %Alc / 100 → converts % to fraction. 
   Volume (mL) × Density_ETOH (0.789 g/mL) is the grams of pure ethanol if it were 100% alcohol.
   Multiply by fraction alcohol to get grams of ethanol in the drink.-->
</def>

<timer><name> ResetDailyDose </name>

  <state> UP </state>
</timer>

<def>
  <name> TotalDoses </name>
  <val> TotalDoses + 1.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> CumulativeDose + Dose </val>
</def>

<def>
  <name> NumberLeft </name>
  <val> NumberLeft - 1 </val>
</def>

</block>

<block><name> Reset </name>

<def>
  <name> TimeLastDose </name>
  <val> UNDEFINED </val>
</def>

<def>
  <name> TotalDoses </name>
  <val> 0.0 </val>
</def>

<def>
  <name> CumulativeDose </name>
  <val> 0.0 </val>
</def>

<!-- Added below in block Reset -->
<def>
  <name> LastCumulativeDose </name>
  <val> 0.0 </val>
</def>

<def>
  <name> DaysSober </name>
  <val> 0 </val>
</def>

<!-- Added above -->

</block>

<block><name> RenewScript </name>

<def><name> NumberLeft </name><val> NumberLeft + NumberGiven </val></def>

</block>

</definitions>

</structure>

End