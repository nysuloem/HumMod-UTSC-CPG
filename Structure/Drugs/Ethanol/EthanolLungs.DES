<structure><name> EthanolLungs </name>

<variables>

<constant><name> K </name><val> 0.00008 </val></constant>

</variables>

<equations>

<diffeq>
<name> AUC </name>
<integralname> AUC </integralname>
<initialval> 0 </initialval>
<dervname> LungsLoss  </dervname>
<errorlim> 0.0001 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> Dervs </name>

  <def><name> LungsLoss </name>
    <val> K * EthanolPool.[Ethanol] </val>
  </def> 

</block>

</definitions>

</structure>

End