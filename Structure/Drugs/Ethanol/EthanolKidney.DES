Schema : DES V1.0

<structure><name> EthanolKidney </name>

<variables>

<var><name> UrineLoss </name></var>

<constant><name> K </name><val> 0.06 </val>  <!-- Ethanol clearance rate --> </constant>

</variables>

<definitions>

<block><name> Dervs </name>

<def>
  <name> UrineLoss </name>
  <val>
      K
    * EthanolPool.Mass
    * ( ( LeftGlomerulusFiltrate.GFRxNormal * LeftKidney-Function.Effect )
           + ( RightGlomerulusFiltrate.GFRxNormal * RightKidney-Function.Effect ) )
  </val>
</def> 

</block>

</definitions>

</structure>

End