By : University Of Mississippi Medical Center
Schema : DES V1.0

<structure><name> EthanolKidney </name>

<variables>

<constant><name> K </name><val> 0.0001 </val>  <!-- Ethanol clearance rate --> </constant>

</variables>

<equations>

<diffeq>
<name> AUC </name>
<integralname> AUC </integralname>
<initialval> 0 </initialval>
<dervname> UrineLoss  </dervname>
<errorlim> 0.0001 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> Dervs </name>

  <def>
    <name> UrineLoss </name>
      <val>
          K
        * EthanolPool.[Ethanol]
        * ( ( LeftGlomerulusFiltrate.GFRxNormal * LeftKidney-Function.Effect )
        + ( RightGlomerulusFiltrate.GFRxNormal * RightKidney-Function.Effect ) )
      </val>
  </def> 

</block>

</definitions>

</structure>

End