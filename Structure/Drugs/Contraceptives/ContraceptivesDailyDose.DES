HumMod / ContraceptivesDailyDose

Created : 05-Jun-06
Revised : 2012-08-09
Author : N Sufian
Copyright : 2006-2012
By : University Of Mississippi Medical Center

<structure><name> ContraceptivesDailyDose </name>

<variables>

  <parm><name> EstrogenDose </name><val> 0.0 </val></parm>
  <parm><name> ProgesteroneDose </name><val> 0.0 </val></parm>
  <parm><name> TakeDaily </name><val> FALSE </val></parm>
  <parm><name> TimesADay </name><val> 1.0 </val></parm>
  <var><name> TimeLastDose </name><val> UNDEFINED </val></var>
  <var><name> TimeNextDose </name><val> UNDEFINED </val></var>
  <var><name> TotalDoses </name><val> 0.0 </val></var>
  <var><name> RealDose </name><val> 0.0 </val></var>
  <var><name> FakeDose </name><val> 0.0 </val></var>
  <timervar><name> Timer </name><val> 0.0 </val><state> OFF </state></timervar>
  <var><name> Interval </name></var>
  <constant><name> PREPTIME </name><val> 10.0 </val></constant>
  <parm><name> Brand </name><val> 0 </val></parm>

  <!--  Flag determining irregular dosing -->
  <parm><name> IrregularQ </name><val> 0 </val></parm>

  <parm><name> NumberLeft </name><val> 0 </val></parm>
  <parm><name> NumberGiven </name><val> 28 </val></parm>
  <whitenoise><name> Likelihood </name></whitenoise>
  <parm><name> PercentChance </name><val> 1 </val></parm>

</variables>

<definitions>

<block><name> Parms </name>

  <onjustchanged><name> TakeDaily </name>
    <call> Dose </call>
  </onjustchanged>

  <onjustchanged><name> Brand </name>
    <call> Dose </call>
  </onjustchanged>

</block>

<block><name> Dose </name>

  <if><test> TakeDaily GT 0 </test>

    <true>

      <call> Brand </call>

    <timer>
      <name> Timer </name>
      <val> PREPTIME </val>
      <state> DOWN </state>
    </timer>

    <def>
      <name> TimeNextDose </name>
      <val> System.X + PREPTIME </val>
    </def>

    </true>

    <false>

    <timer>
      <name> Timer </name>
      <state> OFF </state>
    </timer>

    <def>
      <name> TimeNextDose </name>
      <val> UNDEFINED </val>
    </def>

    </false>

  </if>

</block>

<block><name> Brand </name>

  <testcase>

      <case>
      <test> Brand EQ 0 </test>
      <def><name> EstrogenDose </name><val> 20 </val></def>
      <def><name> ProgesteroneDose </name><val> 1 </val></def>
      </case>

      <case>
      <test> Brand EQ 1 </test>
      <def><name> EstrogenDose </name><val> 20 </val></def>
      <def><name> ProgesteroneDose </name><val> 0.1 </val></def>
      </case>

      <case>
      <test> Brand EQ 2 </test>
      <def><name> EstrogenDose </name><val> 30 </val></def>
      <def><name> ProgesteroneDose </name><val> 3 </val></def>
      </case>

      <case>
      <test> Brand EQ 3 </test>
      <def><name> EstrogenDose </name><val> 0 </val></def>
      <def><name> ProgesteroneDose </name><val> 3 </val></def>
      </case>

    </testcase>

</block>

<block><name> Wrapup </name>

  <ontimedout><name> Timer </name>

  <def>
    <name> Interval </name>
    <val> 1440.0 / TimesADay </val>
  </def>

  <if>
    <test> ( Likelihood LE PercentChance ) OR ( TakeDaily EQ 1 ) OR ( TakeDaily EQ 2 ) </test>
    <true>
      <call> TakeFullDose </call>
    </true>
    <false>
    <timer>
      <name> Timer </name>
      <val> Interval </val>
    </timer>
  </false>
  </if>
  </ontimedout>

</block>

<block><name> TakeFullDose </name>

  <timer>
    <name> Timer </name>
    <val> Interval </val>
  </timer>

  <def>
    <name> TimeLastDose </name>
    <val> System.X </val>
  </def>

  <def>
    <name> TimeNextDose </name>
    <val> System.X + Interval </val>
  </def>

  <if> <test> RealDose LT 21 </test>

    <true>

    <def>
      <name> ContraceptivesGILumen.EstrogenMass </name>
      <val> ContraceptivesGILumen.EstrogenMass + EstrogenDose </val>
    </def>

     <def>
      <name> ContraceptivesGILumen.ProgesteroneMass </name>
      <val> ContraceptivesGILumen.ProgesteroneMass + ProgesteroneDose </val>
    </def>

    <def>
      <name> RealDose </name>
      <val> RealDose + 1 </val>
    </def>

    <def>
      <name> NumberLeft </name>
      <val> NumberLeft - 1 </val>
    </def>

    <def><name> TotalDoses </name>
      <val> TotalDoses + 1 </val>
    </def>

    </true>

    <false> 

    <def>
      <name> FakeDose </name>
      <val> FakeDose + 1 </val>
    </def>

    <def>
      <name> NumberLeft </name>
      <val> NumberLeft - 1 </val>
    </def>

    </false>

    </if>

    <if> <test> FakeDose GE 7 </test>
    <true>
    <call> Reset </call>
    </true>
    </if>

</block>

<block><name> Reset </name>

  <def>
    <name> TimeLastDose </name>
    <val> UNDEFINED </val>
  </def>

  <def>
    <name> FakeDose </name>
    <val> 0.0 </val>
  </def>

  <def>
    <name> RealDose </name>
    <val> 0.0 </val>
  </def>

</block>

<block><name> RenewScript </name>

  <def><name> NumberLeft </name><val> NumberLeft + 28 </val></def>

</block>

</definitions>

</structure>

End