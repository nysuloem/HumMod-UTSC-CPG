Schema : DES V1.0

<structure><name> ContraceptivesGILumen </name>

<variables>

<constant>
  <name> BIOAVAIL </name>
  <val> 1 </val>
</constant>

<constant>
  <name> PERM </name>
  <val> 1 </val>
</constant>

<var>
  <name> [Contraceptives] </name>
</var>

<var>
  <name> Loss </name>
</var>

<var>
  <name> EstradiolLoss </name>
</var>

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0.0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 0.01 </errorlim>
</diffeq>

<diffeq>
  <name> EstradiolMass </name>
  <integralname> EstradiolMass </integralname>
  <initialval> 0.0 </initialval>
  <dervname> EstradiolChange </dervname>
  <errorlim> 0.01 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> CalcConc </name>

<def>
  <name> [Contraceptives] </name>
  <val> Mass / GILumenH2O.Mass(L) </val>
</def>

</block>

<block><name> Dervs </name>

<def>
  <name> Loss </name>
  <val> BIOAVAIL * PERM * Mass  </val>
</def>

<def>
  <name> EstradiolLoss </name>
  <val> BIOAVAIL * PERM * EstradiolMass </val>
</def>

<def>
  <name> Change </name>
  <val> - Loss </val>
</def>

<def>
  <name> EstradiolChange </name>
  <val> - EstradiolLoss </val>
</def>

</block>

</definitions>
</structure>

End