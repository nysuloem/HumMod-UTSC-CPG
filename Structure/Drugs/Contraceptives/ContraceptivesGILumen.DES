Schema : DES V1.0

<structure><name> ContraceptivesGILumen </name>

<variables>

  <constant><name> BIOAVAIL </name><val> 1 </val></constant>
  <constant><name> PERM </name><val> 1 </val></constant>
  <var><name> EstrogenLoss </name></var>
  <var><name> ProgesteroneLoss </name></var>

</variables>

<equations>

  <diffeq>
    <name> EstrogenMass </name>
    <integralname> EstrogenMass </integralname>
    <initialval> 0.0 </initialval>
    <dervname> EstrogenChange </dervname>
    <errorlim> 0.01 </errorlim>
  </diffeq>

   <diffeq>
    <name> ProgesteroneMassMass </name>
    <integralname> ProgesteroneMass </integralname>
    <initialval> 0.0 </initialval>
    <dervname> ProgesteroneChange </dervname>
    <errorlim> 0.01 </errorlim>
  </diffeq>

</equations>

<definitions>

<block><name> Dervs </name>

  <def>
    <name> EstrogenLoss </name>
    <val> BIOAVAIL * PERM * EstrogenMass  </val>
  </def>

  <def>
    <name> EstrogenChange </name>
    <val> - EstrogenLoss </val>
  </def>

   <def>
    <name> ProgesteroneLoss </name>
    <val> BIOAVAIL * PERM * ProgesteroneMass  </val>
  </def>

  <def>
    <name> ProgesteroneChange </name>
    <val> - ProgesteroneLoss </val>
  </def>

</block>

</definitions>

</structure>

End