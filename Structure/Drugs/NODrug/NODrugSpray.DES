
<structure><name> NODrugSpray </name>

<variables>

  <parm><name> Dose </name><val> 0.0 </val></parm>
  <parm><name> TakeDaily </name><val> FALSE </val></parm>
  <parm><name> TimesADay </name><val> 1.0 </val></parm>
  <var><name> TimeLastDose </name><val> UNDEFINED </val></var>
  <var><name> TimeNextDose </name><val> UNDEFINED </val></var>
  <var><name> TotalDoses </name><val> 0.0 </val></var>
  <var><name> CumulativeDose </name><val> 0.0 </val></var>
  <timervar><name> Timer </name><val> 0.0 </val><state> OFF </state></timervar>
  <timervar><name> ResetDoseMass </name><val> 0 </val><state> OFF </state></timervar>
  <var><name> Interval </name></var>
  <constant><name> PREPTIME </name><val> 0.5 </val></constant>
  <var><name> Mass </name><val> 0 </val></var>

</variables>

<definitions>

<block><name> Parms </name>

  <onjustchanged><name> TimesADay </name>

  <if><test> TakeDaily EQ 1 </test>
    <true>

      <def>
        <name> Interval </name>
        <val> 1440 / TimesADay </val>
      </def>

      <timer>
        <name> Timer </name>
          <val> PREPTIME </val>
          <state> DOWN </state>
      </timer>

      <def>
        <name> TimeNextDose </name>
        <val> System.X + PREPTIME </val>
      </def>

    </true>

    <false>

      <timer>
        <name> Timer </name>
        <state> OFF </state>
      </timer>

      <def>
        <name> TimeNextDose </name>
        <val> UNDEFINED </val>
      </def>

    </false>

  </if>

  </onjustchanged>

    <onjustchanged><name> TakeDaily </name>

      <if><test> TakeDaily EQ 1 </test>
        
        <true>

        <def>
          <name> Interval </name>
          <val> 1440 / TimesADay </val>
        </def>

        <timer>
          <name> Timer </name>
            <val> PREPTIME </val>
            <state> DOWN </state>
        </timer>

        <def>
          <name> TimeNextDose </name>
          <val> System.X + PREPTIME </val>
        </def>

        </true>

      <false>

        <timer>
          <name> Timer </name>
          <state> OFF </state>
        </timer>

        <def>
          <name> TimeNextDose </name>
          <val> UNDEFINED </val>
        </def>

      </false>
    
    </if>

    </onjustchanged>

</block>

<block><name> Wrapup </name>

  <ontimedout><name> Timer </name>

  <def>
    <name> Interval </name>
    <val> 1440.0 / TimesADay </val> 
  </def>
  
  <if><test> TakeDaily EQ 1 </test>
    <true>
      <call> SprayNow </call>
    </true>
  </if>
  
  </ontimedout>

  <if><test> ResetDoseMass GE 1 </test>
  <true> 
    <timer><name> ResetDoseMass </name>
      <val> 0 </val>
      <state> OFF </state>
    </timer>
    <def><name> Mass </name>
      <val> 0 </val>
    </def>
    </true>
  </if>

</block>

<block><name> SprayNow </name>

  <timer>
    <name> Timer </name>
    <val> Interval </val>
  </timer>

  <def>
    <name> TimeLastDose </name>
    <val> System.X </val>
  </def>

  <def>
    <name> TimeNextDose </name>
    <val> System.X + Interval </val>
  </def>

  <def>
    <name> Mass </name>
    <val> Dose </val>
  </def>

  <!-- If we assume instantenous absorption into the blood, then Mass = Rate -->

  <timer><name> ResetDoseMass </name>
    <state> UP </state>
  </timer>

  <def>
    <name> TotalDoses </name>
    <val> TotalDoses + 1.0 </val>
  </def>

  <def>
    <name> CumulativeDose </name>
    <val> CumulativeDose + Dose </val>
  </def>

</block>

<block><name> Reset </name>

    <def>
      <name> TimeLastDose </name>
      <val> UNDEFINED </val>
    </def>

    <def>
      <name> TotalDoses </name>
      <val> 0.0 </val>
    </def>

    <def>
      <name> CumulativeDose </name>
      <val> 0.0 </val>
    </def>

</block>

</definitions>

</structure>

End
