Hummod / NTGPool

<structure><name> NTGPool </name>

 <variables>
  <var><name> NTGIV </name><val> 0 </val></var>
  <var><name> NTGOral </name><val> 0 </val></var>
</variables>
 
<equations>

    <diffeq>
        <name> NTGmass </name>
        <integralname> NTGmass </integralname> <!-- in mcg -->
        <initialval> 0.0 </initialval>
        <dervname> NTGIntake </dervname>
        <errorlim> 0.5 </errorlim>
      </diffeq>
</equations>


<definitions>

<block><name> Dervs </name>
  <def><name> NTGIV </name><val> NODrugIV.CumulativeDose </val></def>
  <def><name> NTGOral </name><val> NODrugSL.Mass / 1000 </val></def>
  <def><name> NTGIntake </name><val> NTGIV + NTGOral </val></def>
</block>

</definitions>
</structure>
End
