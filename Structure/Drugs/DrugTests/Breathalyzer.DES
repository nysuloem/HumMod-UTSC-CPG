<structure><name> Breathalyzer </name>

<variables>
    <var><name> BreathEthanol </name></var> 
</variables>

<definitions>
<block>
    <name> BreathCalculation </name>

<def>
    <name> BreathEthanol </name>
    <val> EthanolLungs.LungsLoss / LungVolumes.TotalCapacity </val>
    <!-- The rate of ethanol leaving the body through exhalation divided by total lung volume
    This converts an ethanol loss amount into a concentration per liter of air -->
    </def>
    </block>
<!-- units -->
<!-- estimated BAC based from legal conversion (breath ethanol x 2100-) Compare to actual BAC we are measuring -->
<!-- Sex effects vs race effects -->
 
  </definitions>

</structure>