HumMod / A-VFistula-Flow

Created : 2010-05-20
Last Modified : 2010-05-20
Author : Tom Coleman
Copyright : 2006-2010
By : University Of Mississippi Medical Center

<structure><name> A-VFistula-Flow </name>

<variables>

<var><name> Conductance </name></var>

<parm>
  <name> BasicConductance </name>
  <val> 0.0 </val>
</parm>

<var><name> BloodFlow </name></var>
<var><name> PlasmaFlow </name></var>

<var><name> NOEffect </name></var>

</variables>

<equations>

<diffeq>
  <name> ConductanceDelay </name>
  <integralname> ConductanceDelay </integralname>
  <initialval> 0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 0.5 </errorlim>
</diffeq>
</equations>

<functions>

<curve>
  <name> NOOnConductance </name>
  <point><x> 0.00 </x><y> 0.80 </y><slope> 0.0 </slope></point>
  <point><x> 0.05 </x><y> 1.00 </y><slope> 6.0 </slope></point> <!-- baseline -->
  <point><x> 0.10 </x><y> 1.25 </y><slope> 3.0 </slope></point>
  <point><x> 0.15 </x><y> 1.40 </y><slope> 1.0 </slope></point>
  <point><x> 0.20 </x><y> 1.50 </y><slope> 0.0 </slope></point>
  <point><x> 1.00 </x><y> 1.50 </y><slope> 0.0 </slope></point>
</curve>

</functions>

<definitions>
<block><name> Calc </name>

<def><name> Change </name><val> 0.75 * ( BasicConductance - ConductanceDelay ) </val></def>

<def>
  <name> NOEffect </name>
  <val> NOOnConductance [ NOPool.[NO--] ] </val>
</def>

<def>
  <name> Conductance </name>
  <val>
      ConductanceDelay
    * NOEffect
    * Viscosity.ConductanceEffect
  </val>
</def>

<def>
  <name> BloodFlow </name>
  <val> ( A-VFistula-Pressure.PressureGradient * Conductance ) MAX 0.0 </val>
</def>

<def>
  <name> PlasmaFlow </name>
  <val> BloodFlow * BloodVol.PVCrit </val>
</def>

</block>
</definitions>
</structure>

End
