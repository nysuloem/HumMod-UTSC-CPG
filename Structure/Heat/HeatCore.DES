HumMod / HeatCore

Created : 27-Mar-05
Last Modified : 26-Jan-10
Author : Tom Coleman
Copyright : 2008-2010
By : University of Mississippi Medical Center
Schema : DES V1.0

<structure><name> HeatCore </name>

<variables>

<var><name> Temp(F) </name></var>
<var><name> Temp(C) </name></var>
<var><name> Temp(K) </name></var>

<var><name> Flux </name></var>
<var><name> Gain </name></var>
<var><name> Loss </name></var>

<var><name> InitialTemp(C) </name><val> 36.7 </val></var>
<var><name> InitialTemp(K) </name><val> 309.85 </val></var>

<var><name> InitialMass </name></var>

<parm><name> FeverLevel </name><val> 0 </val></parm>

<var><name> FeverEffect </name></var>

</variables>

<functions>

  <curve>
  <name> FeverEffect </name>
  <point><x>  0.0 </x><y> 1.0 </y><slope> 0 </slope></point>
  <point><x> 1.0 </x><y> 0.4 </y><slope> 0 </slope></point>
  <point><x> 2.0 </x><y> 0.29 </y><slope> 0 </slope></point>
  </curve>

</functions>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <dervname> Change </dervname>
  <errorlim> 123.0 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> Initialize </name>

<def>
  <name> InitialMass </name>
  <val>
       Weight.InitialCore
     * SpecificHeat.Tissue(kCal/G)
     * InitialTemp(K)
  </val>
</def>

<def>
  <name> Mass </name>
  <val> InitialMass </val>
</def>

<def>
  <name> Temp(K) </name>
  <val> InitialTemp(K) </val>
</def>

<def>
  <name> Temp(C) </name>
  <val> InitialTemp(C) </val>
</def>

</block>

<block><name> CalcTemp </name>

<def>
  <name> Temp(K) </name>
  <val> Mass / ( Weight.Core(kG) * SpecificHeat.Tissue ) </val>
</def>

<def>
  <name> Temp(C) </name>
  <val> Temp(K) - 273.15 </val>
</def>

<def>
  <name> Temp(F) </name>
  <val> ( 9 / 5 ) * Temp(C) + 32.0 </val>
</def>

</block>

<block><name> Flux </name>

  <def><name> FeverEffect </name>
  <val> FeverEffect [ HeatCore.FeverLevel ] </val>
  </def>

<def>
  <name> Flux </name>
  <val>
    ( Skin-Flow.BloodFlow / 1000.0 + 0.045 )
    * ( HeatCore.Temp(K) - HeatSkin.Temp(K) )
    * SpecificHeat.Blood
    * FeverEffect
  </val>
</def>

</block>

<block><name> Dervs </name>

<def>
  <name> Gain </name>
  <val>
      Metabolism-CaloriesUsed.CoreHeat(kCal/Min)
    + HeatSkeletalMuscle.Flux
    + GILumenHeat.Absorption
    + HeatIVDrip.FluxToCore
    + HeatTransfusion.Flux
  </val>
</def>

<def>
  <name> Loss </name>
  <val>
      Flux
    + HeatInsensibleLung.Flux
    + HeatUrine.Flux
    + HeatDialyzer.Flux
    + HeatHemorrhage.Flux
 </val>
</def>

<def>
  <name> Change </name>
  <val> Gain - Loss   </val>
</def>

</block>

</definitions>
</structure>

End