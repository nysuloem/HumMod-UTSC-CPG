<structure><name> BrainInsult-Ethanol </name>

<variables>

<var><name> Effect </name></var>

</variables>

<functions>
 
<curve>
  <name> Intoxication </name>
  <point><x> 0 </x><y> 1.0 </y><slope> 0 </slope></point>
  <point><x> 0.05 </x><y> 0.8 </y><slope> 0 </slope></point>
</curve>

</functions>

<!-- Effect from intoxication related to long term consumption
 Wont get as intoxicated after drinking long term consumption, plot effect over time -->

<definitions>

<block><name> Calc </name>

<def>
  <name> Effect </name>
  <val> 1 - ( ( 1 - Intoxication [ EthanolPool.[Ethanol] ] ) / ( 1 + EthanolBrain.LongTermExposure ) ) </val>
</def>
<!--(1 - Intoxication) calculates the reduction from normal brain function caused by the current BAC
Divide impairment by (1 + LongTermExposure) to represent tolerance
Subtract adjusted impairment from 1 so that BAC = 0 returns the brain effect to a value of 1

Tried: 1 - ( ( 1 - Intoxication [ EthanolPool.[Ethanol] ] ) / ( 1 + EthanolBrain.LongTermExposure ) )  THEN   Intoxication [ EthanolPool.[Ethanol] ] / ( 1 + EthanolBrain.LongTermExposure )-->
 <!-- Try multiplying by LTE, when no alcohol in system, brain effect should be 1 (functioning fine) -->

</block>

</definitions>

</structure>

End