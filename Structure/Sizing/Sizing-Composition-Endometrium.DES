HumMod / Sizing-Composition-Uterus

Created : 2013-03-01
Revised : 2013-03-01
Author : Tom Coleman
Copyright : 2013-2013
By : Tom Coleman

<structure><name> Sizing-Composition-Endometrium </name>

<variables>

<var><name> Mass </name></var>
<var><name> LiquidVol </name></var>
<var><name> SolidMass </name></var>

<var><name> H2OFractMass </name><val> 0.001 </val></var>
<!-- changed to represent male at initiation -->
</variables>

<definitions>

<block><name> Calc </name>
<!-- conditional for conditional uterus -->
<conditional> 
<name> H2OFractMass </name>
<test> Context-Sex.Index EQ 1 </test>
<true> 0.67 </true>
<false> 0.001 </false>
</conditional>

<conditional> 
<name> Mass </name>
<test> Context-Sex.Index EQ 1 </test>
<true> Sizing-OrganMass.Endometrium_Mass </true>
<false> 0.001 </false>
</conditional>
<!-- 
<def>
  <name> Mass </name>
  <val> Sizing-OrganMass.Uterus_Mass </val>
</def>
-->

<conditional> 
<name> H2OFractMass </name>
<test> Context-Sex.Index EQ 1 </test>
<true> 0.67 </true>
<false> 0.001 </false>
</conditional>


<def>
  <name> LiquidVol </name>
  <val> H2OFractMass * Mass / Density.H2O </val>
</def>


<conditional> 
<name> SolidMass </name>
<test> Context-Sex.Index EQ 1 </test>
<true> ( 1 - H2OFractMass ) * Mass </true>
<false> 0.001 </false>
</conditional>

<def>
  <name> Uterus-Size.InitialMass </name>
  <val> Mass </val>
</def>


<def>
  <name> Endometrium-Size.InitialLiquidVol </name>
  <val> LiquidVol </val>
</def>


<def>
  <name> Endometrium-Size.InitialSolidMass </name>
  <val> SolidMass </val>
</def>

<if> 
<test> Context-Sex.Index EQ 1 </test>
<true> <call> Endometrium-Size.Init </call> </true>

</if>

</block>

</definitions>
</structure>

End