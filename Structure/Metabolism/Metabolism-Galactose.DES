<structure><name> Metabolism-Galactose </name>

<variables>

<var><name> TotalBurn </name></var>
<var><name> GalactoseBurn </name></var>

<var><name> TotalUptake </name></var>
<var><name> GalactoseUptake </name></var>

</variables>

<definitions>
<block><name> Calc </name>

<def><name> GalactoseBurn </name>
  <val>
     Liver-Fuel.TotalGalactoseUsed(mG/Min)
  </val>
</def>

<def><name> GalactoseUptake </name><val> GalactoseBurn </val></def>
<def><name> TotalUptake </name><val> GalactoseUptake </val></def>

</block>
</definitions>
</structure>

