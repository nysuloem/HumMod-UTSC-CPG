 <structure><name> UterusLumen </name>

<variables>

<var><name> BloodPool </name></var>

<parm><name> MenstrualBloodLoss </name><val> 0.0 </val></parm>

</variables>

    <equations> 

      <diffeq>
        <name> MenstrualBleeding </name>
        <integralname> MenstrualBleeding </integralname>
        <initialval> 0.0  </initialval>
        <dervname> Change </dervname>
        <errorlim> 1.0 </errorlim>
      </diffeq>

      
      <delay>
        <name> BloodExpulsion </name>
        <outputname> Expulsion </outputname>
        <initialval> 0.0 </initialval>
        <inputname> BleedingVol </inputname>
        <rateconstname> ExpulsionRate </rateconstname>
        <dervname> UterineExpulsionDerv </dervname>

      </delay>
    </equations>


<definitions> 
<block><name> Init </name>

<def><name> BloodPool </name><val> 0.0 </val></def>
<def><name> BleedingVol </name><val> 0.0 </val></def>
<def><name> ExpulsionRate </name><val> 0.0 </val></def>
<def><name> Change </name><val> 0.0 </val></def>
</block>
<block><name> Parms </name>


<def><name> BleedingVol </name><val> Uterus-Menstruation.Volume </val></def> 
<def><name> ExpulsionRate </name><val> Uterus-Menstruation.Rate - Expulsion  </val></def>

</block>



<block> <name> Dervs </name>




<def><name> Gain </name><val> Uterus-Menstruation.Rate </val></def>
<def><name> Loss </name> <val> Expulsion </val></def>
<def><name> Change </name><val> Gain - Loss  </val></def>
<def><name> BloodPool </name> <val>  MenstrualBleeding </val></def>

<def><name> MenstrualBloodLoss </name><val> Expulsion </val></def>

</block>    
</definitions>
</structure>   
