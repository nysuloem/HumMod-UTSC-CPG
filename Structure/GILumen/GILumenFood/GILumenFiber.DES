HumMod / GILumenProtein

Created : 05-Jun-06
Last Modified : 26-Jan-10
Author : Tom Coleman
Copyright : 2006-2010
By : University of Mississippi Medical Center
Schema : DES V1.0

<structure><name> GILumenFiber </name>

<variables>

  <var><name> Intake </name></var>
  <var><name> Absorption </name></var>
  <var><name> [Fiber] </name></var>
  <var><name> Perm </name><val> 0.00 </val></var>

</variables>

<equations>

  <diffeq>
    <name> Mass </name>
    <integralname> Mass </integralname>
    <initialval> 1600.0 </initialval>
    <dervname> Change </dervname>
    <errorlim> 16.0 </errorlim>
  </diffeq>

</equations>

<definitions>

  <block><name> Conc </name>

    <def><name> [Fiber] </name><val> Mass / GILumenH2O.Mass </val></def>

  </block>

  <block><name> Dervs </name>

    <def><name> Intake </name><val> Stomach.FiberOutflowRate </val></def>
    <def><name> Absorption </name><val> Mass * Perm </val></def>
    <def><name> Change </name><val> Intake - Absorption </val></def>

  </block>

</definitions>

</structure>

End