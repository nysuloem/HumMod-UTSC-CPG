Copyright : 2006-2010
By : University of Mississippi Medical Center
Schema : DES V1.0

<structure><name> GILumenFat </name>

<variables>

<var><name> Intake </name></var>
<var><name> Absorption </name></var>
<var><name> Leftover </name></var>
<var><name> IntakeMassG </name></var>
<var><name> AbsorptionMassG </name></var>

<var><name> [Fat] </name></var>

<parm><name> Perm </name><val> 0.03 </val></parm>

</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 19.9 </errorlim>
</diffeq>
<diffeq>
  <name> IntakeMass </name>
  <integralname> IntakeMass </integralname>
  <initialval> 0 </initialval>
  <dervname> IntakeDerv </dervname>
  <errorlim> 19.3 </errorlim>
</diffeq>
<diffeq>
  <name> AbsorptionMass </name>
  <integralname> AbsorptionMass </integralname>
  <initialval> 0 </initialval>
  <dervname> AbsorptionDerv </dervname>
  <errorlim> 19.3 </errorlim>
</diffeq>


</equations>

<definitions>

<block><name> Conc </name>

<def><name> [Fat] </name><val> Mass / GILumenH2O.Mass </val></def>


</block>

<block><name> Dervs </name>
<def>
  <name> IntakeDerv </name>
  <val> DietIntakeNutrition.Fat_mG/Min </val>
</def>
<def>
  <name> Intake </name>
  <val> DietIntakeNutrition.Fat_mG/Min </val>
</def>
<def><name> AbsorptionDerv </name><val> Perm * Mass </val></def>
<def><name> Absorption </name><val> Perm * Mass </val></def>
<def><name> Change </name><val> Intake - Absorption </val></def>
<def> 
  <name> IntakeMassG </name>
  <val> IntakeMass / 1000 </val>
 </def>
<def> 
  <name> AbsorptionMassG </name>
  <val> AbsorptionMass / 1000 </val>
 </def>
<def>
  <name> Leftover </name>
  <val> IntakeMassG - AbsorptionMassG </val>
</def>

</block>

</definitions>
</structure>

End