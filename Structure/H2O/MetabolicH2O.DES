<structure><name> MetabolicH2O </name>

<variables>

<var><name> Rate </name></var> <!-- We think the rate is mL/min -->
<constant><name> K </name><val> 0.158 </val></constant> <!-- The original was like WAY lower, not sure why -->

</variables>

<definitions>

<block><name> Dervs </name>

<def>
  <name> Rate </name>
  <val> K * Metabolism-CaloriesUsed.Total </val>
</def>

</block>

</definitions>

</structure>

End