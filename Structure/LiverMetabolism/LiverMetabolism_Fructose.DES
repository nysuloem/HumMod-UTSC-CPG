<structure><name> LiverMetabolism_Fructose </name>

    <variables>

        <var><name> NetUptake </name></var>

        <var><name> Uptake </name></var>
        <var><name> Release </name></var>

    </variables>

    <definitions>
        <block><name> Dervs </name>

            <def><name> Uptake </name><val> FructosePump.Rate </val></def>
            <def><name> Release </name><val> FructoseDecomposition.Rate </val></def>

            <def><name> NetUptake </name><val> Uptake - Release </val></def>

        </block>
    </definitions>
</structure>
