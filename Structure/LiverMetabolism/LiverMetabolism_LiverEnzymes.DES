</variables>

<definitions>
<block><name> Init </name>

<def><name> LiverPool </name><val> LiverMetabolism_Gluconeogenesis.Rate </val></def>

<def><name> BloodPool </name><val> LiverPool * ( 1 / Liver-Function.Effect + 0.01 ) </val></def>



</block>

</definitions>

</structure>

