HumMod / MelatoninSecretion

Created : 15-Aug-08
Last Modified : 26-Jan-10
Author : Tom Coleman
Copyright : 2008-2010
By : University of Mississippi Medical Center
Schema : DES V1.0

<structure><name> MelatoninSecretion </name>

<variables>

<var><name> Rate </name></var>
<var><name> sizeModification </name></var>
<var><name> LightEffect </name></var>
<var><name> TwoFourHourEffect </name></var>
<var><name> AgeEffect </name></var>
<timervar><name> Day </name><val> 0.0 </val><state> UP </state></timervar>

<parm><name> Basic </name><val> 0.00012 </val></parm>

</variables>

<functions>

<curve>
  <name> LightEffect </name>
  <point><x>      0 </x><y> 50.0 </y><slope> 0 </slope></point>
  <point><x>  10000 </x><y> 1.0 </y><slope> 0 </slope></point>
</curve>

<curve>
  <name> AgeEffect </name>
  <point><x>      10 </x><y> 0.12 </y><slope> 0 </slope></point>
  <point><x>  41 </x><y> 0.54 </y><slope> 0 </slope></point>
</curve>

<curve>
  <name> TwoFourHourEffect </name>
  <point><x>      0 </x><y> 50 </y><slope> 0 </slope></point>
  <point><x>  360 </x><y> 25 </y><slope> 0 </slope></point>
  <point><x>  720 </x><y> 1 </y><slope> 0 </slope></point>
  <point><x>  1080 </x><y> 25 </y><slope> 0 </slope></point>
  <point><x>  1439 </x><y> 50 </y><slope> 0 </slope></point>
</curve>


</functions>

<definitions>
<block><name> Dervs </name>

<if><test> Day GE 1440 </test> <!-- 1440 minutes/day; reset the day after 24 hours-->
        <true>
            <timer>
                <name> Day </name>
                <val> 0 </val>
                </timer>
        </true>
    </if>

<def>
  <name> LightEffect </name>
  <val> LightEffect [ Light.LuxActual ] </val>
</def>

<def>
<name> AgeEffect </name>
<val> AgeEffect [ Context-Age.Age(Years) ] </val>
</def>

<def>
  <name> TwoFourHourEffect </name>
  <val> TwoFourHourEffect [ Day ] </val>
</def>

<def>
  <name> Rate </name>
  <val>
      Basic
    * LightEffect 
    * TwoFourHourEffect
  </val>
</def>

</block>

</definitions>
</structure>

End