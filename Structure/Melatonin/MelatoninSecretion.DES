Schema : DES V1.0

<structure><name> MelatoninSecretion </name>

<variables>

<var><name> Rate </name></var>
<var><name> sizeModification </name></var>
<var><name> LightEffect </name></var>

<parm><name> Basic </name><val> 1.2 </val></parm>

</variables>

<functions>

<curve>
  <name> LightEffect </name>
  <point><x>      0 </x><y> 1000.0 </y><slope> 0 </slope></point>
  <point><x>  10 </x><y> 0.0 </y><slope> 0 </slope></point>
</curve>




</functions>

<definitions>
<block><name> Dervs </name>

<def>
  <name> LightEffect </name>
  <val> LightEffect [ LipidDeposits.Mass ] </val>
</def>

<def>
  <name> Rate </name>
  <val>
      Basic
    * LightEffect
  </val>
</def>

</block>

</definitions>
</structure>

End