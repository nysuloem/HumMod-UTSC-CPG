

<!-- Boaz's BIOC32 Project-->


<structure><name> Rectum </name>

<variables>

    <var><name> ColonFlowRate </name><val> 0.2 </val></var>
    <parm><name> EmptyingRate </name><val> 0.1 </val></parm>
    <parm><name> VolumeToPressure </name><val> 2.0 </val></parm>
    <parm><name> ReflexThreshold </name><val> 5.0 </val></parm>

    <parm><name>AutoDefecationSwitch</name><val> 0 </val></parm>
    <var><name> MustVoidVolume</name><val> 150 </val></var>
    <var><name> MustVoid </name><val> FALSE </val></var>

    <var><name> RectalPressure </name></var>
    <var><name> DefecationReflex </name><val> 0 </val></var>
    <var><name> FecalVolume </name><val> 0 </val></var>
    <var><name> TotalFecalVolume </name><val> 0 </val></var>
    <var><name> Number </name><val> 0 </val></var>

    <var><name> TimeLastPoop </name><val> UNDEFINED </val></var>

</variables>

<equations>

    <diffeq>
      <name> RectalVolume </name>
      <integralname> RectalVolume </integralname>
      <initialval> 0 </initialval>
      <dervname> dRectalVolume/dt </dervname>
      <errorlim> 10 </errorlim>
    </diffeq>

</equations>

<definitions>

  <block><name> Dervs </name>

    <def>
      <name> dRectalVolume/dt </name>
      <val> GILumenCarbohydrates.Change </val>  
    </def> 

  </block>

  <block><name> TestVolume </name>

    <conditional>
      <name> MustVoid </name>
      <test> RectalVolume GE MustVoidVolume </test>
      <true> TRUE </true>
      <false> FALSE </false>
    </conditional>

  </block>

  <block><name> Void </name>

    <def><name> FecalVolume </name>
      <val> RectalVolume </val>
    </def>

    <def><name> TotalFecalVolume </name>
      <val> TotalFecalVolume + FecalVolume </val>
    </def>

    <def><name> TimeLastPoop </name>
      <val> System.X </val>
    </def>

    <def><name> Number </name> 
      <val> Number + 1 </val>
    </def>

    <def><name> RectalVolume </name>
      <val> 0 </val>
    </def>

  </block>

  <block><name> Wrapup </name>

    <call> TestVolume </call>
     
     <if><test> Rectum.MustVoid </test>
      <true>
        <call> Void </call>
      </true>
    </if>

    <if>
        <test> RectalVolume LT 0 </test>
        <true>
          <def><name> RectalVolume </name><val> 0 </val></def>
        </true>
      </if>

  </block>

</definitions>

</structure>