

<!-- Boaz's BIOC32 Project-->


<structure><name> Rectum </name>

<variables>

    <var><name> ColonFlowRate </name><val> .2 </val></var>
    <parm><name> EmptyingRate </name><val> 0.1 </val></parm>
    <parm><name> VolumeToPressure </name><val> 2.0 </val></parm>
    <parm><name> ReflexThreshold </name><val> 5.0 </val></parm>

    <parm><name>AutoDefecationSwitch</name><val> 0 </val></parm>
    <parm><name>AutoDefecationVolume</name><val> 150 </val></parm>

    <var><name> RectalPressure </name></var>
    <var><name> DefecationReflex </name><val> 0 </val></var>
    <var><name> FecalVolume </name><val> 0 </val></var>
    <var><name> TotalFecalVolume </name><val> 0 </val></var>

</variables>

<equations>

    <diffeq>
      <name> RectalVolume </name>
      <integralname> RectalVolume </integralname>
      <initialval> 0.0 </initialval>
      <dervname> dRectalVolume/dt </dervname>
      <errorlim> 10 </errorlim>
    </diffeq>

</equations>

<definitions>

  <block><name> Dervs </name>

    <conditional>
      <name> DefecationReflex </name>
        <test> RectalVolume GT AutoDefecationVolume </test>
        <true> 1 </true>
        <false> 0 </false>
    </conditional>
      
    <def>
      <name> dRectalVolume/dt </name>
      <val> ColonFlowRate </val>
    </def>

    <def>
      <name> RectalPressure </name>
      <val> VolumeToPressure * RectalVolume </val>
    </def>

    <if>
      <test> DefecationReflex EQ 1 </test>
      <true> 
        <def>
          <name> FecalVolume </name>
            <val> RectalVolume </val>
        </def>
        <def>
          <name> TotalFecalVolume </name>
            <val> TotalFecalVolume + FecalVolume </val>
        </def>
        <def>
          <name> RectalVolume </name>
          <val> 0 </val>
        </def>
      </true>
    </if>

  </block>

  <block><name> Wrapup </name>
     <!-- <if>
        <test> RectalVolume LT 0 </test>
        <true>
          <def><name> RectalVolume </name><val> 0 </val></def>
        </true>
      </if>-->
  </block>

</definitions>

</structure>