HumMod / Progesterone

Created : 07-Apr-05
Last Modified : 26-Jan-10
Author : Tom Coleman
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<?path Structure\S-Progesterone\ ?>

<structure><name> S-Progesterone </name>

<variables>

<var><name> Gain </name></var>
<var><name> Loss </name></var>

<var><name> Degradation </name></var>

<var><name> [Conc(nMol/L)] </name></var>
<var><name> [Conc(nG/mL)] </name></var>

<constant><name> NMOL/L_TO_NG/ML </name><val> 0.3145 </val></constant>


<parm><name> K </name><val> 0.08 </val></parm>


</variables>

<equations>

<diffeq>
  <name> Mass </name>
  <integralname> Mass </integralname>
  <initialval> 0 </initialval>
  <dervname> Change </dervname>
  <errorlim> 0.3 </errorlim>
</diffeq>

</equations>

<definitions>

<block><name> Init </name>

</block>

<block><name> Conc </name>
  <def><name> [Conc(nMol/L)] </name><val> Mass / ECFV.Vol(L) </val></def>
  <def><name> [Conc(nG/mL)] </name><val> [Conc(nMol/L)] * NMOL/L_TO_NG/ML </val></def>
</block>

<block><name> Dervs </name>

  <def><name> Degradation </name><val> K * Mass </val></def>

  <def><name> Gain </name><val> ContraceptivesGILumen.Loss </val></def>
  <def><name> Loss </name><val> Degradation </val></def>

  <def><name> Change </name><val> Gain - Loss </val></def>

</block>

</definitions>

</structure>

End