Schema : DES V1.0

<structure><name> DietGoalH2O </name>

<variables>

<parm><name> Rate(L/Day) </name><val> 2 </val></parm> <!-- 2 -->

<parm><name> DegC </name><val> 20.0 </val></parm>

<var><name> DegF </name></var>
<var><name> DegK </name></var>

</variables>

<definitions>

<block><name> Parms </name>

<def><name> DegF  </name><val> ( DegC * 9 / 5 ) + 32 </val></def>
<def><name> DegK </name><val> DegC + 273.15 </val></def>

</block>

</definitions>
</structure>

End