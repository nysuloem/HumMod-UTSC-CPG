HumMod / HypothalamusFever

Created : 12-Aug-26 
Schema : DES V1.0 


<structure><name> HypothalamusFever </name>

<variables>

<parm>
  <name> InfectionLevel </name>
  <val> 0 </val>
</parm>

<var>
  <name> PyrogenStimulus </name>
</var>

<parm>
  <name> AdaptationTau </name>
  <val> 150.0 </val>
</parm>

<parm>
  <name> PyrogenTau </name>
  <val> 60.0 </val>
</parm>

<parm>
  <name> FeverTau </name>
  <val> 60.0 </val>
</parm>



</variables>


<equations>

<delay>
  <name> PyrogenDrive </name>
  <outputname> PyrogenDrive </outputname>
  <initialval> 0.0 </initialval>
  <inputname> TargetPyrogenDrive </inputname>
  <rateconstname> PyrogenK </rateconstname>
  <dervname> PyrogenDerv </dervname>
  <errorlim> 0.003 </errorlim>
</delay>

<delay>
  <name> PyrogenAdaptation </name>
  <outputname> PyrogenAdaptation </outputname>
  <initialval> 0.0 </initialval>
  <inputname> TargetPyrogenAdaptation </inputname>
  <rateconstname> AdaptationK </rateconstname>
  <dervname> AdaptationDerv </dervname>
  <errorlim> 0.003 </errorlim>
</delay>

<delay>
  <name> FeverTempOffset </name>
  <outputname> FeverTempOffset </outputname>
  <initialval> 0.0 </initialval>
  <inputname> TargetFeverOffset </inputname>
  <rateconstname> FeverK </rateconstname>
  <dervname> FeverDerv </dervname>
  <errorlim> 0.003 </errorlim>
</delay>


</equations>


<functions>

<curve>
  <name> TargetPyrogenDriveCurve </name>

  <point>
    <x> 0 </x>
    <y> 0.0 </y>
    <slope> 0 </slope>
  </point>

  <point>
    <x> 100 </x>
    <y> 1.0 </y>
    <slope> 0 </slope>
  </point>

</curve>

<curve>
  <name> TargetFeverOffsetCurve </name>

  <point>
    <x> 0.0 </x>
    <y> 0.0 </y>
    <slope> 0 </slope>
  </point>

  <point>
    <x> 0.4 </x>
    <y> 8.0 </y>
    <slope> 0 </slope>
  </point>

</curve>

</functions>


<definitions>

<block><name> Parms </name>

  <def>
    <name> PyrogenK </name>
    <val> INVERT ( PyrogenTau ) </val>
  </def>

  <def>
  <name> AdaptationK </name>
  <val> INVERT ( AdaptationTau ) </val>
  </def>

  <def>
    <name> FeverK </name>
    <val> INVERT ( FeverTau ) </val>
  </def>

</block>


<block><name> Dervs </name>

  <def>
    <name> TargetPyrogenDrive </name>
    <val> TargetPyrogenDriveCurve [ InfectionLevel ] </val>
  </def>

<def>
  <name> TargetPyrogenAdaptation </name>
  <val> TargetPyrogenDriveCurve [ InfectionLevel ] </val>
</def>

<def>
  <name> PyrogenStimulus </name>
  <val> PyrogenDrive - PyrogenAdaptation </val>
</def>

  <def>
    <name> TargetFeverOffset </name>
    <val> TargetFeverOffsetCurve [ PyrogenStimulus ] </val>
  </def>

</block>


</definitions>

</structure>

End