HumMod / Quizzes

Created : 24-Apr-2025
Modified by Terry Yavorskyy 
Author : Tom Coleman
Copyright : 2008-2010
By : University of Mississippi Medical Center
Schema : DES V1.0


<structure><name> Quizzes </name>

<variables>
    <parm><name> Answer2 </name> <val> 0.0 </val></parm>     <!-- This is tied into a repeatlist for 0 - 100 score -->
<parm><name> Answer1 </name> <val> 0.0 </val></parm>  <!-- This one is the list of Professor names -->
<parm><name> Answer3 </name> <val> 0.0 </val></parm>

<!-- Correct and incorrect arguments for answer found as a common display element -->

<constant><name> Correct </name><val> TRUE </val></constant>
<constant><name> Incorrect </name><val> FALSE </val></constant>
<var><name> Message </name> <val> 0.0 </val> </var>  <!-- This is true or false -->
<var><name> Message2 </name> <val> 0.0 </val> </var> 
<var><name> Message3 </name> <val> 0.0 </val> </var> 

<!-- These are grading scales -->
 <constant><name> Nil </name> <val> 0 </val></constant>
 <constant><name> Low </name><val> 1 </val></constant>
<constant><name> Medium </name> <val> 2 </val></constant>
<constant><name> High </name> <val> 3 </val> </constant>
<constant><name> Perfect </name> <val> 4 </val></constant>


</variables>

<definitions>
    <!-- note how conditional and if elements are nested within onjustchanged -->
    <block> <name> Parms </name> 

        <onjustchanged> <name> Answer1 </name> 
            <conditional> <name> Message </name> 
                <test> Answer1 EQ 5 </test>
                <true> Correct </true>
                <false> Incorrect </false>
            </conditional>
        </onjustchanged>

<!--  The above element is for the correct and incorrect arguments 
  Below are conditionals nested within onjustchanged element for multiple choice selection -->

        <onjustchanged> <name> Answer2 </name> 
            <conditional> <name> Message2 </name> 
                <test> Answer2 EQ 0 </test>
                <true> Nil </true>
                      </conditional>

                      <conditional> <name> Message2 </name> 
                        <test> Answer2 GE 33 </test>
                        <true> Low </true>
                   
                              </conditional>

                              <conditional> <name> Message2 </name> 
                                <test> Answer2 GE 66 </test>
                                <true> Medium </true>
                                
                                      </conditional>

                                      <conditional> <name> Message2 </name> 
                                        <test> Answer2 EQ 99 </test>
                                        <true> High </true>
                                        
                                              </conditional>

                                              <conditional> <name> Message2 </name> 
                                                <test> Answer2 EQ 100 </test>
                                                <true> Perfect </true>
                                                
                                                      </conditional>
        </onjustchanged>
<!-- 
<onjustchanged> <name> Answer3 </name>




</onjustchanged>

-->

       <if>
        <test> Message EQ TRUE </test>
            <true> <def><name> Message </name><val> Correct </val></def> </true>
            <false> <def><name> Message </name><val> Incorrect </val></def> </false>
       </if> 
    </block>     

  
</definitions>
</structure>


End 