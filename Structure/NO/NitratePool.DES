HumMod / NitratePool

<structure><name> NitratePool </name>

<variables>

<parm>
  <name> Conversion_Factor </name> <!-- 70% of NO in the body turned into nitrate -->
  <val> 0.7 </val>
</parm>

<parm>
  <name> VolDist </name> <!-- 70% of NO in the body turned into nitrate -->
  <val> 50 </val>
</parm>

<var><name> [NO--] </name></var> <!-- amount of NO in system, comes from NO pool-->
<var><name> [Nitrate] </name></var> <!-- amount turned into nitrate, 70% of total NO -->
<var><name> [Nitrite] </name></var>

<var><name> Gain </name></var> <!-- nitrate -->

<var><name> Loss </name></var> <!-- amount peed out, NO clearance, so this attaches to NO Clearance -->
<var><name> Change </name></var>




</variables>

<definitions>

<block><name> Init </name>
<def><name> [NO--] </name><val> 0 </val></def>
<def><name> [Nitrate] </name><val> 0 </val></def>

<def><name> Loss </name><val> 0 </val></def>
<def><name> Gain </name><val> 0 </val></def>
<def><name> Change </name><val> 0 </val></def>

</block>

<block><name> Dervs </name>

<call> NitratePool.Init </call>

<def><name> [NO--] </name><val> NOPool.Gain </val></def> 
<def><name> [Nitrate] </name><val> [NO--] * Conversion_Factor </val></def>
<def><name> [Nitrite] </name><val> [Nitrate] *  ( 2 / 3 ) </val></def>

<def><name> Gain </name><val> [Nitrate] </val></def>
<def><name> Loss </name><val> [Nitrite] </val></def>
<def><name> Change </name><val> Gain - Loss </val></def>

</block>


</definitions>
</structure>

End
