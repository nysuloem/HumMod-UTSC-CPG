
Created by Aaesha Ahmed as part of her BIOD98 project in 2025-2026



<structure> <name> VascularEndothelium </name>
  
<variables>
  
  <var><name> NOProduction </name></var>
  <var><name> ArginineEffect </name></var>
  <var><name> CalciumEffect </name></var>
  <var><name> EstrogenEffect </name></var>
  <var><name> PEFactor </name></var>
  <var><name> eNOSRate </name><val> 0.01 </val></var>
  
</variables>

<functions>

  <curve>
    <name> EstrogenEffect </name>
    <point><x>      0 </x><y> 0.9 </y><slope> 0 </slope></point>
    <point><x>  0.5 </x><y> 1.1 </y><slope> 0 </slope></point>
    <point><x>  2 </x><y> 1.3 </y><slope> 0 </slope></point>
    <point><x>  4 </x><y> 1.5 </y><slope> 0 </slope></point>
    <point><x>  10 </x><y> 1.5 </y><slope> 0 </slope></point>
  </curve>

   <curve>
    <name> ArginineEffect </name>
    <point><x>  0 </x><y> 0.75 </y><slope> 0 </slope></point>
    <point><x>  100 </x><y> 1 </y><slope> 0 </slope></point>
    <point><x>  200 </x><y> 1.5 </y><slope> 0 </slope></point>
  </curve>

   <curve>
    <name> CalciumEffect </name>
    <point><x>      0 </x><y> 0.75 </y><slope> 0 </slope></point>
    <point><x>  4 </x><y> 1.0 </y><slope> 0 </slope></point>
    <point><x>  10 </x><y> 1.3 </y><slope> 0 </slope></point>
  </curve>

</functions>
  
<definitions>

  <block><name> Dervs </name>
  
    <def><name> EstrogenEffect </name>
      <val> EstrogenEffect [ Estradiol.[Conc(nMol/L)] ] </val>
    </def>

    <def><name> ArginineEffect </name>
      <val> ArginineEffect [ AA-Arginine.[Conc(uMol/L)] ] </val>
    </def>
  
    <def><name> CalciumEffect </name>
      <val> CalciumEffect [ Ca.[Ionized(mMol/L)] ] </val>
    </def>

    <if>
      <test> Uterus-PE.Risk GE 10 </test>
      <true> 
        <def><name> PEFactor </name><val> 0.5 </val></def> 
      </true>
      <false> 
        <def><name> PEFactor </name><val> 1.0 </val></def> 
      </false>
    </if>

    <def>
      <name> NOProduction </name>
      <val> eNOSRate * EstrogenEffect * ArginineEffect * CalciumEffect * PEFactor </val>
    </def>

  </block>

</definitions>

</structure>
