<structure> <name> VascularEndothelium </name>
  
<variables>
  
  <var><name> NOProduction </name></var>
  <var><name> ArginineConc </name></var>
  <var><name> CalciumLevel </name></var>
  <var><name> eNOSactivity </name></var>
  <var><name> PregnancyFactor </name></var>
  <var><name> PEFactor </name></var>

  <parm><name> eNOSrate </name><val> 0.5 </val></parm>
  
</variables>
  
<definitions>

  <block><name> Dervs </name>

    <def><name> ArginineConc </name><val> AA-Arginine.[Conc(uMol/L)] </val></def>
    <def><name> CalciumLevel </name><val> Ca.[Ionized(mMol/L)] </val></def>
    <def><name> PregnancyFactor </name><val> 1.0 + ( 0.5 * Pregnancy-Occurence.AnnouncePregnancy ) </val></def>

    <if>
      <test> Uterus-PE.Risk GE 10 </test>
      <true> 
        <def><name> PEFactor </name><val> 0.5 </val></def> 
      </true>
      <false> 
        <def><name> PEFactor </name><val> 1.0 </val></def> 
      </false>
    </if>

    <def>
      <name> eNOSactivity </name>
      <val> eNOSrate * PregnancyFactor * PEFactor </val>
    </def>

    <def>
      <name> NOProduction </name>
      <val> eNOSactivity * ArginineConc * CalciumLevel </val>
    </def>

  </block>

</definitions>

</structure>
