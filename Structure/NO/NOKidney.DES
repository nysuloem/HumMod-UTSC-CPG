HumMod / FurosemideKidney

Created : 05-Jun-06
Last Modified : 26-Jan-10
Author : Tom Coleman
Copyright : 2006-2010
By : University Of Mississippi Medical Center
Schema : DES V1.0

<structure><name> NOKidney </name>

<variables>
<var><name> NitrateLevel </name></var>
<var>
  <name> UrineLoss </name>
</var>
<constant>
  <name> K </name>
  <val> 0.01 </val>
</constant>
</variables>


<definitions>

<block><name> Init </name>
<def><name> NitrateLevel </name><val> 0 </val></def>
<def><name> UrineLoss </name><val> 0 </val></def>
</block>

<block><name> Dervs </name>
<call> NOKidney.Init </call>
<def><name> NitrateLevel </name><val> NitratePool.[Nitrate] </val></def>
<def>
  <name> UrineLoss </name>
  <val>
      K
    * NitrateLevel
    *  (    ( 0.5 * RightKidney-NephronCount.Filtering(xNormal) * RightKidney-Function.Effect ) 
	+ ( 0.5 * LeftKidney-NephronCount.Filtering(xNormal) * LeftKidney-Function.Effect ) )
  </val>
</def>
</block>

</definitions>
</structure>

End
