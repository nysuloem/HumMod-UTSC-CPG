<groupbox>
   <row> 15.0 </row>
   <col> 1.0 </col>
   <high> 5.8 </high>
   <wide> 30.0 </wide>
   <title> Continuous IV </title>

<structurename> NODrugIV </structurename>

<radiobuttons>
  <row> 1.4 </row><col> 1.0 </col>
  <name> Switch </name>
  <listname> Common.Switch </listname>
  <label> Switch </label>
</radiobuttons>

<repeatlist>
  <name> NODrugIVRate.Rate </name>
  <repeat><reps> 10 </reps><stepsize> 1 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 2.6 </row><col> 1.0 </col>
  <name> Setting </name>
  <listname> NODrugIVRate.Rate </listname>
  <label> Dose </label>
</slidebar>

<showvalue>
   <row> 4.2 </row><col> 1.0 </col>
   <name> CumulativeDose </name>
   <format> <integer/> </format>
   <label> Cumulative Dose </label>
</showvalue>

<infobutton>
  <row> 1.2 </row>
  <col> 26.0 </col>
  <line> Typical dose is 20 ppm, additional dosage varies with other factors. </line>
</infobutton>

</groupbox>

