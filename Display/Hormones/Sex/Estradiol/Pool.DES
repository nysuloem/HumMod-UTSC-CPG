<groupbox>
   <row> 2.0 </row>
   <col> 1.0 </col>
   <high> 25 </high>
   <wide> 35.0 </wide>
   <title> Pool </title>

<structurename> Estradiol </structurename>

<showvalue>
   <row> 1.4 </row><col> 1.0 </col>
   <name> Natural[Conc(nMol/L)] </name>
   <format><decimal> 2 </decimal></format>
   <label> Natural [Estradiol (nMol/L)] </label>
</showvalue>

<showgraph>
  <row> 2.4 </row><col> 1.0 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 6 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time </label>
    <scale><min> 0 </min><max> 2 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> Natural[Conc(nMol/L)] </name>
      <nolabel/>
      <linecolor> BLUE </linecolor>
    </yvar>
    <scale>
      <min> 0 </min><max> 1 </max><inc> 1 </inc>
    </scale>
  </yaxis>
</showgraph>

<showvalue>
   <row> 9.8 </row><col> 1.0 </col>
   <name> Natural[Conc(pG/mL)] </name>
   <format><decimal> 3 </decimal></format>
   <label> Natural [Estradiol (pG/mL)] </label>
</showvalue>

<showvalue>
   <row> 11.4 </row><col> 1.0 </col>
   <name> Synthetic[Conc(nMol/L)] </name>
   <format><decimal> 2 </decimal></format>
   <label> Synthetic [Estradiol (nMol/L)] </label>
</showvalue>

<showgraph>
  <row> 12.4 </row><col> 1.0 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 6 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time </label>
    <scale><min> 0 </min><max> 2 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> Synthetic[Conc(nMol/L)] </name>
      <nolabel/>
      <linecolor> BLUE </linecolor>
    </yvar>
    <scale>
      <min> 0 </min><max> 1 </max><inc> 1 </inc>
    </scale>
  </yaxis>
</showgraph>

<showvalue>
   <row> 20.8 </row><col> 1.0 </col>
   <name> Synthetic[Conc(pG/mL)] </name>
   <format><decimal> 3 </decimal></format>
   <label> Synthetic [Estradiol (pG/mL)] </label>
</showvalue>

<infobutton>
  <row> 1.2 </row>
  <col> 28.5 </col>

  <line> Typical estradiol concentration in the </line>
  <line> female is 0.15 nMol/L or 0.05 nG/mL early </line>
  <line> in the follicular phase and 1.0 or more </line>
  <line> late in the follicular phase. Concentration </line>
  <line> in the luteal phase is around 0.70. </line>
  <line>  </line>
  <line> Concentration in the male is close to </line>
  <line> zero. </line>
</infobutton>

</groupbox>

<groupbox>
   <row> 2.0 </row>
   <col> 36.5 </col>
   <high> 5.8 </high>
   <wide> 30.0 </wide>
   <title> Pump </title>

<radiobuttons>
  <row> 1.4 </row><col> 1 </col>
  <name> PumpSwitch </name>
  <listname> Common.Switch </listname>
  <label> Switch </label>
</radiobuttons>

<repeatlist>
  <name> Pump </name>
  <repeat><reps> 100 </reps><stepsize>  1 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 2.8 </row><col> 1 </col>
  <name> PumpSetting </name>
  <listname> Pump </listname>
  <label> Setting </label>
</slidebar>

<showvalue>
   <row> 4.2 </row><col> 1 </col>
   <name> Estradiol.PumpSetting </name>
   <format><integer/></format>
   <label> Rate </label>
</showvalue>

</groupbox>


