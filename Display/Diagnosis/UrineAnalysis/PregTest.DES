<groupbox>
    <row> 2.0 </row>
    <col> 35.0 </col>
    <high> 5.8 </high>
    <wide> 30.0 </wide>
 
 <structurename> hCG </structurename>
 
 <showvalue>
   <row> 1.0 </row><col> 1.0 </col>
   <name> hCG.UrineLoss </name>
   <format><decimal> 1 </decimal></format>
   <label> [hCG] in Urine </label>
 </showvalue>
 
 <label>
    <row> 3.0 </row><col> 1.0 </col>
    <text> Pregnancy Test </text>
    <color> DARKBLUE </color>
  </label>
  
  <maplist><name> hCG.Result </name>
    <map><val> 1 </val><img> Positive(+) </img></map>
    <map><val> 2 </val><img> Inconclusive </img></map>
    <map><val> 3 </val><img> Negative(-) </img></map>
  </maplist>
  
  <showvalue>
     <row> 4.0 </row><col> 2.0 </col>
     <name> TestOutcome </name>
     <format><list> hCG.Result </list></format>
     <label> Test Result </label>
  </showvalue>

<infobutton>
    <row> 1.2 </row>
    <col> 26 </col>

  <line> Pregnancy Test Values of [hCG] </line>
  <line>  </line>
  <line> Positive: ≥ 25 mIU/mL </line>
  <line> Positive: 20-25 mIU/mL </line>
  <line> Negative: less than 20 mIU/mL </line>
</infobutton>

</groupbox>
