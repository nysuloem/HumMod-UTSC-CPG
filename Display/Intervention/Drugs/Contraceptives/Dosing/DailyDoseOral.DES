<groupbox>
   <row> 2.0 </row>
   <col> 1.0 </col>
   <high> 8.0 </high>
   <wide> 25.0 </wide>
   <title> Prescription </title>

<structurename> ContraceptivesDailyDose </structurename>

<maplist>
  <name> Contraceptives-Control.Brand </name>
  <map><val> 0 </val><img> Brand A (20/1) </img></map>
  <map><val> 1 </val><img> Brand B (20/0.1) </img></map>
  <map><val> 2 </val><img> Brand C (30/3) </img></map>
  <map><val> 3 </val><img> Brand D (0/3) </img></map>
</maplist>

<radiobuttons>
  <row> 1.4 </row><col> 1.0 </col>
  <name> Brand </name>
  <listname> Contraceptives-Control.Brand </listname>
  <layout> VERT </layout>
</radiobuttons>

<actionbutton>
  <row> 6.0 </row><col> 1.0 </col>
  <blockname> RenewScript </blockname>
  <label> Give/Renew Prescription </label>
</actionbutton>

<infobutton>
  <row> 1.2 </row>
  <col> 20.5 </col>
  <line> (20/1) = 20ug synthetic estrogen + 1 mg synthetic progresterone </line>
</infobutton>

</groupbox>

<groupbox>
   <row> 2.0 </row>
   <col> 26.5 </col>
   <high> 21.0 </high>
   <wide> 40.0 </wide>
   <title> Daily Dose Oral </title>

<structurename> ContraceptivesDailyDose </structurename>

<maplist>
  <name> Contraceptives-Control.Request </name>
  <map><val> 0 </val><img> No </img></map>
  <map><val> 1 </val><img> Yes </img></map>
  <map><val> 2 </val><img> When I have it </img></map>
  <map><val> 3 </val><img> When I remember </img></map>
  <map><val> 4 </val><img> When I have it and remember </img></map>
</maplist>

<radiobuttons>
  <row> 1.4 </row><col> 1.0 </col>
  <name> TakeDaily </name>
  <listname> Contraceptives-Control.Request </listname>
  <label> Take Daily </label>
  <layout> VERT </layout>
</radiobuttons>

<repeatlist>
  <name> ContraceptivesDailyDose.PercentChance </name>
  <firstval> 0.0 </firstval>
  <repeat><reps> 20 </reps><stepsize> 0.05 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 7.0 </row><col> 10.0 </col>
  <name> PercentChance  </name>
  <listname> ContraceptivesDailyDose.PercentChance </listname>
  <label> Memory </label>
</slidebar>

<showvalue>
   <row> 9.6 </row><col> 1.0 </col>
   <name> TimeLastDose </name>
   <format>
      <timestamp/>
      <fieldwidth> 14 </fieldwidth>
   </format>
   <label> Last Dose </label>
</showvalue>

<showvalue>
   <row> 11.1 </row><col> 1.0 </col>
   <name> TimeNextDose </name>
   <format>
      <timestamp/>
      <fieldwidth> 14 </fieldwidth>
   </format>
   <label> Next Dose </label>
</showvalue>

<showvalue>
   <row> 12.6 </row><col> 1.0 </col>
   <name> TotalDoses </name>
   <format> <integer/> </format>
   <label> Total Doses </label>
</showvalue>

<showvalue>
   <row> 14.1 </row><col> 1.0 </col>
   <name> RealDose </name>
   <format><decimal> 3 </decimal></format>
   <label> Real Dose </label>
</showvalue>

<showvalue>
   <row> 15.6 </row><col> 1.0 </col>
   <name> FakeDose </name>
   <format><decimal> 3 </decimal></format>
   <label> Fake Dose </label>
</showvalue>

<showvalue>
   <row> 17.1 </row><col> 1.0 </col>
   <name> Timer </name>
   <format> <integer/> </format>
   <label> Time Until Next Dose </label>
</showvalue>

<showvalue>
   <row> 18.6 </row><col> 1.0 </col>
   <name> NumberLeft </name>
   <format>
      <integer/>
   </format>
   <label> Pills Remaining </label>
</showvalue>

</groupbox>

End