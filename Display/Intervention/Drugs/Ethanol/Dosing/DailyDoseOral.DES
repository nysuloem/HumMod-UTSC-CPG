HumMod / DailyDoseOral

Created : 2025-01-03
Revised : 2025-05-08
Author : Tom Coleman
Copyright : 2013-2025
By : Tiffany Bishun

<groupbox>
   <row> 2.0 </row>
   <col> 32.0 </col>
   <high> 32.0 </high>
   <wide> 36 </wide>
   <title> Daily Dose Oral </title>

<structurename> EthanolDailyDose </structurename>

<maplist>
  <name> Ethanol-Control.Request </name>
  <map><val> 0 </val><img> No </img></map>
  <map><val> 1 </val><img> Yes </img></map>
  <map><val> 2 </val><img> When I have it </img></map>
  <map><val> 3 </val><img> When I want to </img></map>
  <map><val> 4 </val><img> When I have it and want to </img></map>
</maplist>

<radiobuttons>
  <row> 1.4 </row><col> 1.0 </col>
  <name> TakeDaily </name>
  <listname> Ethanol-Control.Request </listname>
  <label> Drink Daily </label>
  <layout> VERT </layout>
</radiobuttons>

<repeatlist>
  <name> EthanolDailyDose.Dose </name>
  <repeat><reps> 60 </reps><stepsize> 100 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 7.0 </row><col> 1.0 </col>
  <name> Dose </name>
  <listname> EthanolDailyDose.Dose </listname>
  <label> Volume in ml </label>
</slidebar>

<repeatlist>
  <name> EthanolDailyDose.PercentageofAlcohol </name>
  <repeat><reps> 100 </reps><stepsize> 1 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 8.0 </row><col> 1.0 </col>
  <name> EthanolDailyDose.PercentageofAlcohol </name>
  <listname> EthanolDailyDose.PercentageofAlcohol </listname>
  <label> PercentageofAlcohol </label>
</slidebar>

<repeatlist>
  <name> EthanolDailyDose.TimesADay </name>
  <firstval> 1.0 </firstval>
  <repeat><reps> 23 </reps><stepsize> 1.0 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 9.2 </row><col> 1.0 </col>
  <name> TimesADay </name>
  <listname> EthanolDailyDose.TimesADay </listname>
  <label> Times A Day </label>
</slidebar>

<maplist>
  <name> EthanolDailyDose.DrinksAlloted </name>
  <map><val>     0 </val><img> None </img></map>
  <map><val> 5 </val><img> 5 </img></map>
  <map><val> 10 </val><img> 10 </img></map>
  <map><val> 30 </val><img> 30 </img></map>
  <map><val> 1000 </val><img> 1000 </img></map>
  <map><val> 1E308 </val><img> Unlimited </img></map>
</maplist>

<slidebar>
  <row> 10.4 </row><col> 1.0 </col>
  <name> NumberGiven </name>
  <listname> EthanolDailyDose.DrinksAlloted </listname>
  <label> Drinks Alloted </label>
</slidebar>

<repeatlist>
  <name> EthanolDailyDose.PercentChance  </name>
  <firstval> 0.0 </firstval>
  <repeat><reps> 20 </reps><stepsize> 0.05 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 11.6 </row><col> 1.0 </col>
  <name> PercentChance  </name>
  <listname> EthanolDailyDose.PercentChance  </listname>
  <label> Likelihood of taking </label>
</slidebar>


<actionbutton>
  <row> 13.0 </row><col> 1.0 </col>
  <blockname> RenewScript </blockname>
  <label> Get more alcohol </label>
</actionbutton>


<showvalue>
   <row> 15.0 </row><col> 1.0 </col>
   <name> TimeLastDose </name>
   <format>
      <timestamp/>
      <fieldwidth> 14 </fieldwidth>
   </format>
   <label> Last Dose </label>
</showvalue>

<showvalue>
   <row> 16.2 </row><col> 1.0 </col>
   <name> TimeNextDose </name>
   <format>
      <timestamp/>
      <fieldwidth> 14 </fieldwidth>
   </format>
   <label> Next Dose </label>
</showvalue>

<showvalue>
   <row> 17.4 </row><col> 1.0 </col>
   <name> TotalDoses </name>
   <format> <integer/> </format>
   <label> Total Doses </label>
</showvalue>

<showvalue>
   <row> 18.6 </row><col> 1.0 </col>
   <name> CumulativeDose </name>
   <format><decimal> 3 </decimal></format>
   <label> Cumulative Dose </label>
</showvalue>

<showvalue>
   <row> 19.8 </row><col> 1.0 </col>
   <name> Timer </name>
   <format> <integer/> </format>
   <label> Time Until Next Drink </label>
</showvalue>

<showvalue>
   <row> 21.0 </row><col> 1.0 </col>
   <name> NumberLeft </name>
   <format>
      <integer/>
   </format>
   <label> Number Remaining </label>
</showvalue>

<showgraph>
  <row> 22.6 </row><col> 1.0 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 6 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time </label>
    <scale><min> 0 </min><max> 0.5 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> EthanolPool.[Ethanol] </name>
      <nolabel/>
      <linecolor> BLUE </linecolor>
    </yvar>
    <scale>
      <min> 0 </min><max> 0.5 </max>
    </scale>
  </yaxis>
</showgraph>


<infobutton>
  <row> 2.2 </row>
  <col> 29.6 </col>
  <line> Daily daily dose is 1-2 oz of 40% Ethanol. </line>
</infobutton>

</groupbox>

End