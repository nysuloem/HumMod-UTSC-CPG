




<groupbox>
   <row> 2.0 </row>
   <col> 71 </col>
   <high> 12 </high>
   <wide> 36 </wide>
   <title> Blood Alcohol Concentration </title>

<showgraph>
  <row> 2.5 </row><col> 1.0 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 6 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time </label>
    <scale><min> 0 </min><max> 0.1 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> EthanolPool.[Ethanol] </name>
      <nolabel/>
      <linecolor> BLUE </linecolor>
    </yvar>
    <!--<scale>
      <min> 0 </min><max> 0.5 </max>
    </scale>-->
  </yaxis>
</showgraph>

<showvalue>
   <row> 1.2 </row><col> 1.0 </col>
   <name> EthanolPool.[Ethanol] </name>
   <format><decimal> 2 </decimal></format>
   <label> Blood Alcohol Concentration (g/dL) </label>
</showvalue>

<showvalue>
   <row> 8.2 </row><col> 1.0 </col>
   <name> Acetaldehyde.[BloodAcetaldehyde] </name>
   <format><decimal> 2 </decimal></format>
   <label> Blood Acetaldehyde </label>
</showvalue>

<showvalue>
   <row> 10.2 </row><col> 1.0 </col>
   <name> EthanolPool.Gain </name>
   <format><decimal> 2 </decimal></format>
   <label> Ethanol Gain </label>
</showvalue>

<showvalue>
   <row> 12.2 </row><col> 1.0 </col>
   <name> EthanolSingleDose.Mass </name>
   <format><decimal> 2 </decimal></format>
   <label> Single Consumed Mass </label>
</showvalue>

<showvalue>
   <row> 14.2 </row><col> 1.0 </col>
   <name> EthanolPool.Loss </name>
   <format><decimal> 2 </decimal></format>
   <label> Ethanol Loss </label>
</showvalue>

<infobutton>
  <row> 3 </row>
  <col> 32 </col>
  <line> 0.08 g/dL is the legal limit for BAC </line>
</infobutton>

</groupbox>