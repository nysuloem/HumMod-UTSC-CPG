HumMod / SingleDoseOral

Created : 2025-01-03
Revised : 2025-05-08
Author : Tom Coleman
Copyright : 2013-2025
By : Tiffany Bishun

<groupbox>
   <row> 2.0 </row>
   <col> 38.0 </col>
   <high> 15 </high>
   <wide> 32 </wide>
   <title> Single Oral Alcoholic Drink </title>

<structurename> EthanolSingleDose </structurename>

<actionbutton>
  <row> 1.4 </row><col> 1.0 </col>
  <blockname> TakeDoseNow </blockname>
  <label> Drink Alcohol Now </label>
</actionbutton>

<repeatlist>
  <name> EthanolSingleDose.Volume </name>
  <repeat><reps> 10 </reps><stepsize> 100 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 3.2 </row><col> 1.0 </col>
  <name> Volume </name>
  <listname> EthanolSingleDose.Volume </listname>
  <label> Volume (mL) </label>
</slidebar>

<showvalue>
   <row> 5.2 </row><col> 1.0 </col>
   <name> %Alc </name>
   <label> % Alcohol </label>
</showvalue>

<showvalue>
   <row> 7.2 </row><col> 1.0 </col>
   <name> TimeLastDose </name>
   <format>
      <timestamp/>
      <fieldwidth> 14 </fieldwidth>
   </format>
   <label> Last Dose </label>
</showvalue>

<showvalue>
   <row> 8.2 </row><col> 1.0 </col>
   <name> TotalDrinks </name>
   <format> <integer/> </format>
   <label> Total Drinks Consumed </label>
</showvalue>

<showvalue>
   <row> 9.2 </row><col> 1.0 </col>
   <name> CumulativeDose </name>
   <format> <integer/> </format>
   <label> Total Alcohol Consumed (g) </label>
</showvalue>

<actionbutton>
  <row> 11.2 </row><col> 1.0 </col>
  <blockname> Reset </blockname>
  <label> Reset </label>
</actionbutton>

<infobutton>
  <row> 1 </row>
  <col> 28 </col>
  <line> One beer is typically 500mL of 5% Alc </line>
  <line> One wine is typically 250mL of 14% Alc </line>
</infobutton>

</groupbox>


End
