By : University Of Mississippi Medical Center

<groupbox>
   <row> 2 </row>
   <col> 1.0 </col>
   <high> 10.0 </high>
   <wide> 30.0 </wide>
   <title> NO Inhaler </title>

<structurename> NODrugInhaler </structurename>

<actionbutton>
  <row> 1.4 </row><col> 1.0 </col>
  <blockname> Inhale </blockname>
  <label> Use Inhaler Now </label>
</actionbutton>

<repeatlist>
  <name> NODrugInhaler.Dose </name>
  <repeat><reps> 20 </reps><stepsize> 5 </stepsize></repeat>
</repeatlist>

<slidebar>
  <row> 3.4 </row><col> 1.0 </col>
  <name> Dose </name>
  <listname> NODrugInhaler.Dose </listname>
  <label> Dose </label>
</slidebar>

<showvalue>
   <row> 4.8 </row><col> 1.0 </col>
   <name> CumulativeDose </name>
   <format> <integer/> </format>
   <label> Cumulative Dose </label>
</showvalue>

<showvalue>
   <row> 6.2 </row><col> 1.0 </col>
   <name> TotalDoses </name>
   <format> <integer/> </format>
   <label> Total Doses </label>
</showvalue>

<showvalue>
   <row> 7.6 </row><col> 1.0 </col>
   <name> TimeLastDose </name>
   <format>
      <timestamp/>
      <fieldwidth> 14 </fieldwidth>
   </format>
   <label> Last Dose </label>
</showvalue>

<infobutton>
  <row> 1.2 </row>
  <col> 26.0 </col>
  <line> Standard (adult) dose is 20 ppm </line>
</infobutton>

</groupbox>

End
