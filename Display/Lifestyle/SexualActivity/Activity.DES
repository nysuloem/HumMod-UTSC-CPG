<groupbox>
   <row> 2.0 </row>
   <col> 1.0 </col>
   <high> 18 </high>
   <wide> 40 </wide>
   <title> Sexual Activity </title>

<structurename> SexDrive </structurename>

<radiobuttons>
  <row> 1.4 </row><col> 1.0 </col>
  <name> Index </name>
  <listname> Common.NoYes </listname>
  <label> Sexually Active </label>
</radiobuttons>

<repeatlist>
  <name> PartnerProbability </name>
  <repeat><reps> 100 </reps><stepsize> 1.0 </stepsize></repeat>
</repeatlist>

<slidebar>
    <row> 3.4 </row>
    <col> 1.0 </col>
    <name> HaveSex.PartnerProbability </name>
    <listname> PartnerProbability </listname>
    <label> Partner Probability (%) </label>
</slidebar>

<showvalue>
   <row> 12.4 </row><col> 1 </col>
   <name> SexDrive.LibidoEffect </name>
   <label> Horniness (0-100) </label>
</showvalue>

<showvalue>
  <row> 13.4</row><col> 1 </col>
  <name> SexualIntercourse.Orgasm </name>
  <label> Orgasm Timer </label>
</showvalue>

<showvalue>
  <row> 14.4</row><col> 1 </col>
  <name> SexualIntercourse.Refractory </name>
  <label> Refractory Timer </label>
</showvalue>

<showvalue>
  <row> 15.4 </row><col> 1 </col>
  <name> SexualIntercourse.Attempt </name>
  <label> Attempt Timer </label>
</showvalue>

<showvalue>
  <row> 16.4 </row><col> 1 </col>
  <name> SexualIntercourse.SpermTimer </name>
  <label> Sperm Timer </label>
</showvalue>

<showvalue>
  <row> 17.4 </row><col> 1 </col>
  <name> SexDrive.Libido </name>
  <label> Libido </label>
</showvalue>

<maplist>
  <name> SexDrive.Mood </name>
  <map><val>  0 </val><img> "I'm not in the mood right now." </img></map>
  <map><val>  1 </val><img>  "I'm horny!" </img></map>
  <map><val> 2 </val><img> Patient is not sexually active </img></map>
</maplist>

<showvalue>
  <row> 7.4 </row><col>1</col>
  <name> SexDrive.Mood </name>
  <nolabel/>
  <format>
    <list> SexDrive.Mood </list>
  </format>
</showvalue>

<label>
  <row> 6.4 </row>
  <col> 1.0 </col>
  <text> Patient's sex drive =  </text>
</label>

<maplist>
  <name> HaveSex.SexOutcome </name>
  <map><val>  0 </val><img> Patient is not currently having sexual intercourse </img></map>
  <map><val> 1 </val><img> Patient is having sexual intercourse </img></map>
  <map><val>  5 </val><img> Patient is currently attempting sexual intercourse </img></map>
  <map><val> 6 </val><img> Patient could not get an erection and aborted the sexual attempt </img></map>
</maplist>

<showvalue>
  <row> 10.4 </row><col>1</col>
  <name> HaveSex.SexOutcome </name>
  <nolabel/>
  <format>
    <list> HaveSex.SexOutcome </list>
  </format>
</showvalue>

<label>
  <row> 9.4 </row>
  <col> 1.0 </col>
  <text> Patient's sexual activity =  </text>
</label>

</groupbox>

<structurename> HaveSex </structurename>

<groupbox>
   <row> 20 </row>
   <col> 1.0 </col>
   <high> 8 </high>
   <wide> 40 </wide>
   <title> Sexual Encounters </title>

<showvalue>
   <row> 2.5 </row><col> 1 </col>
   <name> SexualIntercourse.TimeLastSex </name>
   <format>
      <timestamp/>
      <fieldwidth> 14 </fieldwidth>
   </format>
   <label> Last Sexual Encounter </label>
</showvalue>

<showvalue>
  <row> 4.0 </row><col> 1 </col>
  <name> SexualIntercourse.FailedSex </name>
  <label> Times Failed to Erection </label>
</showvalue>

<showvalue>
  <row> 5.5 </row><col> 1 </col>
  <name> SexualIntercourse.TotalSex </name>
  <label> Total Number of Sexual Encounters </label>
</showvalue>

<infobutton>
  <row> 1.2 </row>
  <col> 35 </col>
  <line> Failure to achieve erection </line>
  <line> could indicate erectile dysfunction </line>
</infobutton>

</groupbox>

End
