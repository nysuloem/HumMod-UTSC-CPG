<groupbox>
   <row> 2.0 </row>
   <col> 1.0 </col>
   <high> 40 </high>
   <wide> 66 </wide>
   <title> Hunger </title>

<structurename> DietHunger </structurename>

<showvalue>
   <row> 1.4 </row><col> 1.0 </col>
   <name> DietHunger.HungerRating </name>
   <format><decimal> 0 </decimal></format>
   <label> "How hungry are you?" (0-100 scale) </label>
</showvalue>

<showvalue>
   <row> 5.0 </row><col> 2.0 </col>
   <name> DietIntakeNutrition.Total_G/Min </name>
   <format><decimal> 2 </decimal></format>
   <label> Food Intake (g/Min) </label>
</showvalue>

<showgraph>
  <row> 6.5 </row><col> 1.0 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 6 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time </label>
    <scale><min> 0 </min><max> 2 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> DietIntakeNutrition.Total_G/Min </name>
      <label> Intake </label>
      <linecolor> BLUE </linecolor>
    </yvar>
    <scale>
      <min> 0 </min><max> 2 </max><inc> 1 </inc>
    </scale>
  </yaxis>
</showgraph>

<showcurve>
  <row> 6.5 </row><col> 30 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 7 </leftmargin>

  <xaxis>
    <name> LeptinPool.[Leptin(nG/mL)] </name>
    <label> [Leptin] </label>
    <scale>
      <min> 0 </min><max> 50 </max><inc> 10 </inc>
    </scale>
  </xaxis>

  <yaxis>
    <label> Effect </label>
    <scale><min> 0 </min><max> 3 </max><inc> 1 </inc></scale>
  </yaxis>

  <curvename> DietHunger-Leptin.Effect </curvename>
</showcurve>

<showcurve>
  <row> 15.0 </row><col> 30 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 7 </leftmargin>

  <xaxis>
    <name> InsulinPool.[Insulin] </name>
    <label> [Insulin] </label>
    <scale>
      <min> 0 </min><max> 50 </max><inc> 10 </inc>
    </scale>
  </xaxis>
  <yaxis>
    <scale>
      <min> 0 </min><max> 3 </max>
    </scale>
  </yaxis>

  <curvename> DietHunger-Insulin.Effect </curvename>
</showcurve>

<showcurve>
  <row> 24.5 </row><col> 30 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 7 </leftmargin>

  <xaxis>
    <name> DietHunger-Ghrelin.[Ghrelin] </name>
    <label> [Ghrelin] </label>
    <scale>
      <min> 0 </min><max> 600 </max><inc> 10 </inc>
    </scale>
  </xaxis>
  <yaxis>
    <scale>
      <min> 0 </min><max> 2 </max>
    </scale>
  </yaxis>

  <curvename> DietHunger-Ghrelin.Effect </curvename>
</showcurve>

</groupbox>

End
