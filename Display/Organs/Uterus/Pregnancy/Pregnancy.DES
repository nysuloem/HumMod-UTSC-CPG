



<panel><name> Pregnancy </name>

  <label>
    <row> 0.3 </row>
    <col> 4.5 </col>
    <text> Pregnancy </text>
  </label>

  <showclock>
    <row> 0.3 </row><col> 32.0 </col>
    <name> System.X </name>
    <ampm/>
    <secs/>
    <days/>
  </showclock>

  <groupbox>
   <row> 2.0 </row>
   <col> 3.0 </col>
   <high> 25.0 </high>
   <wide> 40.0 </wide>
   <title> Pregnancy Overview </title>

<structurename> Pregnancy-Occurence </structurename>

<label>
  <row> 1.4 </row><col> 1.0 </col>
  <text> Pregnancy Test </text>
  <color> DARKBLUE </color>
</label>

<maplist><name> Pregnancy.Result </name>
  <map><val> 1 </val><img> Positive(+) </img></map>
  <map><val> 2 </val><img> Inconclusive </img></map>
  <map><val> 3 </val><img> Negative(-) </img></map>
</maplist>

<showvalue>
   <row> 2.4 </row><col> 1.0 </col>
   <name> TestOutcome </name>
   <format><list> Pregnancy.Result </list></format>
   <label> Test Result </label>
</showvalue>

<label>
  <row> 4.4 </row><col> 1.0 </col>
  <text> Overview </text>
  <color> DARKBLUE </color>
</label>

<showvalue>
  <row> 5.4 </row><col> 1.0 </col>
  <name> Pregnancy-Occurence.Probability </name>
  <label> Conception Probability </label>
</showvalue>

<showvalue>
  <row> 6.4 </row><col> 2.0 </col>
  <name> SexualIntercourse.SpermTimer </name>
  <label> Sperm Timer </label>
</showvalue>

<showvalue>
  <row> 7.4 </row><col> 2.0 </col>
  <name> Ovaries-Ovulation.EggTimer </name>
  <label> Egg Timer </label>
</showvalue>

<checkmark>
  <row> 8.4 </row><col> 2.0 </col>
  <name> Pregnancy-Occurence.Fertilization </name>
  <label> Fertlized? </label>
</checkmark>

<showvalue>
  <row> 9.4 </row><col> 1.0 </col>
  <name> Pregnancy-Occurence.FertilizationTime </name>
  <format>
     <timestamp/>
     <fieldwidth> 14 </fieldwidth>
  </format>
  <label> Fertilization Timestamp </label>
</showvalue>

<showvalue>
  <row> 10.4 </row><col> 2.0 </col>
  <name> Pregnancy-Occurence.AnnouncePregnancy </name>
  <label> Pregnancy Timer (minutes) </label>
</showvalue>

<showvalue>
  <row> 12.4 </row><col> 2.0 </col>
  <name> Pregnancy-Occurence.PregnancyWeek </name>
  <format><decimal> 0 </decimal></format>
  <label> Gestational Week (weeks) </label>
</showvalue>

<label>
  <row> 16.4 </row><col> 1.0 </col>
  <text> hCG </text>
  <color> DARKBLUE </color>
</label>
<showgraph>
  <row> 17.4 </row><col> 1.0 </col><high> 7 </high><wide> 28 </wide>
  <leftmargin> 5 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time </label>
    <scale><min> 0 </min><max> 2 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> hCG.[Conc(IU/L)] </name>
      <nolabel/>
      <linecolor> BLUE </linecolor>
    </yvar>
    <scale><min> 0 </min><max> 10000 </max><inc> 1000 </inc></scale>
  </yaxis>
</showgraph>

</groupbox>

</panel>
