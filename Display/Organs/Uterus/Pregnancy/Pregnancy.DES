
<panel><name> Pregnancy </name>

  <label>
    <row> 0.3 </row>
    <col> 4.5 </col>
    <text> Pregnancy </text>
  </label>

  <showclock>
    <row> 0.3 </row><col> 32.0 </col>
    <name> System.X </name>
    <ampm/>
    <secs/>
    <days/>
  </showclock>

  <groupbox>
   <row> 2.0 </row>
   <col> 3.0 </col>
   <high> 25.0 </high>
   <wide> 30.0 </wide>
   <title> Pregnancy Overview </title>

<structurename> Pregnancy </structurename>

