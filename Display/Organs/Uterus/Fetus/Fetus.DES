<panel>
  <name> Fetus </name>

  <label>
    <row> 0.3 </row>
    <col> 1.0 </col>
    <text> Fetus and Placenta </text>
  </label>

  <showclock>
    <row> 0.3 </row><col> 32.0 </col>
    <name> System.X </name>
    <ampm/>
    <secs/>
    <days/>
  </showclock>

  <showvalue>
    <row> 2.0 </row><col> 1.0 </col>
    <name> Pregnancy-Occurence.PregnancyWeek </name>
    <format><decimal> 1 </decimal></format>
    <label> Gestation Week </label>
  </showvalue>

  <!-- ===================================================== -->
  <!-- FETAL GROWTH                                          -->
  <!-- ===================================================== -->

  <groupbox>
    <row> 2.0 </row>
    <col> 1.0 </col>
    <high> 16.0 </high>
    <wide> 38.0 </wide>
    <title> Fetal Growth </title>

    <structurename> FetalGrowth-Model </structurename>

    <showvalue>
      <row> 1.4 </row><col> 1.0 </col>
      <name> FetalWeight </name>
      <format><decimal> 1 </decimal></format>
      <label> Current Weight (g) </label>
    </showvalue>

    <showvalue>
      <row> 2.6 </row><col> 1.0 </col>
      <name> FetalWeight_Ideal </name>
      <format><decimal> 1 </decimal></format>
      <label> Expected Weight (g) </label>
    </showvalue>

    <showvalue>
      <row> 3.8 </row><col> 1.0 </col>
      <name> Pregnancy-Occurence.PregnancyWeek </name>
      <format><decimal> 1 </decimal></format>
      <label> Gestation Week </label>
    </showvalue>

    <showvalue>
      <row> 5.0 </row><col> 1.0 </col>
      <name> O2Ratio </name>
      <format><decimal> 3 </decimal></format>
      <label> Placental O2 Ratio </label>
    </showvalue>

    <showvalue>
      <row> 6.2 </row><col> 1.0 </col>
      <name> O2GrowthEffect </name>
      <format><decimal> 3 </decimal></format>
      <label> O2 Growth Effect </label>
    </showvalue>

    <showgraph>
      <row> 7.6 </row><col> 1.0 </col>
      <high> 6.4 </high><wide> 34.0 </wide>
      <leftmargin> 8 </leftmargin>

      <xaxis>
        <name> Pregnancy-Occurence.PregnancyWeek </name>
        <label> Gestation Week </label>
        <scale><min> 0 </min><max> 40 </max><inc> 5 </inc></scale>
      </xaxis>

      <yaxis>
        <yvar>
          <name> FetalWeight </name>
          <label> Current </label>
          <linecolor> BLUE </linecolor>
        </yvar>
        <yvar>
          <name> FetalWeight_Ideal </name>
          <label> Expected </label>
          <linecolor> BLACK </linecolor>
        </yvar>
        <scale><min> 0 </min><max> 2000 </max><inc> 1000 </inc></scale>
      </yaxis>
    </showgraph>

  </groupbox>

  <!-- ===================================================== -->
  <!-- PLACENTAL EXCHANGE                                    -->
  <!-- ===================================================== -->

  <groupbox>
    <row> 2.0 </row>
    <col> 41.0 </col>
    <high> 16.0 </high>
    <wide> 45.0 </wide>
    <title> Placental Exchange </title>

    <structurename> Placenta-Exchange </structurename>

    <showvalue>
      <row> 1.4 </row><col> 1.0 </col>
      <name> UterineFlow </name>
      <format><decimal> 1 </decimal></format>
      <label> Uterine Flow </label>
    </showvalue>

    <showvalue>
      <row> 2.6 </row><col> 1.0 </col>
      <name> UmbilicalFlow </name>
      <format><decimal> 1 </decimal></format>
      <label> Umbilical Flow </label>
    </showvalue>

    <showvalue>
      <row> 3.8 </row><col> 1.0 </col>
      <name> O2Diffused </name>
      <format><decimal> 3 </decimal></format>
      <label> Fetal O2 Delivery </label>
    </showvalue>

    <showvalue>
      <row> 5.0 </row><col> 1.0 </col>
      <name> MaternalO2Supply </name>
      <format><decimal> 1 </decimal></format>
      <label> Maternal O2 Supply </label>
    </showvalue>

    <showvalue>
      <row> 6.2 </row><col> 1.0 </col>
      <name> Pregnancy-Occurence.PregnancyWeek </name>
      <format><decimal> 1 </decimal></format>
      <label> Gestation Week </label>
    </showvalue>

    <showgraph>
      <row> 7.6 </row><col> 1.0 </col>
      <high> 7.0 </high><wide> 40.0 </wide>
      <leftmargin> 14 </leftmargin>

      <xaxis>
        <name> Pregnancy-Occurence.PregnancyWeek </name>
        <label> Gestation Week </label>
        <scale><min> 0 </min><max> 40 </max><inc> 15 </inc></scale>
      </xaxis>

      <yaxis>
        <yvar>
          <name> UterineFlow </name>
          <label> Uterine </label>
          <linecolor> BLUE </linecolor>
        </yvar>
        <yvar>
          <name> UmbilicalFlow </name>
          <label> Umbilical </label>
          <linecolor> RED </linecolor>
        </yvar>
        <yvar>
          <name> O2Diffused </name>
          <label> O2 Delivered </label>
          <linecolor> MAGENTA </linecolor>
        </yvar>
        <scale><min> 0 </min><max> 800 </max><inc> 500 </inc></scale>
      </yaxis>
    </showgraph>

  </groupbox>

</panel>














