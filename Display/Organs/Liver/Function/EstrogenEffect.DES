


<groupbox>
   <row> 2.0 </row>
   <col> 32.0 </col>
   <high> 8.8 </high>
   <wide> 30.0 </wide>
   <title> Estrogen Effect </title>

<showvalue>
   <row> 1.4 </row><col> 1.0 </col>
   <name> Liver-Function.EstrogenEffect </name>
   <format><decimal> 2 </decimal></format>
   <label> Effect </label>
</showvalue>

<showcurve>
  <row> 2.6 </row><col> 1.0 </col><high> 4 </high><wide> 28 </wide>
  <leftmargin> 5 </leftmargin>

  <xaxis>
    <name> Estradiol.[Conc(nMol/L)] </name>
    <label> Estrogen Conc </label>
    <scale>
      <min> 6.5 </min><max> 7.2 </max><inc> 0.1 </inc>
    </scale>
  </xaxis>

  <yaxis>
    <nolabel/>
    <scale>
      <min> 0 </min><max> 1 </max>
    </scale>
  </yaxis>

  <curvename> Liver-Function.EstrogenOnFunction </curvename>
</showcurve>

<showvalue>
   <row> 7.2 </row><col> 1.0 </col>
   <name> Estradiol.[Conc(nMol/L)] </name>
   <format><decimal> 2 </decimal></format>
   <label> Estrogen Concentration </label>
</showvalue>

<infobutton>
  <row> 1.2 </row>
  <col> 26.0 </col>

  <line> All effects are normally 1.0. </line>
  <line>  </line>
  <line> Cell pH is normally 7.05 pH units. </line>
</infobutton>

</groupbox>

