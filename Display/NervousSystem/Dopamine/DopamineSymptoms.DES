<!--
================================================================================
  DopamineSymptoms.DES  -  EMOTIONAL STATE PANEL
  Translates dopamine dynamics into intuitive emotional & behavioral states

  Shows how the person feels and what they want based on dopamine levels
  and withdrawal state. Maps model outputs to human-understandable emotions.
================================================================================
-->

<panel><name> DopamineSymptoms </name>
 
<showbitmap>
  <row> 0.3 </row>
  <col> 1.0 </col>
  <name> Autopsy </name>
</showbitmap>

<label>
  <row> 0.3 </row>
  <col> 4.5 </col>
  <text> VTA and N.Acc </text>
</label>

<showclock>
  <row> 0.3 </row><col> 32.0 </col>
  <name> System.X </name>
  <ampm/>
  <secs/>
  <days/>
</showclock>

 <!-- ==================== EMOTIONAL STATE DISPLAY ==================== -->
  <groupbox>
    <row> 2.0 </row><col> 1.0 </col>
    <high> 14.0 </high><wide> 36.0 </wide>
    <title> Emotional & Behavioral State </title>

    <showvalue>
      <row> 1.5 </row><col> 1.0 </col>
      <name> DopamineSystem.EmotionalHappiness </name>
      <label> I Feel Happy (Reward) </label>
      <format><decimal> 1 </decimal></format>
      <color> GREEN </color>
    </showvalue>

    <showvalue>
      <row> 3.0 </row><col> 1.0 </col>
      <name> DopamineSystem.EmotionalCraving </name>
      <label> I'm Craving a Drink </label>
      <format><decimal> 1 </decimal></format>
      <color> RED </color>
    </showvalue>

    <showvalue>
      <row> 4.5 </row><col> 1.0 </col>
      <name> DopamineSystem.EmotionalSleepiness </name>
      <label> I Feel Sleepy </label>
      <format><decimal> 1 </decimal></format>
      <color> BLUE </color>
    </showvalue>

    <showvalue>
      <row> 6.0 </row><col> 1.0 </col>
      <name> DopamineSystem.EmotionalAnxiety </name>
      <label> I Feel Anxious (Withdrawal) </label>
      <format><decimal> 1 </decimal></format>
      <color> MAGENTA </color>
    </showvalue>

    <showvalue>
      <row> 7.5 </row><col> 1.0 </col>
      <name> DopamineSystem.WillToDrink </name>
      <label> Motivation to Drink </label>
      <format><decimal> 1 </decimal></format>
      <color> DARKRED </color>
    </showvalue>

    <showvalue>
      <row> 9.0 </row><col> 1.0 </col>
      <name> DopamineSystem.TimeUntilNextDrink </name>
      <label> Minutes Until Anticipated Drink </label>
      <format><decimal> 0 </decimal></format>
      <color> BLACK </color>
    </showvalue>

  </groupbox>

  <!-- ===================== DOPAMINE-BEHAVIOR GRAPH ===================== -->
 

</panel>

End