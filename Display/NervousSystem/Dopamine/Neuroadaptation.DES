<!--
================================================================================
  Neuroadaptation.DES  -  PANEL 4
  Cumulative neuroadaptation across repeated ethanol exposures.

  Tracks BAC exposure episodes and the two adaptive gains that encode the
  long-term changes:
     A-gain  : euphoria gain, DECREASES with use  (tolerance)
     Opponent gain: withdrawal gain, INCREASES with repeated use
  A "Reset Adaptation" button clears the tolerance/opponent history so
  a fresh subject can be simulated without restarting the whole model.
================================================================================
-->

<panel>
  <name> Neuroadaptation </name>
  <tablabel> Neuroadaptation </tablabel>

  <showpanelname><row> 0.5 </row><col> 1.0 </col></showpanelname>

  <label>
    <row> 0.5 </row><col> 12.0 </col>
    <text> Neuroadaptation: Tolerance &amp; Opponent Strengthening </text>
    <color> BLACK </color>
  </label>

  <!-- ===================== EXPOSURE TRACKING ===================== -->
  <groupbox>
    <row> 2.0 </row><col> 1.0 </col>
    <high> 16.5 </high><wide> 38.0 </wide>
    <title> Exposure Tracking </title>

    <showvalue>
      <row> 1.5 </row><col> 1.0 </col>
      <name> DopamineSystem.TotalExposures </name>
      <label> Drink events </label>
      <format><decimal> 0 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 3.0 </row><col> 1.0 </col>
      <name> DopamineSystem.EpisodeCount </name>
      <label> Completed BAC episodes </label>
      <format><decimal> 0 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 4.5 </row><col> 1.0 </col>
      <name> DopamineSystem.EpisodeActive </name>
      <label> Episode active (1=yes) </label>
      <format><decimal> 0 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 6.0 </row><col> 1.0 </col>
      <name> DopamineSystem.EpisodeAUC </name>
      <label> Current BAC AUC </label>
      <format><decimal> 4 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 7.5 </row><col> 1.0 </col>
      <name> DopamineSystem.LastEpisodeAUC </name>
      <label> Last completed BAC AUC </label>
      <format><decimal> 4 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 9.0 </row><col> 1.0 </col>
      <name> DopamineSystem.LastEpisodeUnits </name>
      <label> Last adaptation units </label>
      <format><decimal> 3 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 10.5 </row><col> 1.0 </col>
      <name> DopamineSystem.AGain </name>
      <label> A-gain (euphoria) </label>
      <format><decimal> 3 </decimal></format>
      <color> RED </color>
    </showvalue>

    <showvalue>
      <row> 12.0 </row><col> 1.0 </col>
      <name> DopamineSystem.OpponentGain </name>
      <label> Opponent gain (withdrawal) </label>
      <format><decimal> 3 </decimal></format>
      <color> BLUE </color>
    </showvalue>

    <actionbutton>
      <row> 14.0 </row><col> 1.0 </col>
      <blockname> DopamineSystem.Reset </blockname>
      <label> Reset Adaptation </label>
      <layout> LABELRIGHT </layout>
    </actionbutton>

  </groupbox>

  <!-- ===================== GAINS OVER TIME ===================== -->
  <showgraph>
    <row> 2.0 </row><col> 40.0 </col>
    <high> 9.0 </high><wide> 58.0 </wide>
    <leftmargin> 7.0 </leftmargin>

    <xaxis>
      <name> System.X </name>
      <label> Time (min) </label>
      <scale><min> 0.0 </min><max> 10080.0 </max><inc> 1440.0 </inc></scale>
    </xaxis>

    <yaxis>
      <yvar>
        <name> DopamineSystem.AGain </name>
        <label> A-gain (down = tolerance) </label>
        <linetype> SOLID </linetype>
        <linecolor> RED </linecolor>
      </yvar>
      <yvar>
        <name> DopamineSystem.OpponentGain </name>
        <label> Opponent gain (up = stronger withdrawal) </label>
        <linetype> SOLID </linetype>
        <linecolor> BLUE </linecolor>
      </yvar>
      <scale><min> 0.0 </min><max> 4.0 </max><inc> 0.5 </inc></scale>
    </yaxis>
  </showgraph>

  <label>
    <row> 18.0 </row><col> 1.0 </col>
    <text> Gains update after BAC falls below threshold. BAC AUC scales adaptation; overlapping drinks form one episode. </text>
    <color> GRAY </color>
  </label>

</panel>

End
