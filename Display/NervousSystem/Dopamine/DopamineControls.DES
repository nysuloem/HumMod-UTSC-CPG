  <!-- ===================== 2. OPPONENT PROCESS VALUES ===================== -->
  <groupbox>
    <row> 29.0 </row><col> 1.0 </col>
    <high> 11.0 </high><wide> 34.0 </wide>
    <title> Opponent Processes (B = Withdrawal) </title>

    <showvalue>
      <row> 1.5 </row><col> 1.0 </col>
      <name> DopamineSystem.AProcess </name>
      <label> A-process (euphoria) </label>
      <format><decimal> 3 </decimal></format>
      <color> RED </color>
    </showvalue>

    <showvalue>
      <row> 3.0 </row><col> 1.0 </col>
      <name> DopamineSystem.BProcess </name>
      <label> B-process (opponent state) </label>
      <format><decimal> 3 </decimal></format>
      <color> BLUE </color>
    </showvalue>

    <showvalue>
      <row> 4.5 </row><col> 1.0 </col>
      <name> DopamineSystem.ExperiencedState </name>
      <label> Experienced State (A-B) </label>
      <format><decimal> 3 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 6.5 </row><col> 1.0 </col>
      <name> DopamineSystem.HedonicSetpoint </name>
      <label> Hedonic Set-Point </label>
      <format><decimal> 3 </decimal></format>
      <color> GRAY </color>
    </showvalue>

    <showvalue>
      <row> 8.0 </row><col> 1.0 </col>
      <name> DopamineSystem.AGain </name>
      <label> A-gain (tolerance) </label>
      <format><decimal> 3 </decimal></format>
      <color> RED </color>
    </showvalue>

    <showvalue>
      <row> 9.5 </row><col> 1.0 </col>
      <name> DopamineSystem.OpponentGain </name>
      <label> Opponent gain (withdrawal) </label>
      <format><decimal> 3 </decimal></format>
      <color> BLUE </color>
    </showvalue>

  </groupbox>

  <!-- ============= GRAPH A: within-episode opponent dynamics ============= -->
  <showgraph>
    <row> 29.0 </row><col> 39.0 </col>
    <high> 9.0 </high><wide> 65.0 </wide>
    <leftmargin> 15.0 </leftmargin>

    <xaxis>
      <name> DopamineSystem.TimeInDays </name>
      <label> Time (days) </label>
      <scale><min> 0.0 </min><max> 7.0 </max><inc> 1.0 </inc></scale>
    </xaxis>

    <yaxis>
      <yvar>
        <name> DopamineSystem.AProcess </name>
        <label> A (euphoria) </label>
        <linetype> SOLID </linetype>
        <linecolor> RED </linecolor>
      </yvar>
      <yvar>
        <name> DopamineSystem.BProcess </name>
        <label> B (opponent state) </label>
        <linetype> SOLID </linetype>
        <linecolor> BLUE </linecolor>
      </yvar>
      <yvar>
        <name> DopamineSystem.ExperiencedState </name>
        <label> Experienced (A-B) </label>
        <linetype> SOLID </linetype>
        <linecolor> BLACK </linecolor>
      </yvar>
      <scale><min> -1.0 </min><max> 1.0 </max><inc> 0.25 </inc></scale>
    </yaxis>
  </showgraph>

  <!-- ======== GRAPH B: long-run hedonic set-point shift ======== -->
  <showgraph>
    <row> 40.0 </row><col> 39.0 </col>
    <high> 8.0 </high><wide> 65.0 </wide>
    <leftmargin> 15.0 </leftmargin>

    <xaxis>
      <name> DopamineSystem.TimeInDays </name>
      <label> Time (days) </label>
      <scale><min> 0.0 </min><max> 7.0 </max><inc> 1.0 </inc></scale>
    </xaxis>

    <yaxis>
      <yvar>
        <name> DopamineSystem.ExperiencedState </name>
        <label> Experienced State </label>
        <linetype> SOLID </linetype>
        <linecolor> BLACK </linecolor>
      </yvar>
      <scale><min> -1.0 </min><max> 1.0 </max><inc> 0.25 </inc></scale>
    </yaxis>
  </showgraph>

   

  



</panel>

End
