<!--
================================================================================
  DopamineControls.DES  -  PANEL: CONTROLS & SETTINGS
  Trimmed for validation: only the two free DA parameters are exposed.

  REMOVED (archived, not deleted from model parms):
    - Set Up Chronic Drinking Pattern groupbox
        SCHEDULED_DRINKING, DRINK_TIME_MINUTES, DRINK_SIZE — no effect on
        any ODE or DA calculation; EthanolDailyDose drives the actual BAC.
    - TOL_STEP, OPPONENT_STEP sliders — tolerance/opponent strengthening per
        normalized BAC-AUC unit is static at the test defaults (0.01 tolerance,
        0.02 opponent) in DopamineSystem.DES.
    - EMOTIONAL_SENSITIVITY slider — pure display scalar; zero influence on
        any diffeq or graph being validated.
    - Response Timecourses groupbox (TAU_B_RISE, TAU_B_DECAY) — fixed at
        calibrated defaults (45 min rise, 720 min decay) to remove free
        parameters that would make validation results ambiguous.

  KEPT:
    - DA_GAIN — scales the BAC-derived acute dopamine response.
    - DA_SCALE_B — directly observable in tonic DA withdrawal trough.
    - EthanolDailyDose and EthanolSingleDose blocks — scheduled and immediate
      alcohol inputs driving the simulation.
================================================================================
-->

<panel><name> DopamineControls </name>

  <showbitmap>
    <row> 0.3 </row>
    <col> 1.0 </col>
    <name> Autopsy </name>
  </showbitmap>

  <label>
    <row> 0.3 </row>
    <col> 4.5 </col>
    <text> Dopamine Controls </text>
  </label>

  <showclock>
    <row> 0.3 </row><col> 32.0 </col>
    <name> System.X </name>
    <ampm/>
    <secs/>
    <days/>
  </showclock>

  <!-- ===================== KEY DOPAMINE PARAMETERS =====================
       Only two free parameters exposed for validation.
       All other parms (TOL_STEP, OPPONENT_STEP, TAU_B_RISE, TAU_B_DECAY,
       EMOTIONAL_SENSITIVITY, SCHEDULED_DRINKING) remain in DopamineSystem.DES
       at their calibrated defaults and are adjustable via the HumMod
       parameter editor if needed.
  ===================================================================== 

 <groupbox>
    <row> 30 </row><col> 130 </col>
    <high> 5.5 </high><wide> 50.0 </wide>
    <title> Dopamine System (Key Parameters) </title>

     DA_GAIN: scales the acute dopamine response driven directly by ActualReward.

    <repeatlist>
      <name> List_DAGain </name>
      <repeat><reps> 10 </reps><stepsize> 0.1 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DA_GAIN </name>
      <listname> List_DAGain </listname>
      <label> Acute DA Gain </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

     DA_SCALE_B: controls depth of tonic DA suppression during withdrawal.
         Higher = deeper dopamine trough between drinking sessions.
         Range: 0.05 – 0.50 (calibrated default 0.55; step 0.05). 

    <repeatlist>
      <name> List_Krate </name>
      <repeat><reps> 10 </reps><stepsize> 0.05 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DA_SCALE_B </name>
      <listname> List_Krate </listname>
      <label> Withdrawal / DA Loss </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

  </groupbox> -->

  <!-- ===================== DRINK TYPE =====================
       This uses the existing EthanolDrinkSelector structure. Selecting a
       drink updates the alcohol percentage for both the daily-dose and
       single-dose ethanol inputs:
         Beer = 5%, Wine = 14%, Vodka / Spirits = 40%.
  ================================================================= -->
  <groupbox>
    <row> 2.0 </row>
    <col> 108.0 </col>
    <high> 6.0 </high>
    <wide> 29.0 </wide>
    <title> Alcohol Type </title>

    <structurename> EthanolDrinkSelector </structurename>

    <maplist>
      <name> EthanolGILumen.DrinkTypeDopamine </name>
      <map><val> 1 </val><img> Beer </img></map>
      <map><val> 2 </val><img> Wine </img></map>
      <map><val> 3 </val><img> Vodka / Spirits </img></map>
    </maplist>

    <radiobuttons>
      <row> 1.4 </row><col> 1.0 </col>
      <name> EthanolGILumen.DrinkType </name>
      <listname> EthanolGILumen.DrinkTypeDopamine </listname>
      <label> Drink Type </label>
      <layout> VERT </layout>
    </radiobuttons>
  </groupbox>

  <!-- ===================== SINGLE DOSE / SHOT =====================
       Reuses EthanolSingleDose.TakeDoseNow; no ethanol or dopamine model
       equations are duplicated here.
  ================================================================== -->
  <groupbox>
    <row> 9.0 </row>
    <col> 108.0 </col>
    <high> 18.0 </high>
    <wide> 29.0 </wide>
    <title> Single Alcohol Dose / Shot </title>

    <structurename> EthanolSingleDose </structurename>

    <actionbutton>
      <row> 1.4 </row><col> 1.0 </col>
      <blockname> TakeDoseNow </blockname>
      <label> Drink Alcohol Now </label>
    </actionbutton>

    <repeatlist>
      <name> EthanolSingleDose.VolumeDopamine </name>
      <repeat><reps> 20 </reps><stepsize> 25 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 3.4 </row><col> 1.0 </col>
      <name> Volume </name>
      <listname> EthanolSingleDose.VolumeDopamine </listname>
      <label> Volume (mL) </label>
    </slidebar>

    <showvalue>
      <row> 5.4 </row><col> 1.0 </col>
      <name> %Alc </name>
      <label> % Alcohol </label>
    </showvalue>

    <showvalue>
      <row> 7.4 </row><col> 1.0 </col>
      <name> TimeLastDose </name>
      <format>
        <timestamp/>
        <fieldwidth> 14 </fieldwidth>
      </format>
      <label> Last Dose </label>
    </showvalue>

    <showvalue>
      <row> 9.0 </row><col> 1.0 </col>
      <name> TotalDrinks </name>
      <format> <integer/> </format>
      <label> Total Drinks Consumed </label>
    </showvalue>

    <showvalue>
      <row> 10.5 </row><col> 1.0 </col>
      <name> CumulativeDose </name>
      <format><decimal> 3 </decimal></format>
      <label> Alcohol Consumed (g) </label>
    </showvalue>

    <actionbutton>
      <row> 12.5 </row><col> 1.0 </col>
      <blockname> Reset </blockname>
      <label> Reset Single Dose </label>
    </actionbutton>

    <infobutton>
      <row> 14.5 </row><col> 1.0 </col>
      <line> Beer sets alcohol to 5 percent. </line>
      <line> Wine sets alcohol to 14 percent. </line>
      <line> Vodka / Spirits sets alcohol to 40 percent. </line>
      <line> Set the volume, then select Drink Alcohol Now. </line>
    </infobutton>
  </groupbox>

  <!-- ===================== SCHEDULED ETHANOL CONTROL ===================== -->
  <groupbox>
    <row> 2.0 </row>
    <col> 138.0 </col>
    <high> 27 </high>
    <wide> 36 </wide>
    <title> Chronic Alcohol Consumption </title>

    <structurename> EthanolDailyDose </structurename>

    <maplist>
      <name> Ethanol-Control.Request1 </name>
      <map><val> 0 </val><img> No </img></map>
      <map><val> 1 </val><img> Yes </img></map>
      <map><val> 2 </val><img> When I have it </img></map>
      <map><val> 3 </val><img> When I want to </img></map>
      <map><val> 4 </val><img> When I have it and want to </img></map>
    </maplist>

    <radiobuttons>
      <row> 1.4 </row><col> 1.0 </col>
      <name> TakeDaily </name>
      <listname> Ethanol-Control.Request1 </listname>
      <label> Drink?... </label>
      <layout> VERT </layout>
    </radiobuttons>

    <repeatlist>
      <name> EthanolDailyDose.Dose1 </name>
      <repeat><reps> 20 </reps><stepsize> 25 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 7.0 </row><col> 1.0 </col>
      <name> Dose </name>
      <listname> EthanolDailyDose.Dose1 </listname>
      <label> Volume (mL) </label>
    </slidebar>

    <showvalue>
      <row> 9.0 </row><col> 1.0 </col>
      <name> PercentageofAlcohol </name>
      <label> % Alcohol </label>
    </showvalue>

    <repeatlist>
      <name> EthanolDailyDose.TimesADay1 </name>
      <firstval> 1.0 </firstval>
      <repeat><reps> 24 </reps><stepsize> 1.0 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 11 </row><col> 1.0 </col>
      <name> TimesADay </name>
      <listname> EthanolDailyDose.TimesADay1 </listname>
      <label> Drinks per Day </label>
    </slidebar>

    <maplist>
      <name> EthanolDailyDose.DrinksAlloted1 </name>
      <map><val>     0 </val><img> None </img></map>
      <map><val> 6 </val><img> 6 </img></map>
      <map><val> 12 </val><img> 12 </img></map>
      <map><val> 24 </val><img> 24 </img></map>
      <map><val> 1000 </val><img> 1000 </img></map>
      <map><val> 1E308 </val><img> Unlimited </img></map>
    </maplist>

    <slidebar>
      <row> 13 </row><col> 1.0 </col>
      <name> NumberGiven </name>
      <listname> EthanolDailyDose.DrinksAlloted1 </listname>
      <label> Drinks Alloted </label>
    </slidebar>

    <repeatlist>
      <name> EthanolDailyDose.PercentChance1 </name>
      <firstval> 0.0 </firstval>
      <repeat><reps> 20 </reps><stepsize> 0.05 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 15 </row><col> 1.0 </col>
      <name> PercentChance </name>
      <listname> EthanolDailyDose.PercentChance1 </listname>
      <label> Likelihood of taking </label>
    </slidebar>

    <actionbutton>
      <row> 17 </row><col> 1.0 </col>
      <blockname> RenewScript </blockname>
      <label> Get more alcohol </label>
    </actionbutton>

    <showvalue>
      <row> 19 </row><col> 1.0 </col>
      <name> TimeLastDose </name>
      <format>
        <timestamp/>
        <fieldwidth> 14 </fieldwidth>
      </format>
      <label> Last Dose </label>
    </showvalue>

    <showvalue>
      <row> 20 </row><col> 1.0 </col>
      <name> TimeNextDose </name>
      <format>
        <timestamp/>
        <fieldwidth> 14 </fieldwidth>
      </format>
      <label> Next Dose </label>
    </showvalue>

    <showvalue>
      <row> 21 </row><col> 1.0 </col>
      <name> TotalDoses </name>
      <format> <integer/> </format>
      <label> Total Doses </label>
    </showvalue>

    <showvalue>
      <row> 22 </row><col> 1.0 </col>
      <name> CumulativeDose </name>
      <format><decimal> 3 </decimal></format>
      <label> Cumulative Dose </label>
    </showvalue>

    <showvalue>
      <row> 23 </row><col> 1.0 </col>
      <name> Timer </name>
      <format> <integer/> </format>
      <label> Time Until Next Drink </label>
    </showvalue>

    <showvalue>
      <row> 24 </row><col> 1.0 </col>
      <name> NumberLeft </name>
      <format> <integer/> </format>
      <label> Number Remaining </label>
    </showvalue>

  </groupbox>

<!-- ===================== 1. DA CURRENT VALUES ===================== -->
<groupbox>
  <row> 2.0 </row><col> 1.0 </col>
  <high> 13.0 </high><wide> 36.0 </wide>
  <title> DA Current Values </title>

  <showvalue>
    <row> 1.5 </row><col> 1.0 </col>
    <name> DopamineSystem.DopamineLevel </name>
    <label> Dopamine Level </label>
    <format><decimal> 3 </decimal></format>
    <color> BLUE </color>
  </showvalue>

  <showvalue>
    <row> 3.0 </row><col> 1.0 </col>
    <name> DopamineSystem.TonicDA </name>
    <label> Tonic DA (baseline) </label>
    <format><decimal> 3 </decimal></format>
    <color> BLACK </color>
  </showvalue>

  <showvalue>
    <row> 4.5 </row><col> 1.0 </col>
    <name> DopamineSystem.PhasicDA </name>
    <label> Acute DA (BAC-driven) </label>
    <format><decimal> 3 </decimal></format>
    <color> RED </color>
  </showvalue>

  <showvalue>
    <row> 6.0 </row><col> 1.0 </col>
  <name> DopamineSystem.BAC </name>
  <label> Blood Alcohol (g/dL) </label>
  <format><decimal> 3 </decimal></format>
  <color> BLACK </color>
  </showvalue>
</groupbox>

  <!-- ===================== 1. DA CURRENT VALUES GRAPH ===================== -->
<showgraph>
  <row> 2.0 </row><col> 40.0 </col>
  <high> 15.0 </high><wide> 65.0 </wide>
  <leftmargin> 11.0 </leftmargin>

  <xaxis>
    <name> DopamineSystem.TimeInDays </name>
    <label> Time (days) </label>
    <scale><min> 0.0 </min><max> 7.0 </max><inc> 1.0 </inc></scale>
  </xaxis>

  <yaxis>
    <yvar>
      <name> DopamineSystem.DopamineLevel </name>
      <label> Dopamine </label>
      <linetype> SOLID </linetype>
      <linecolor> BLUE </linecolor>
    </yvar>
    <yvar>
      <name> DopamineSystem.TonicDA </name>
      <label> Tonic </label>
      <linetype> DASH </linetype>
      <linecolor> BLACK </linecolor>
    </yvar>
    <yvar>
      <name> DopamineSystem.ExperiencedState </name>
      <label> Hedonic (A-B) </label>
      <linetype> SOLID </linetype>
      <linecolor> RED </linecolor>
    </yvar>
    <scale><min> -0.5 </min><max> 1.5 </max><inc> 0.5 </inc></scale>
  </yaxis>
</showgraph>

<!-- ===================== 2. ACUTE RESPONSE GRAPH (0-240 MIN) ===================== -->
<showgraph>
  <row> 18.0 </row><col> 39.0 </col>
  <high> 9.0 </high><wide> 65.0 </wide>
  <leftmargin> 15.0 </leftmargin>
		<xaxis>
			<name> System.X </name>
			<label> Time (min) </label>
			<scale><min> 0.0 </min><max> 240.0 </max><inc> 60.0 </inc></scale>
		</xaxis>
		<yaxis>
			<yvar><name> DopamineSystem.DopamineLevel </name><label> Dopamine </label><linetype> SOLID </linetype><linecolor> BLUE </linecolor></yvar>
			<yvar><name> DopamineSystem.TonicDA </name><label> Tonic </label><linetype> DASH </linetype><linecolor> BLACK </linecolor></yvar>
			<yvar><name> DopamineSystem.PhasicDA </name><label> Acute DA </label><linetype> SOLID </linetype><linecolor> RED </linecolor></yvar>
			<yvar><name> DopamineSystem.BACRewardEnvelope </name><label> BAC reward </label><linetype> SOLID </linetype><linecolor> MAGENTA </linecolor></yvar>
			<scale><min> -0.5 </min><max> 2.5 </max><inc> 0.5 </inc></scale>
		</yaxis>
</showgraph>

