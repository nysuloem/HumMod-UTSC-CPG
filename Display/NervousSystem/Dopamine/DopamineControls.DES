<!--
================================================================================
  DopamineControls.DES  -  PANEL: CONTROLS & SETTINGS
  User-adjustable model parameters and chronic drinking scenario setup.
================================================================================
-->

<panel>
  <name> DopamineControls </name>
  <tablabel> Controls & Settings </tablabel>

  <showpanelname><row> 0.5 </row><col> 1.0 </col></showpanelname>

  <label>
    <row> 0.5 </row><col> 12.0 </col>
    <text> Model Parameters & Chronic Drinking Setup </text>
    <color> BLACK </color>
  </label>

  <!-- ===================== CHRONIC DRINKING SCENARIO ===================== -->
  <groupbox>
    <row> 2.0 </row><col> 1.0 </col>
    <high> 6.0 </high><wide> 46.0 </wide>
    <title> Set Up Chronic Drinking Pattern </title>

    <showvalue>
      <row> 1.5 </row><col> 1.0 </col>
      <name> DopamineSystem.SCHEDULED_DRINKING </name>
      <label> Enable Scheduled Drinking </label>
      <format><decimal> 0 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <repeatlist>
      <name> List_DayMinutes </name>
      <repeat><reps> 24 </reps><stepsize> 60 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DRINK_TIME_MINUTES </name>
      <listname> List_DayMinutes </listname>
      <label> Time of Daily Drink (hh:mm) </label>
      <fieldwidth> 8 </fieldwidth>
    </slidebar>

    <repeatlist>
      <name> List_DrinkSize </name>
      <repeat><reps> 10 </reps><stepsize> 5 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 4.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DRINK_SIZE </name>
      <listname> List_DrinkSize </listname>
      <label> Standard Drink Size (g ethanol) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

  </groupbox>

  <!-- ===================== KEY DOPAMINE PARAMETERS ===================== -->
  <groupbox>
    <row> 8.5 </row><col> 1.0 </col>
    <high> 8.0 </high><wide> 46.0 </wide>
    <title> Dopamine System (Key Parameters) </title>

    <repeatlist>
      <name> List_LearnRate </name>
      <repeat><reps> 10 </reps><stepsize> 0.1 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.LEARN_RATE </name>
      <listname> List_LearnRate </listname>
      <label> Learning Rate (Fast/Slow) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <repeatlist>
      <name> List_Krate </name>
      <repeat><reps> 10 </reps><stepsize> 0.05 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DA_WITHDRAW_K </name>
      <listname> List_Krate </listname>
      <label> Withdrawal Dopamine Loss (Severe/Mild) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <repeatlist>
      <name> List_Step </name>
      <repeat><reps> 10 </reps><stepsize> 0.01 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 4.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TOL_STEP </name>
      <listname> List_Step </listname>
      <label> Tolerance Per Drink (Fast/Slow) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 6.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.SENS_STEP </name>
      <listname> List_Step </listname>
      <label> Sensitization Per Drink (Slow/Fast) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

  </groupbox>

  <!-- ===================== TIMECOURSES ===================== -->
  <groupbox>
    <row> 2.0 </row><col> 49.0 </col>
    <high> 6.0 </high><wide> 46.0 </wide>
    <title> Response Timecourses </title>

    <repeatlist>
      <name> List_TauSlow </name>
      <repeat><reps> 12 </reps><stepsize> 30 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TAU_B_RISE </name>
      <listname> List_TauSlow </listname>
      <label> Withdrawal Onset (min) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TAU_B_DECAY </name>
      <listname> List_TauSlow </listname>
      <label> Withdrawal Duration (min) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <repeatlist>
      <name> List_Sensitivity </name>
      <repeat><reps> 10 </reps><stepsize> 0.5 </stepsize></repeat>
    </repeatlist>

    <slidebar>
      <row> 4.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.EMOTIONAL_SENSITIVITY </name>
      <listname> List_Sensitivity </listname>
      <label> Emotional Intensity </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

  </groupbox>

  <!-- ===================== HELP PANEL ===================== -->
  <infobutton>
    <row> 8.5 </row><col> 49.0 </col>
    <label> Help: What do these controls do? </label>
    <layout> LABELRIGHT </layout>
    <line> CHRONIC DRINKING: Enable scheduled drinking to simulate daily habit. Set time (0=midnight, 1440=next midnight). </line>
    <line> LEARNING RATE: How fast the brain learns to predict the reward. Higher = addiction develops faster. </line>
    <line> WITHDRAWAL LOSS: How much dopamine drops during withdrawal. Higher = worse anxiety and craving. </line>
    <line> TOLERANCE & SENSITIZATION: Per-drink changes. Higher = faster dependence, less reward over time. </line>
    <line> TIMECOURSES: Control speed of withdrawal onset and recovery. Longer = persistent craving. </line>
    <line> EMOTIONAL INTENSITY: Scaling factor for happiness/craving/anxiety displays. </line>
  </infobutton>

  <label>
    <row> 17.5 </row><col> 1.0 </col>
    <text> Enable scheduled drinking at 6 PM (1080 min), run 7+ days, and watch craving build before the drink and anxiety afterward. </text>
    <color> GRAY </color>
  </label>

</panel>

End