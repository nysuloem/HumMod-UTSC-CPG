    <showvalue><row> 36.0 </row><col> 1.0 </col><name> DopamineSystem.LastEpisodeUnits </name><label> Last adaptation units </label><format><decimal> 4 </decimal></format></showvalue>
    <showvalue><row> 37.5 </row><col> 1.0 </col><name> DopamineSystem.EpisodeCount </name><label> Completed BAC episodes </label><format><decimal> 0 </decimal></format></showvalue>
