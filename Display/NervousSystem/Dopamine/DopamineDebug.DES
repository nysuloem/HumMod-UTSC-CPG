    <showvalue><row> 25.5 </row><col> 1.0 </col><name> DopamineSystem.DrugDrive </name><label> Drug drive </label><format><decimal> 8 </decimal></format></showvalue>
    <showvalue><row> 27.0 </row><col> 1.0 </col><name> DopamineSystem.EpisodeActive </name><label> BAC episode active </label><format><decimal> 0 </decimal></format></showvalue>
