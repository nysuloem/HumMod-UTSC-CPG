    <showvalue><row> 16.5 </row><col> 1.0 </col><name> EthanolGILumen.Change </name><label> GI derivative </label><format><decimal> 8 </decimal></format></showvalue>
    <showvalue><row> 18.0 </row><col> 1.0 </col><name> EthanolGILumen.PortalVein[Ethanol] </name><label> Portal ethanol </label><format><decimal> 8 </decimal></format></showvalue>
    <showvalue><row> 19.5 </row><col> 1.0 </col><name> GILumenH2O.Mass(L) </name><label> GI water mass (L) </label><format><decimal> 8 </decimal></format></showvalue>
    <showvalue><row> 21.0 </row><col> 1.0 </col><name> PortalVein.BloodFlow </name><label> Portal blood flow </label><format><decimal> 8 </decimal></format></showvalue>
  </groupbox>

