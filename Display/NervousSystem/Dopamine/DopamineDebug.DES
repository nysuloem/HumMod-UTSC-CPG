<panel><name> DopamineDebug </name>

  <showclock>
    <row> 0.3 </row><col> 2.0 </col>
    <name> System.X </name><ampm/><secs/><days/>
  </showclock>

  <label>
    <row> 0.3 </row><col> 34.0 </col>
    <text> Ethanol / Dopamine Diagnostic Checkpoints </text>
  </label>

  <groupbox>
    <row> 2.0 </row><col> 1.0 </col>
    <high> 32.0 </high><wide> 48.0 </wide>
    <title> 1. Dose and GI absorption </title>

    <showvalue><row> 1.5 </row><col> 1.0 </col><name> EthanolDailyDose.TakeDaily </name><label> TakeDaily </label><format><decimal> 3 </decimal></format></showvalue>
    <showvalue><row> 3.0 </row><col> 1.0 </col><name> EthanolDailyDose.Timer </name><label> Dose timer (min) </label><format><decimal> 6 </decimal></format></showvalue>
