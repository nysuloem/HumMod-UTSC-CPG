<!--
================================================================================
  DopamineControls.DES  -  PANEL 5
  User-adjustable model parameters.

  Slidebars (mapped through the lists declared in Dopamine.DES) let a
  student/researcher explore how each parameter reshapes the dopamine and
  hedonic dynamics. Parameters are grouped by functional area. All of these
  are <parm> variables in DopamineSystem.DES, so changes take effect live.
================================================================================
-->

<panel>
  <name> DopamineControls </name>
  <tablabel> Controls </tablabel>

  <showpanelname><row> 0.5 </row><col> 1.0 </col></showpanelname>

  <label>
    <row> 0.5 </row><col> 12.0 </col>
    <text> Parameter Controls </text>
    <color> BLACK </color>
  </label>

  <!-- ===================== REWARD LEARNING ===================== -->
  <groupbox>
    <row> 2.0 </row><col> 1.0 </col>
    <high> 4.0 </high><wide> 46.0 </wide>
    <title> Reward Learning </title>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.LEARN_RATE </name>
      <listname> List_LearnRate </listname>
      <label> Learning Rate (alpha) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>
  </groupbox>

  <!-- ===================== DOPAMINE ===================== -->
  <groupbox>
    <row> 6.5 </row><col> 1.0 </col>
    <high> 8.0 </high><wide> 46.0 </wide>
    <title> Dopamine </title>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TAU_DA </name>
      <listname> List_TauDA </listname>
      <label> DA Clearance Tau (min) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DA_BASELINE </name>
      <listname> List_Gain </listname>
      <label> Tonic DA Baseline </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 4.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DA_GAIN </name>
      <listname> List_Gain </listname>
      <label> Phasic DA Gain (per RPE) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 6.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.DA_WITHDRAW_K </name>
      <listname> List_Krate </listname>
      <label> Withdrawal DA Suppression </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>
  </groupbox>

  <!-- ===================== A-PROCESS (euphoria) ===================== -->
  <groupbox>
    <row> 2.0 </row><col> 49.0 </col>
    <high> 6.0 </high><wide> 46.0 </wide>
    <title> A-Process (euphoria) </title>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TAU_A_RISE </name>
      <listname> List_TauFast </listname>
      <label> A Rise Tau (min) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TAU_A_DECAY </name>
      <listname> List_TauFast </listname>
      <label> A Decay Tau (min) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>
  </groupbox>

  <!-- ===================== B-PROCESS (craving) ===================== -->
  <groupbox>
    <row> 8.5 </row><col> 49.0 </col>
    <high> 6.0 </high><wide> 46.0 </wide>
    <title> B-Process (withdrawal / craving) </title>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TAU_B_RISE </name>
      <listname> List_TauSlow </listname>
      <label> B Rise Tau (min) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TAU_B_DECAY </name>
      <listname> List_TauSlow </listname>
      <label> B Decay Tau (min) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>
  </groupbox>

  <!-- ===================== NEUROADAPTATION ===================== -->
  <groupbox>
    <row> 15.0 </row><col> 1.0 </col>
    <high> 6.0 </high><wide> 46.0 </wide>
    <title> Neuroadaptation (per drink) </title>

    <slidebar>
      <row> 1.5 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.TOL_STEP </name>
      <listname> List_Step </listname>
      <label> Tolerance Step (A down) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>

    <slidebar>
      <row> 3.0 </row><col> 1.0 </col>
      <high> 1.0 </high><wide> 22.0 </wide>
      <name> DopamineSystem.SENS_STEP </name>
      <listname> List_Step </listname>
      <label> Sensitization Step (B up) </label>
      <fieldwidth> 6 </fieldwidth>
    </slidebar>
  </groupbox>

  <!-- ===================== HELP ===================== -->
  <infobutton>
    <row> 15.0 </row><col> 49.0 </col>
    <label> About these controls </label>
    <layout> LABELRIGHT </layout>
    <line> Learning Rate: how fast the reward prediction is updated (RPE fades faster at high alpha). </line>
    <line> DA Clearance Tau: synaptic dopamine clearance time constant. </line>
    <line> Withdrawal DA Suppression: how strongly the B-process lowers tonic dopamine. </line>
    <line> A/B Rise and Decay Tau: speed of euphoria vs. craving onset and offset. </line>
    <line> Tolerance / Sensitization Step: per-drink change in euphoria and craving gains. </line>
  </infobutton>

  <label>
    <row> 21.5 </row><col> 1.0 </col>
    <text> Adjust a slider, then run the ethanol scenario and watch the Dopamine, Reward Learning and Hedonic State panels respond. </text>
    <color> GREY </color>
  </label>

</panel>

End