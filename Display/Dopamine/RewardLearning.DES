<!--
================================================================================
  RewardLearning.DES  -  PANEL 2
  Temporal-difference reward-prediction-error (RPE) learning.

  Shows the unconditioned reward (from BAC), the learned reward prediction,
  and the resulting prediction error, plus a graph of how the prediction
  "catches up" to the reward so that the RPE (and the dopamine response)
  fades with repeated, predictable consumption.

  CHANGE: Removed showvalue for DopamineSystem.LEARN_RATE.
  LEARN_RATE is an internal tuning parameter (parm), not a physiological
  output variable — displaying it in the panel added no scientific value
  and caused a parser error (Error 6010) when the parm was renamed or
  moved during refactoring.  The value remains accessible via the
  HumMod parameter editor if adjustment is needed.
================================================================================
-->

<panel>
  <name> RewardLearning </name>
  <tablabel> Reward Learning </tablabel>

  
<showbitmap>
  <row> 0.3 </row>
  <col> 1.0 </col>
  <name> Autopsy </name>
</showbitmap>

<label>
  <row> 0.3 </row>
  <col> 4.5 </col>
  <text> Reward Prediction Error</text>
</label>

<showclock>
  <row> 0.3 </row><col> 32.0 </col>
  <name> System.X </name>
  <ampm/>
  <secs/>
  <days/>
</showclock>

  <!-- ===================== CURRENT VALUES ===================== -->
  <groupbox>
    <row> 2.0 </row><col> 1.0 </col>
    <high> 9.0 </high><wide> 36.0 </wide>
    <title> Current Values </title>

    <showvalue>
      <row> 1.5 </row><col> 1.0 </col>
      <name> DopamineSystem.ActualReward </name>
      <label> Actual Reward </label>
      <format><decimal> 3 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <showvalue>
      <row> 3.0 </row><col> 1.0 </col>
      <name> DopamineSystem.RewardPrediction </name>
      <label> Reward Prediction </label>
      <format><decimal> 3 </decimal></format>
      <color> BLUE </color>
    </showvalue>

    <showvalue>
      <row> 4.5 </row><col> 1.0 </col>
      <name> DopamineSystem.PredictionError </name>
      <label> Prediction Error (RPE) </label>
      <format><decimal> 3 </decimal></format>
      <color> RED </color>
    </showvalue>

    <showvalue>
      <row> 6.5 </row><col> 1.0 </col>
      <name> DopamineSystem.BAC </name>
      <label> Blood Alcohol (g/dL) </label>
      <format><decimal> 3 </decimal></format>
      <color> BLACK </color>
    </showvalue>

    <!-- REMOVED: DopamineSystem.LEARN_RATE showvalue.
         LEARN_RATE is an internal parm, not a display variable.
         Adjust it via the HumMod parameter editor if needed. -->

  </groupbox>

  <!-- ===================== TIME-SERIES GRAPH ===================== -->
  <showgraph>
    <row> 2.0 </row><col> 40.0 </col>
    <high> 13.0 </high><wide> 58.0 </wide>
    <leftmargin> 9.0 </leftmargin>

    <xaxis>
      <name> System.X </name>
      <label> Time (min) </label>
      <scale><min> 0.0 </min><max> 720.0 </max><inc> 120.0 </inc></scale>
    </xaxis>

    <yaxis>
      <yvar>
        <name> DopamineSystem.ActualReward </name>
        <label> Reward </label>
        <linetype> SOLID </linetype>
        <linecolor> BLACK </linecolor>
      </yvar>
      <yvar>
        <name> DopamineSystem.RewardPrediction </name>
        <label> Prediction </label>
        <linetype> SOLID </linetype>
        <linecolor> BLUE </linecolor>
      </yvar>
      <yvar>
        <name> DopamineSystem.PredictionError </name>
        <label> RPE </label>
        <linetype> SOLID </linetype>
        <linecolor> RED </linecolor>
      </yvar>
      <scale><min> -1.0 </min><max> 1.2 </max><inc> 0.2 </inc></scale>
    </yaxis>
  </showgraph>

  <label>
    <row> 15.5 </row><col> 1.0 </col>
    <text> RPE = Reward - Prediction. As prediction learns the reward, RPE -&gt; 0 and the dopamine response to a predictable drink fades. </text>
    <color> GRAY </color>
  </label>

</panel>
