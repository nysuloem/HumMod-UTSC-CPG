<groupbox>
    <row> 2.0 </row>
    <col> 125.0 </col>
    <high> 10.4 </high>
    <wide> 30.0 </wide>
    <title> Air-Control </title>
 
 <structurename> AirSupply-InspiredAir </structurename>
 
 <showtable>
 <row> 1.4 </row><col> 1 </col>
 
 <column>
 <indent> 0 </indent>
 <fieldwidth> 10 </fieldwidth>
 <justify> LEFT </justify>
 
 <emptycell/>
 <textcell> O2 </textcell>
 <textcell> N2 </textcell>
 <textcell> CO2 </textcell>
 <textcell> H2O </textcell>
 <textcell> CO </textcell>
 <textcell> Anesthetic </textcell>
 <textcell> Total </textcell>
 
 </column>
 
 <column>
 <indent> 11.0 </indent>
 <fieldwidth> 5.0 </fieldwidth>
 <justify> RIGHT </justify>
 
 <textcell> % </textcell>
 <valuecell><name> O2(%) </name><format><decimal> 1 </decimal></format></valuecell>
 <valuecell><name> N2(%) </name><format><decimal> 1 </decimal></format></valuecell>
 <valuecell><name> CO2(%) </name><format><decimal> 2 </decimal></format></valuecell>
 <valuecell><name> H2O(%) </name><format><decimal> 2 </decimal></format></valuecell>
 <valuecell><name> CO(%) </name><format><decimal> 3 </decimal></format></valuecell>
 <valuecell><name> Anesthetic(%) </name><format><decimal> 2 </decimal></format></valuecell>
 <textcell> 100 </textcell>
 
 </column>
 
 <column>
 <indent> 21.0 </indent>
 <fieldwidth> 5.0 </fieldwidth>
 <justify> RIGHT </justify>
 
 <textcell> mmHg </textcell>
 <valuecell><name> PO2 </name><format><decimal> 1 </decimal></format></valuecell>
 <valuecell><name> PN2 </name><format><decimal> 1 </decimal></format></valuecell>
 <valuecell><name> PCO2 </name><format><decimal> 1 </decimal></format></valuecell>
 <valuecell><name> PH2O </name><format><decimal> 1 </decimal></format></valuecell>
 <valuecell><name> PCO </name><format><decimal> 2 </decimal></format></valuecell>
 <valuecell><name> PAnesthetic </name><format><decimal> 1 </decimal></format></valuecell>
 <valuecell><name> Pressure </name><format> <integer/> </format></valuecell>
 
 </column>
 
 </showtable>
 
 </groupbox>

 <groupbox>
    <row> 14.0 </row>
    <col> 125.0 </col>
    <high> 12.8 </high>
    <wide> 30.0 </wide>
    <title> Gas Tanks </title>
 
 <structurename> AirSupply-GasTanks </structurename>
 
 <radiobuttons>
   <row> 1.4 </row><col> 1.0 </col>
   <name> Switch </name>
   <listname> Common.Switch </listname>
   <label> Switch </label>
 </radiobuttons>
 <repeatlist>
    <name> O2Valve </name>
    <repeat><reps> 100 </reps><stepsize> 1 </stepsize></repeat>

  </repeatlist>
  

 <slidebar>
   <row> 2.8 </row><col> 1.0 </col>
   <name> O2Valve(%) </name>
   <listname> Common.Percent </listname>
   <label> O2 (%) </label>
 </slidebar>

 <slidebar>
   <row> 4.2 </row><col> 1.0 </col>
   <name> N2Valve(%) </name>
   <listname> Common.Percent </listname>
   <label> N2 (%) </label>
 </slidebar>

 <repeatlist>
   <name> CO2Valve </name>
   <repeat><reps> 50 </reps><stepsize> 0.1 </stepsize></repeat>
   <repeat><reps> 15 </reps><stepsize> 1.0 </stepsize></repeat>
 </repeatlist>
 
 <slidebar>
   <row> 5.6 </row><col> 1.0 </col>
   <name> CO2Valve(%) </name>
   <listname> CO2Valve </listname>
   <label> CO2 (%) </label>
 </slidebar>
 
 <repeatlist>
   <name> H2OValve </name>
   <repeat><reps> 26 </reps><stepsize> 0.1 </stepsize></repeat>
 </repeatlist>
 
 <slidebar>
   <row> 7.0 </row><col> 1.0 </col>
   <name> H2OValve(%) </name>
   <listname> H2OValve </listname>
   <label> H2O (%) </label>
 </slidebar>
 
 <repeatlist>
   <name> COValve </name>
   <repeat><reps> 10 </reps><stepsize> 10 </stepsize></repeat>
   <repeat><reps> 9 </reps><stepsize> 100 </stepsize></repeat>
   <repeat><reps> 9 </reps><stepsize> 1000 </stepsize></repeat>
 </repeatlist>
 
 <slidebar>
   <row> 8.4 </row><col> 1.0 </col>
   <name> COValve(PPM) </name>
   <listname> COValve </listname>
   <label> CO (PPM) </label>
 </slidebar>
 
 <showvalue>
    <row> 9.8 </row><col> 12 </col>
    <name> COValve(%) </name>
    <format><decimal> 3 </decimal></format>
    <label> CO (%) </label>
 </showvalue>
 

 <infobutton>
   <row> 1.2 </row>
   <col> 26.0 </col>
 
   <line> Inspired % may be a bit different </line>
   <line> than the gas tank settings. </line>
 </infobutton>
 
 </groupbox>
 
 End
 