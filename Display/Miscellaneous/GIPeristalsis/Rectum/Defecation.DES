



<showgraph>
  <row> 2 </row><col> 35 </col>
  <high> 6 </high><wide> 50 </wide>
  <leftmargin> 20 </leftmargin>
  <xaxis>
    <name> System.X </name>
    <label> Time (Min) </label>
    <scale><min> 0 </min><max> 480 </max></scale>
  </xaxis>
  <yaxis>
    <yvar>
      <name> Rectum.RectalVolume </name>
      <label> Rectal Volume (mL) </label>
      <linecolor> MAGENTA </linecolor>
    </yvar>
    <scale><min> 0 </min><max> 300 </max></scale>
  </yaxis>
</showgraph>

<!-- Defecation Reflex button -->

<groupbox>
  <row> 2 </row><col> 1.0 </col>
  <high> 9.0 </high><wide> 35.0 </wide> 
  <title> Defectation </title>

  <showvalue>
    <row> 1.5 </row><col> 1.0 </col>
    <name> Rectum.RectalVolume </name>
    <format><decimal> 0 </decimal></format>
    <label> Volume (mL) </label>
  </showvalue>

  <showvalue>
    <row> 3.0 </row><col> 1.0 </col>
    <name> Rectum.FecalVolume </name>
    <format><decimal> 0 </decimal></format>
    <label> Amount Defecated (mL) </label>
  </showvalue>

  <showvalue>
    <row> 4.5 </row><col> 1.0 </col>
    <name> Rectum.TimeLastPoop </name>
    <format>
     <timestamp/>
     <fieldwidth> 16 </fieldwidth>
   </format>
   <label> Time Last Poop </label>
  </showvalue>

   <showvalue>
    <row> 6.0 </row><col> 1.0 </col>
    <name> Rectum.Number </name>
    <format><decimal> 0 </decimal></format>
    <label> Number of Poops </label>
  </showvalue>

  <showvalue>
    <row> 7.5 </row><col> 1.0 </col>
    <name> Rectum.TotalFecalVolume </name>
    <format><decimal> 1 </decimal></format>
    <label> Total Fecal Volume </label>
  </showvalue>

</groupbox>