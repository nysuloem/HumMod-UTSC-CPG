HumMod / PreEclampsia

<panel><name> Control </name>

    <showclock>
      <row> 0.3 </row><col> 36.0 </col>
      <name> System.X </name>
      <ampm/>
      <secs/>
      <days/>
    </showclock>
    
    <groupbox>
       <row> 2.0 </row>
       <col> 1.0 </col>
       <high> 16.8 </high>
       <wide> 50.0 </wide>
       <title> Pre-Eclampsia (PE) Controls </title>
    
    <structurename> Uterus-PE </structurename>

    <radiobuttons>
      <row> 1.4 </row><col> 1.0 </col>
      <name> Switch </name>
      <listname> Common.Switch </listname>
      <label> Family history of PE? </label>
    </radiobuttons>

  <showvalue>
      <row> 2.4 </row><col> 1.0 </col>
      <name> Pregnancy-Occurence.PregnancyWeek </name>
      <label> Week of Pregnancy </label>
   </showvalue>

    <maplist><name> PE.Result </name>
      <map><val> 1 </val><img> Extremely high (very likely to be diagnosed) </img></map>
      <map><val> 2 </val><img> Moderate (continue to monitor risk) </img></map>
      <map><val> 3 </val><img> Low (very unlikely to be diagnosed) </img></map>
    </maplist>
    
    <showvalue>
       <row> 4.4 </row><col> 1.0 </col>
       <name> RiskOutcome </name>
       <format><list> PE.Result </list></format>
       <label> Level of Risk </label>
    </showvalue>

<label>
  <row> 6.4 </row><col> 1.0 </col>
  <text> Risk Factors </text>
</label>

<checkmark>
  <row> 7.4 </row><col> 2.0 </col>
  <name> FlagHistory </name>
  <label> Family History </label>
</checkmark>

<checkmark>
  <row> 8.4 </row><col> 2.0 </col>
  <name> Flag20Weeks </name>
  <label> 20+ weeks pregnant </label>
</checkmark>

<checkmark>
  <row> 9.4 </row><col> 2.0 </col>
  <name> FlagObese </name>
  <label> Obesity </label>
</checkmark>

<checkmark>
  <row> 10.4 </row><col> 2.0 </col>
  <name> FlagAge </name>
  <label> Advanced Maternal Age </label>
</checkmark>

<checkmark>
  <row> 11.4 </row><col> 2.0 </col>
  <name> FlagShort </name>
  <label> Short Stature </label>
</checkmark>

<checkmark>
  <row> 12.4 </row><col> 2.0 </col>
  <name> FlagDiabetes </name>
  <label> Diabetes </label>
</checkmark>

<checkmark>
  <row> 13.4 </row><col> 2.0 </col>
  <name> FlagHighBMI </name>
  <label> High BMI </label>
</checkmark>

